cal DataService = {}\n\nlocal store\nlocal sessions = {} -- [Player] = { Data, ReadOnly, Releasing }\n\nlocal function deepCopy(value)\n\tif type(value) ~= \"table\" then\n\t\treturn value\n\tend\n\tlocal copy = {}\n\tfor k, v in pairs(value) do\n\t\tcopy[k] = deepCopy(v)\n\tend\n\treturn copy\nend\n\nlocal function isValidNumber(v): boolean\n\treturn type(v) == \"number\" and v == v and v >= 0 and v < math.huge\nend\n\nlocal function sanitizeList(value): { string }?\n\tif type(value) ~= \"table\" then\n\t\treturn nil\n\tend\n\tlocal list, seen = {}, {}\n\tfor _, item in ipairs(value) do\n\t\tif type(item) == \"string\" and not seen[item] then\n\t\t\tseen[item] = true\n\t\t\ttable.insert(list, item)\n\t\tend\n\tend\n\treturn list\nend\n\n-- Garante que os dados tenham exatamente o formato esperado\nlocal function reconcile(raw)\n\tlocal source = type(raw) == \"table\" and raw or {}\n\tlocal result = {}\n\tfor key, default in pairs(GameConfig.DefaultData) do\n\t\tlocal value = source[key]\n\t\tif type(default) == \"number\" then\n\t\t\tresult[key] = isValidNumber(value) and math.floor(value) or default\n\t\telseif type(default) == \"table\" then\n\t\t\tresult[key] = sanitizeList(value) or deepCopy(default)\n\t\telse\n\t\t\tresult[key] = default\n\t\tend\n\tend\n\tresult.Level = math.max(1, result.Level)\n\tresult.XPRequired = math.max(1, result.XPRequired)\n\treturn result\nend\n\nlocal function sessionKey(player: Player): string\n\treturn \"Player_\" .. player.UserId\nend\n\nlocal function lockedByOther(record): boolean\n\tif type(record) ~= \"table\" or type(record.SessionLock) ~= \"table\" then\n\t\treturn false\n\tend\n\tlocal lock = record.SessionLock\n\treturn lock.JobId ~= game.JobId and (os.time() - (lock.Time or 0)) < cfg.LockTimeout\nend\n\nlocal function retry(fn, label: string, maxRetries: number)\n\tfor attempt = 1, maxRetries do\n\t\tlocal ok, result = pcall(fn)\n\t\tif ok then\n\t\t\treturn true, result\n\t\tend\n\t\twarn((\"[DataService] %s falhou (%d/%d): %s\"):format(label, attempt, maxRetries, tostring(result)))\n\t\tif attempt < maxRetries then\n\t\t\ttask.wait(cfg.RetryBaseDelay * 2 ^ (attempt - 1))\n\t\tend\n\tend\n\treturn false, nil\nend\n\nfunction DataService.Init()\n\tlocal ok, result = pcall(function()\n\t\treturn DataStoreService:GetDataStore(cfg.StoreName)\n\tend)\n\tif ok then\n\t\tstore = result\n\telse\n\t\twarn(\"[DataService] DataStore indispon\u00edvel:\", result)\n\tend\n\n\t-- Autosave peri\u00f3dico\n\ttask.spawn(function()\n\t\twhile true do\n\t\t\ttask.wait(cfg.AutosaveInterval)\n\t\t\tfor player, session in pairs(sessions) do\n\t\t\t\tif not session.ReadOnly and not session.Releasing then\n\t\t\t\t\ttask.spawn(DataService.Save, player, false, cfg.MaxRetries)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\n\n\t-- Salva todos ao fechar o servidor\n\tgame:BindToClose(function()\n\t\tlocal list = {}\n\t\tfor player in pairs(sessions) do\n\t\t\ttable.insert(list, player)\n\t\tend\n\t\tfor _, player in ipairs(list) do\n\t\t\ttask.spawn(DataService.Release, player, 2)\n\t\tend\n\t\tlocal startTime = os.clock()\n\t\twhile next(sessions) ~= nil and os.clock() - startTime < 25 do\n\t\t\ttask.wait(0.1)\n\t\tend\n\tend)\n\n\tPlayers.PlayerRemoving:Connect(function(player)\n\t\tDataService.Release(player)\n\tend)\nend\n\n-- Retorna \"Loaded\", \"Temporary\" (Studio sem acesso \u00e0 API) ou \"Failed\"\nfunction DataService.Load(player: Player): string\n\tif not store then\n\t\tif RunService:IsStudio() then\n\t\t\tsessions[player] = { Data = reconcile(nil), ReadOnly = true }\n\t\t\treturn \"Temporary\"\n\t\tend\n\t\treturn \"Failed\"\n\tend\n\n\tlocal maxRetries = RunService:IsStudio() and 1 or cfg.MaxRetries\n\n\tfor _ = 1, cfg.LockRetries do\n\t\tlocal locked = false\n\t\tlocal ok, result = retry(function()\n\t\t\treturn store:UpdateAsync(sessionKey(player), function(old)\n\t\t\t\tlocked = false\n\t\t\t\tif lockedByOther(old) then\n\t\t\t\t\tlocked = true\n\t\t\t\t\treturn nil -- cancela a atualiza\u00e7\u00e3o\n\t\t\t\tend\n\t\t\t\tlocal record = type(old) == \"table\" and old or {}\n\t\t\t\trecord.SchemaVersion = cfg.SchemaVersion\n\t\t\t\trecord.Data = reconcile(record.Data)\n\t\t\t\trecord.SessionLock = { JobId = game.JobId, Time = os.time() }\n\t\t\t\treturn record\n\t\t\tend)\n\t\tend, \"Load \" .. player.Name, maxRetries)\n\n\t\tif not ok then\n\t\t\tbreak\n\t\tend\n\t\tif locked then\n\t\t\ttask.wait(cfg.LockRetryDelay)\n\t\telseif type(result) == \"table\" then\n\t\t\tsessions[player] = { Data = reconcile(result.Data), ReadOnly = false }\n\t\t\treturn \"Loaded\"\n\t\telse\n\t\t\tbreak\n\t\tend\n\tend\n\n\tif RunService:IsStudio() then\n\t\tsessions[player] = { Data = reconcile(nil), ReadOnly = true } -- nunca sobrescreve dados reais\n\t\treturn \"Temporary\"\n\tend\n\treturn \"Failed\"\nend\n\nfunction DataService.Save(player: Player, release: boolean?, maxRetries: number?): boolean\n\tlocal session = sessions[player]\n\tif not session or session.ReadOnly or not store then\n\t\treturn false\n\tend\n\tlocal snapshot = deepCopy(session.Data)\n\tlocal lostLock = false\n\n\tlocal ok = retry(function()\n\t\treturn store:UpdateAsync(sessionKey(player), function(old)\n\t\t\tlostLock = false\n\t\t\tif lockedByOther(old) then\n\t\t\t\tlostLock = true\n\t\t\t\treturn nil\n\t\t\tend\n\t\t\tlocal record = type(old) == \"table\" and old or {}\n\t\t\trecord.SchemaVersion = cfg.SchemaVersion\n\t\t\trecord.Data = snapshot\n\t\t\tif release then\n\t\t\t\trecord.SessionLock = nil\n\t\t\telse\n\t\t\t\trecord.SessionLock = { JobId = game.JobId, Time = os.time() }\n\t\t\tend\n\t\t\treturn record\n\t\tend)\n\tend, \"Save \" .. player.Name, maxRetries or cfg.MaxRetries)\n\n\tif lostLock then\n\t\twarn(\"[DataService] Lock perdido, save descartado:\", player.Name)\n\t\treturn false\n\tend\n\treturn ok\nend\n\n-- Salva com libera\u00e7\u00e3o de lock e remove a sess\u00e3o (idempotente)\nfunction DataService.Release(player: Player, maxRetries: number?)\n\tlocal session = sessions[player]\n\tif not session or session.Releasing then\n\t\treturn\n\tend\n\tsession.Releasing = true\n\tDataService.Save(player, true, maxRetries)\n\tsessions[player] = nil\nend\n\nfunction DataService.IsLoaded(player: Player): boolean\n\treturn sessions[player] ~= nil\nend\n\n-- Refer\u00eancia viva (somente para uso interno de servi\u00e7os do servidor)\nfunction DataService.GetData(player: Player)\n\tlocal session = sessions[player]\n\treturn session and session.Data or nil\nend\n\nfunction DataService.GetCopy(player: Player)\n\tlocal session = sessions[player]\n\treturn session and deepCopy(session.Data) or nil\nend\n\n-- \u00danico ponto de escrita: valida tipo e notifica o cliente dono\nfunction DataService.Set(player: Player, key: string, value: any): boolean\n\tlocal session = sessions[player]\n\tlocal default = GameConfig.DefaultData[key]\n\tif not session or default == nil then\n\t\treturn false\n\tend\n\n\tlocal clean\n\tif type(default) == \"number\" then\n\t\tif not isValidNumber(value) then\n\t\t\treturn false\n\t\tend\n\t\tclean = math.floor(value)\n\telseif type(default) == \"table\" then\n\t\tclean = sanitizeList(value)\n\t\tif not clean then\n\t\t\treturn false\n\t\tend\n\telse\n\t\treturn false\n\tend\n\n\tsession.Data[key] = clean\n\tRemotes.Get(\"PlayerData\", \"DataChanged\"):FireClient(player, key, deepCopy(clean))\n\treturn true\nend\n\nreturn DataService\nEOF\n\ncat > XPService.lua <<'EOF'\n-- Autoridade sobre XP, Level, Kills e Credits + leaderstats\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\n\nlocal DataService = require(script.Parent.DataService)\nlocal TeamService = require(script.Parent.TeamService)\n\nlocal P = GameConfig.Progression\nlocal STAT_NAMES = { \"Kills\", \"Level\", \"XP\" }\n\nlocal XPService = {}\n\nlocal function cleanAmount(amount: any): number?\n\tif type(amount) ~= \"number\" or amount ~= amount or amount == math.huge then\n\t\treturn nil\n\tend\n\tlocal value = math.floor(amount)\n\tif value < 1 then\n\t\treturn nil\n\tend\n\treturn value\nend\n\n-- Espelha os dados nos leaderstats (replicados para todos)\nlocal function syncLeaderstats(player: Player)\n\tlocal stats = player:FindFirstChild(\"leaderstats\")\n\tlocal data = DataService.GetData(player)\n\tif not stats or not data then\n\t\treturn\n\tend\n\tfor _, name in ipairs(STAT_NAMES) do\n\t\tlocal value = stats:FindFirstChild(name)\n\t\tif value and value:IsA(\"IntValue\") then\n\t\t\tvalue.Value = data[name]\n\t\tend\n\tend\nend\n\n-- Chamar ap\u00f3s o carregamento dos dados\nfunction XPService.Setup(player: Player)\n\tlocal data = DataService.GetData(player)\n\tif not data then\n\t\treturn\n\tend\n\n\tlocal stats = player:FindFirstChild(\"leaderstats\")\n\tif not stats then\n\t\tstats = Instance.new(\"Folder\")\n\t\tstats.Name = \"leaderstats\"\n\t\tstats.Parent = player\n\tend\n\tfor _, name in ipairs(STAT_NAMES) do\n\t\tif not stats:FindFirstChild(name) then\n\t\t\tlocal value = Instance.new(\"IntValue\")\n\t\t\tvalue.Name = name\n\t\t\tvalue.Parent = stats\n\t\tend\n\tend\n\n\t-- XPRequired sempre derivado da curva atual (protege contra mudan\u00e7a de balanceamento)\n\tlocal required = P.GetXPRequired(data.Level)\n\tif data.XPRequired ~= required then\n\t\tDataService.Set(player, \"XPRequired\", required)\n\tend\n\tsyncLeaderstats(player)\nend\n\nfunction XPService.AddXP(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\n\tlocal oldLevel = data.Level\n\tlocal level, xp, required = data.Level, data.XP + clean, data.XPRequired\n\twhile level < P.MaxLevel and xp >= required do\n\t\txp -= required\n\t\tlevel += 1\n\t\trequired = P.GetXPRequired(level)\n\tend\n\tif level >= P.MaxLevel then\n\t\txp = 0\n\tend\n\n\tlocal levelsGained = level - oldLevel\n\tif levelsGained > 0 then\n\t\tDataService.Set(player, \"Level\", level)\n\t\tDataService.Set(player, \"XPRequired\", required)\n\t\tDataService.Set(player, \"Credits\", data.Credits + levelsGained * P.LevelUpCredits)\n\tend\n\tDataService.Set(player, \"XP\", xp)\n\tsyncLeaderstats(player)\n\n\tif levelsGained > 0 then\n\t\tRemotes.Get(\"PlayerData\", \"LevelUp\"):FireClient(player, level)\n\tend\n\treturn true\nend\n\nfunction XPService.AddCredits(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\treturn DataService.Set(player, \"Credits\", data.Credits + clean)\nend\n\n-- Gasta Credits de forma at\u00f4mica; retorna false se n\u00e3o houver saldo\nfunction XPService.SpendCredits(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data or data.Credits < clean then\n\t\treturn false\n\tend\n\treturn DataService.Set(player, \"Credits\", data.Credits - clean)\nend\n\nfunction XPService.AddKills(player: Player, amount: number?): boolean\n\tlocal clean = cleanAmount(amount or 1)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\tlocal ok = DataService.Set(player, \"Kills\", data.Kills + clean)\n\tsyncLeaderstats(player)\n\treturn ok\nend\n\n-- Recompensa por motivo definido em GameConfig.Progression.Rewards\nfunction XPService.Reward(player: Player, reason: string, multiplier: number?): boolean\n\tlocal reward = P.Rewards[reason]\n\tif not reward then\n\t\twarn(\"[XPService] Motivo de recompensa desconhecido:\", reason)\n\t\treturn false\n\tend\n\tlocal mult = math.clamp(type(multiplier) == \"number\" and multiplier or 1, 0, 100)\n\tlocal gaveAny = false\n\tif reward.XP > 0 then\n\t\tgaveAny = XPService.AddXP(player, reward.XP * mult) or gaveAny\n\tend\n\tif reward.Credits > 0 then\n\t\tgaveAny = XPService.AddCredits(player, reward.Credits * mult) or gaveAny\n\tend\n\treturn gaveAny\nend\n\nfunction XPService.Init()\n\t-- XP por sobreviver (somente Survivors vivos)\n\ttask.spawn(function()\n\t\twhile true do\n\t\t\ttask.wait(P.SurvivalInterval)\n\t\t\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\t\t\tlocal humanoid = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif\n\t\t\t\t\thumanoid\n\t\t\t\t\tand humanoid.Health > 0\n\t\t\t\t\tand DataService.IsLoaded(player)\n\t\t\t\t\tand TeamService.GetTeamId(player) == \"Survivor\"\n\t\t\t\tthen\n\t\t\t\t\tXPService.Reward(player, \"Survival\")\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend\n\nreturn XPService\nEOF\n\ncat > PlayerService.lua <<'EOF'\n-- Ciclo de vida do jogador: dados -> equipe -> leaderstats -> armas -> spawn\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\n\nlocal DataService = require(script.Parent.DataService)\nlocal TeamService = require(script.Parent.TeamService)\nlocal SpawnService = require(script.Parent.SpawnService)\nlocal XPService = require(script.Parent.XPService)\nlocal WeaponService = require(script.Parent.WeaponService)\n\nlocal PlayerService = {}\nlocal lastRequest: { [Player]: number } = {}\n\nlocal function onPlayerAdded(player: Player)\n\tlocal status = DataService.Load(player)\n\tif status == \"Failed\" then\n\t\tplayer:Kick(\"Could not load your data. Please rejoin.\")\n\t\treturn\n\tend\n\n\t-- Saiu durante o carregamento: libera o lock\n\tif not player.Parent then\n\t\tDataService.Release(player)\n\t\treturn\n\tend\n\n\tTeamService.SetTeam(player, GameConfig.DefaultTeam)\n\tXPService.Setup(player) -- cria leaderstats antes de enviar dados/spawnar\n\tWeaponService.SetupPlayer(player) -- invent\u00e1rio e armas (antes do spawn)\n\tplayer:SetAttribute(\"DataLoaded\", true)\n\tRemotes.Get(\"PlayerData\", \"DataLoaded\"):FireClient(player, DataService.GetCopy(player))\n\n\tSpawnService.Track(player)\n\tSpawnService.Spawn(player)\nend\n\nfunction PlayerService.Init()\n\t-- O cliente s\u00f3 pode pedir os PR\u00d3PRIOS dados, com limite de frequ\u00eancia\n\tlocal requestData = Remotes.Get(\"PlayerData\", \"RequestData\") :: RemoteFunction\n\trequestData.OnServerInvoke = function(player)\n\t\tlocal now = os.clock()\n\t\tif lastRequest[player] and now - lastRequest[player] < 1 then\n\t\t\treturn nil\n\t\tend\n\t\tlastRequest[player] = now\n\t\treturn DataService.GetCopy(player)\n\tend\n\n\tPlayers.PlayerRemoving:Connect(function(player)\n\t\tlastRequest[player] = nil\n\tend)\n\n\tPlayers.PlayerAdded:Connect(onPlayerAdded)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(onPlayerAdded, player)\n\tend\nend\n\nreturn PlayerService\nEOF\nwc -l *.lua", "description": "Escrever DataService, XPService e PlayerService"}, "message": "Escrever DataService, XPService e PlayerService", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/InfectionSurvival/src/ServerScriptService/Services\\ncat > DataService.lua <<'EOF'\\n-- DataStore com retry, lock de sess\\u00e3o, autosave, valida\\u00e7\\u00e3o e BindToClose\\nlocal DataStoreService = game:GetService(\\\"DataStoreService\\\")\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal RunService = game:GetService(\\\"RunService\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\n\\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\\n\\nlocal cfg = GameConfig.Data\\nlocal DataService = {}\\n\\nlocal store\\nlocal sessions = {} -- [Player] = { Data, ReadOnly, Releasing }\\n\\nlocal function deepCopy(value)\\n\\tif type(value) ~= \\\"table\\\" then\\n\\t\\treturn value\\n\\tend\\n\\tlocal copy = {}\\n\\tfor k, v in pairs(value) do\\n\\t\\tcopy[k] = deepCopy(v)\\n\\tend\\n\\treturn copy\\nend\\n\\nlocal function isValidNumber(v): boolean\\n\\treturn type(v) == \\\"number\\\" and v == v and v >= 0 and v < math.huge\\nend\\n\\nlocal function sanitizeList(value): { string }?\\n\\tif type(value) ~= \\\"table\\\" then\\n\\t\\treturn nil\\n\\tend\\n\\tlocal list, seen = {}, {}\\n\\tfor _, item in ipairs(value) do\\n\\t\\tif type(item) == \\\"string\\\" and not seen[item] then\\n\\t\\t\\tseen[item] = true\\n\\t\\t\\ttable.insert(list, item)\\n\\t\\tend\\n\\tend\\n\\treturn list\\nend\\n\\n-- Garante que os dados tenham exatamente o formato esperado\\nlocal function reconcile(raw)\\n\\tlocal source = type(raw) == \\\"table\\\" and raw or {}\\n\\tlocal result = {}\\n\\tfor key, default in pairs(GameConfig.DefaultData) do\\n\\t\\tlocal value = source[key]\\n\\t\\tif type(default) == \\\"number\\\" then\\n\\t\\t\\tresult[key] = isValidNumber(value) and math.floor(value) or default\\n\\t\\telseif type(default) == \\\"table\\\" then\\n\\t\\t\\tresult[key] = sanitizeList(value) or deepCopy(default)\\n\\t\\telse\\n\\t\\t\\tresult[key] = default\\n\\t\\tend\\n\\tend\\n\\tresult.Level = math.max(1, result.Level)\\n\\tresult.XPRequired = math.max(1, result.XPRequired)\\n\\treturn result\\nend\\n\\nlocal function sessionKey(player: Player): string\\n\\treturn \\\"Player_\\\" .. player.UserId\\nend\\n\\nlocal function lockedByOther(record): boolean\\n\\tif type(record) ~= \\\"table\\\" or type(record.SessionLock) ~= \\\"table\\\" then\\n\\t\\treturn false\\n\\tend\\n\\tlocal lock = record.SessionLock\\n\\treturn lock.JobId ~= game.JobId and (os.time() - (lock.Time or 0)) < cfg.LockTimeout\\nend\\n\\nlocal function retry(fn, label: string, maxRetries: number