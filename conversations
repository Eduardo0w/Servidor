 na leaderboard\nGameConfig.DefaultTeam = \"Survivor\"\n\nGameConfig.Spawn = {\n\tFolderName = \"Spawns\",\n\tRespawnTime = 5, -- segundos at\u00e9 renascer\n\tProtectionTime = 3, -- ForceField ap\u00f3s nascer\n}\n\n-- Pastas criadas automaticamente em Workspace\nGameConfig.WorkspaceFolders = {\n\t\"Map\", \"InfectionAreas\", \"PlacedBuildings\", \"PlacedTurrets\", \"Monsters\", \"Infection\", \"Projectiles\",\n}\n\nGameConfig.Data = {\n\tStoreName = \"InfectionSurvival_PlayerData_v1\",\n\tSchemaVersion = 1,\n\tAutosaveInterval = 120,\n\tMaxRetries = 5,\n\tRetryBaseDelay = 1,\n\tLockTimeout = 90, -- segundos para considerar um lock de sess\u00e3o expirado\n\tLockRetries = 3,\n\tLockRetryDelay = 6,\n}\n\n-- Dados permanentes (nada de estado tempor\u00e1rio de partida)\nGameConfig.DefaultData = {\n\tLevel = 1,\n\tXP = 0,\n\tXPRequired = 100,\n\tKills = 0,\n\tCredits = 100,\n\tInventory = {},\n\tUnlockedWeapons = { \"Pistol\" },\n\tUnlockedBuildings = { \"Wall\" }, -- nome provis\u00f3rio\n\tUnlockedEquipment = {},\n}\n\n-- Progress\u00e3o (Fase 2)\nGameConfig.Progression = {\n\tMaxLevel = 100,\n\tBaseXP = 100,\n\tXPGrowth = 1.15,\n\tLevelUpCredits = 50, -- b\u00f4nus de Credits por n\u00edvel\n\tSurvivalInterval = 60, -- segundos entre recompensas de sobreviv\u00eancia\n\n\t-- XP necess\u00e1rio para sair de `level` para `level + 1`\n\tGetXPRequired = function(level: number): number\n\t\tlocal P = GameConfig.Progression\n\t\treturn math.floor(P.BaseXP * P.XPGrowth ^ (math.max(1, level) - 1))\n\tend,\n\n\t-- Recompensas por motivo (usadas por XPService.Reward)\n\tRewards = {\n\t\tMonsterKill = { XP = 20, Credits = 10 },\n\t\tZombieKill = { XP = 10, Credits = 5 },\n\t\tAssist = { XP = 8, Credits = 4 },\n\t\tTentacleSegment = { XP = 5, Credits = 2 },\n\t\tTentacleKill = { XP = 40, Credits = 20 },\n\t\tCoreDestroyed = { XP = 300, Credits = 150 },\n\t\tMotherVirusDestroyed = { XP = 2000, Credits = 1000 },\n\t\tDefendRegion = { XP = 50, Credits = 25 },\n\t\tObjective = { XP = 100, Credits = 50 },\n\t\tSurvival = { XP = 5, Credits = 2 },\n\t\tBuild = { XP = 3, Credits = 0 },\n\t\tRepair = { XP = 4, Credits = 0 },\n\t\tEvent = { XP = 75, Credits = 35 },\n\t},\n}\n\n-- Combate (Fase 3)\nGameConfig.Combat = {\n\tMaxWeapons = 10, -- armas carregadas ao mesmo tempo\n\tStarterWeapon = \"Pistol\",\n\tHeadshotMultiplier = 2, -- padr\u00e3o (cada arma pode sobrescrever)\n\tAssistWindow = 10, -- segundos para contar assist\u00eancia\n\tEffectsRadius = 400, -- studs: quem recebe efeitos de tiro\n\tFireRateTolerance = 0.9, -- toler\u00e2ncia de lat\u00eancia na cad\u00eancia\n\tMaxProjectiles = 60,\n\tEnemyTag = \"Enemy\", -- tag (CollectionService) de alvos hostis\n\tMonstersFolder = \"Monsters\",\n\tProjectilesFolder = \"Projectiles\",\n}\n\nreturn GameConfig\nEOF\n\ncat > Shared/Remotes.lua <<'EOF'\n-- Cria (servidor) e localiza (servidor/cliente) todos os remotes\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Remotes = {}\n\nlocal ROOT_NAME = \"Remotes\"\nlocal DEFINITIONS = {\n\tPlayerData = { Events = { \"DataLoaded\", \"DataChanged\", \"LevelUp\" }, Functions = { \"RequestData\" } },\n\tCombat = { Events = { \"Fire\", \"Reload\", \"FireEffects\", \"HitMarker\", \"ReloadStarted\" }, Functions = {} },\n\tBuilding = { Events = {}, Functions = {} },\n\tShop = { Events = {}, Functions = {} },\n\tInfection = { Events = {}, Functions = {} },\n}\n\nlocal function ensure(parent: Instance, className: string, name: string): Instance\n\tlocal found = parent:FindFirstChild(name)\n\tif found and found.ClassName == className then\n\t\treturn found\n\tend\n\tif found then\n\t\tfound:Destroy()\n\tend\n\tlocal obj = Instance.new(className)\n\tobj.Name = name\n\tobj.Parent = parent\n\treturn obj\nend\n\n-- Somente servidor\nfunction Remotes.Init()\n\tassert(RunService:IsServer(), \"Remotes.Init s\u00f3 no servidor\")\n\tlocal root = ensure(ReplicatedStorage, \"Folder\", ROOT_NAME)\n\tfor category, def in pairs(DEFINITIONS) do\n\t\tlocal folder = ensure(root, \"Folder\", category)\n\t\tfor _, name in ipairs(def.Events) do\n\t\t\tensure(folder, \"RemoteEvent\", name)\n\t\tend\n\t\tfor _, name in ipairs(def.Functions) do\n\t\t\tensure(folder, \"RemoteFunction\", name)\n\t\tend\n\tend\nend\n\nfunction Remotes.Get(category: string, name: string): Instance\n\tlocal root = ReplicatedStorage:WaitForChild(ROOT_NAME, 15)\n\tlocal folder = root and root:WaitForChild(category, 15)\n\tlocal remote = folder and folder:WaitForChild(name, 15)\n\tassert(remote, (\"Remote inexistente: %s/%s\"):format(category, name))\n\treturn remote\nend\n\nreturn Remotes\nEOF\n\ncat > Shared/AvatarCache.lua <<'EOF'\n-- Cache ass\u00edncrono de thumbnails (GetUserThumbnailAsync) com retry\nlocal Players = game:GetService(\"Players\")\n\nlocal AvatarCache = {}\n\nlocal cache: { [number]: string } = {}\nlocal pending: { [number]: { (string) -> () } } = {}\n\nfunction AvatarCache.Get(userId: number, callback: (string) -> ())\n\tif cache[userId] then\n\t\tcallback(cache[userId])\n\t\treturn\n\tend\n\tif pending[userId] then\n\t\ttable.insert(pending[userId], callback)\n\t\treturn\n\tend\n\tpending[userId] = { callback }\n\n\ttask.spawn(function()\n\t\tlocal image\n\t\tfor _ = 1, 3 do\n\t\t\tlocal ok, content, ready = pcall(\n\t\t\t\tPlayers.GetUserThumbnailAsync,\n\t\t\t\tPlayers,\n\t\t\t\tuserId,\n\t\t\t\tEnum.ThumbnailType.HeadShot,\n\t\t\t\tEnum.ThumbnailSize.Size100x100\n\t\t\t)\n\t\t\tif ok and content then\n\t\t\t\timage = content\n\t\t\t\tif ready then\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\t\ttask.wait(1)\n\t\tend\n\n\t\tlocal callbacks = pending[userId]\n\t\tpending[userId] = nil\n\t\tif image then\n\t\t\tcache[userId] = image\n\t\t\tfor _, cb in ipairs(callbacks) do\n\t\t\t\tcb(image)\n\t\t\tend\n\t\tend\n\tend)\nend\n\nreturn AvatarCache\nEOF\nwc -l Config/GameConfig.lua Shared/*.lua", "description": "Escrever GameConfig, Remotes e AvatarCache"}, "message": "Es