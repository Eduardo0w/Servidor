erverScriptService/Game/MapVotingService.txt ===\\n-- ModuleScript: ServerScriptService/Game/MapVotingService\\n-- Gerencia a vota\u00e7\u00e3o e carregamento de mapas de ServerStorage.Maps\\n\\nlocal ServerStorage = game:GetService(\\\"ServerStorage\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\nlocal Remotes = ReplicatedStorage:WaitForChild(\\\"Remotes\\\")\\n\\nlocal MapVotingService = {}\\nlocal votes = {}\\nlocal votingActive = false\\nlocal availableMaps = {}\\n\\nlocal mapsFolder = ServerStorage:FindFirstChild(\\\"Maps\\\")\\n\\nfunction MapVotingService.Init()\\n\\tavailableMaps = {}\\n\\tif mapsFolder then\\n\\t\\tfor _, mapModel in ipairs(mapsFolder:GetChildren()) do\\n\\t\\t\\ttable.insert(availableMaps, mapModel.Name)\\n\\t\\tend\\n\\tend\\n\\n\\tif #availableMaps == 0 then\\n\\t\\tavailableMaps = {\\\"DefaultMap\\\"}\\n\\tend\\n\\n\\t-- Conex\u00e3o \u00fanica para registrar votos dos clientes\\n\\tlocal voteRemote = Remotes:WaitForChild(\\\"VoteMap\\\", 10)\\n\\tif voteRemote then\\n\\t\\tvoteRemote.OnServerEvent:Connect(function(player, mapName)\\n\\t\\t\\tif votingActive and table.find(availableMaps, mapName) then\\n\\t\\t\\t\\tvotes[player.UserId] = mapName\\n\\t\\t\\tend\\n\\t\\tend)\\n\\tend\\nend\\n\\nfunction MapVotingService.StartVoting()\\n\\tvotes = {}\\n\\tvotingActive = true\\n\\n\\tif Remotes:FindFirstChild(\\\"OpenMapVote\\\") then\\n\\t\\tRemotes.OpenMapVote:FireAllClients(availableMaps)\\n\\tend\\nend\\n\\nfunction MapVotingService.EndVoting()\\n\\tvotingActive = false\\n\\n\\tif Remotes:FindFirstChild(\\\"CloseMapVote\\\") then\\n\\t\\tRemotes.CloseMapVote:FireAllClients()\\n\\tend\\n\\n\\tlocal tally = {}\\n\\tfor _, mapName in pairs(votes) do\\n\\t\\ttally[mapName] = (tally[mapName] or 0) + 1\\n\\tend\\n\\n\\tlocal winningMap = availableMaps[1]\\n\\tlocal maxVotes = -1\\n\\n\\tfor mapName, count in pairs(tally) do\\n\\t\\tif count > maxVotes then\\n\\t\\t\\tmaxVotes = count\\n\\t\\t\\twinningMap = mapNa