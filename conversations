ge = game:GetService(\"ReplicatedStorage\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal player = Players.LocalPlayer\nlocal camera = workspace.CurrentCamera\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")\nlocal B = Config.Build\n\nlocal gui = script.Parent\nlocal frame = gui:WaitForChild(\"Frame\")\nlocal hint\nfor _, child in ipairs(gui:GetChildren()) do\n    if child:IsA(\"TextLabel\") then hint = child end\nend\n\n-- Textos da interface em ingl\u00eas\nlocal cancelButton = frame:FindFirstChild(\"Cancel [Q]\")\nlocal destroyButton = frame:FindFirstChild(\"Destroy [X]\")\nlocal rotateButton = frame:FindFirstChild(\"Rotate [R]\")\nif cancelButton then cancelButton.Text = \"Cancel [Q]\" end\nif destroyButton then destroyButton.Text = \"Destroy [X]\" end\nif rotateButton then rotateButton.Text = \"Rotate [R]\" end\nif hint then hint.Text = \"Click/Touch to build.\" end\n\nlocal rotation = 0\nlocal ghost = nil\nlocal lastTouch = nil\nlocal busy = false\n\nlocal function setVisible(on)\n    frame.Visible = on\n    if hint then hint.Visible = on end\nend\n\nlocal function destroyGhost()\n    if ghost then ghost:Destroy() ghost = nil end\nend\n\nlocal function currentCfg()\n    local id = player:GetAttribute(\"BuildItem\")\n    if not id or id == \"\" then return nil end\n    return Config.Buildables[id], id\nend\n\nlocal function cancelBuild()\n    player:SetAttribute(\"BuildItem\", nil)\nend\n\n-- Ponto do ch\u00e3o sob o cursor/toque (ignora personagem, estruturas, zumbis e o ghost)\nlocal function groundPoint(screenPos)\n    local ray\n    if screenPos then\n        ray = camera:ScreenPointToRay(screenPos.X, screenPos.Y)\n    elseif lastTouch then\n        ray = camera:ScreenPointToRay(lastTouch.X, lastTouch.Y)\n    else\n        local m = UIS:GetMouseLocation()\n        ray = camera:ViewportPointToRay(m.X, m.Y)\n    end\n\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n    params.FilterDescendantsInstances = {\n        player.Character, workspace:FindFirstChild(\"Structures\"), workspace:FindFirstChild(\"Zombies\"), ghost,\n    }\n    local res = workspace:Raycast(ray.Origin, ray.Direction * 500, params)\n    if not res then return nil end\n\n    local p = res.Position\n    return Vector3.new(math.round(p.X / B.Grid) * B.Grid, p.Y, math.round(p.Z / B.Grid) * B.Grid)\nend\n\nlocal function refreshGhost()\n    local cfg = currentCfg()\n    destroyGhost()\n    if not cfg then return end\n\n    ghost = Instance.new(\"Part\")\n    ghost.Name = \"BuildGhost\"\n    ghost.Anchored = true\n    ghost.CanCollide, ghost.CanQuery, ghost.CanTouch = false, false, false\n    ghost.Material = Enum.Material.ForceField\n    ghost.Size = cfg.Size\n    ghost.Parent = camera\nend\n\nplayer:GetAttributeChangedSignal(\"BuildItem\"):Connect(function()\n    rotation = 0\n    local cfg = currentCfg()\n    setVisible(cfg ~= nil)\n    refreshGhost()\nend)\n\n-- Preview acompanha o cursor; verde = dentro do alcance, vermelho = longe\nRunService.RenderStepped:Connect(function()\n    local cfg = currentCfg()\n    if not cfg or not ghost then return end\n    local p = groundPoint()\n    if not p then\n        ghost.Transparency = 1\n        return\n    end\n    ghost.Transparency = 0\n    ghost.CFrame = CFrame.new(p + Vector3.new(0, cfg.Size.Y / 2, 0)) * CFrame.Angles(0, math.rad(rotation), 0)\n\n    local root = player.Character and player.Character:FindFirstChild(\"HumanoidRootPart\")\n    local inRange = root and (root.Position - p).Magnitude <= B.MaxDistance\n    ghost.Color = inRange and Color3.fromRGB(80, 220, 100) or Color3.fromRGB(230, 70, 60)\nend)\n\nlocal function place(screenPos)\n    local cfg, id = currentCfg()\n    if not cfg or busy then return end\n    local p = groundPoint(screenPos)\n    if not p then return end\n\n    busy = true\n    local ok, result = pcall(function()\n        return Remotes.Build:InvokeServer(\"Place\", id, p, rotation)\n    end)\n    busy = false\n\n    if ok and result then cancelBuild() end -- construiu: sai do modo constru\u00e7\u00e3o\nend\n\nlocal function action(name)\n    if busy then return end\n    busy = true\n    pcall(function() Remotes.Build:InvokeServer(name) end)\n    busy = false\nend\n\nlocal function rotate()\n    rotation = (rotation + B.RotateStep) % 360\nend\n\nUIS.InputBegan:Connect(function(input, processed)\n    if processed then return end\n    local building = currentCfg() ~= nil\n\n    if input.KeyCode == Enum.KeyCode.F then\n        action(\"Repair\")\n    elseif input.KeyCode == Enum.KeyCode.X then\n        action(\"Demolish\")\n    elseif building then\n        if input.KeyCode == Enum.KeyCode.R then\n            rotate()\n        elseif input.KeyCode == Enum.KeyCode.Q then\n            cancelBuild()\n        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then\n            place(nil)\n        elseif input.UserInputType == Enum.UserInputType.Touch then\n            lastTouch = input.Position\n            place(input.Position)\n        end\n    end\nend)\n\n-- Bot\u00f5es da interface (mobile)\nif cancelButton then cancelButton.Activated:Connect(cancelBuild) end\nif rotateButton then rotateButton.Activated:Connect(rotate) end\nif destroyButton then destroyButton.Activated:Connect(function() action(\"Demolish\") end) end\n\nscript.Destroying:Connect(destroyGhost)\nsetVisible(false)\nEOF\ncat > ShopGUI/ShopUIController.client.lua <<'EOF'\n-- LocalScript: StarterGui/ShopGUI/ShopUIController\n-- Loja: upgrades (compra direta) e constru\u00e7\u00f5es (entra no modo constru\u00e7\u00e3o)\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal player = Players.LocalPlayer\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")\n\nlocal gui = script.Parent\nlocal frame = gui:WaitForChild(\"Frame\")\nlocal scroll = frame:WaitForChild(\"ScrollingFrame\")\nlocal openButton = gui:WaitForChild(\"ShopOpenButton\")\n\n-- Nome do bot\u00e3o no Studio -> id em Config.Buildables\nlocal buildButtons = {\n    SandBags = \"Sandbag\",\n    WoodWall = \"WoodWall\",\n    [\"Metal Wall\"] = \"MetalWall\",\n    Spikes = \"Spikes\",\n    Mine = \"Mine\",\n    BasicTURRET = \"Turret_Basic\",\n    HeavyTURRET = \"Turret_Heavy\",\n    [\"Healing Station\"] = \"HealStation\",\n}\n\n-- Nome do bot\u00e3o no Studio -> id em Config.Upgrades\nlocal upgradeButtons = {\n    Damage = \"Damage\",\n    FireRate = \"FireRate\",\n    Health = \"Health\",\n    Speed = \"Speed\",\n}\n\n-- Textos em ingl\u00eas\nopenButton.Text = \"Shop\"\nlocal buildsHeader = scroll:FindFirstChild(\"Builds\")\nlocal upgradesHeader = scroll:FindFirstChild(\"UPGRADES\")\nif buildsHeader and buildsHeader:IsA(\"TextLabel\") then buildsHeader.Text = \"BUILDS\" end\nif upgradesHeader and upgradesHeader:IsA(\"TextLabel\") then upgradesHeader.Text = \"UPGRADES\" end\n\nframe.Visible = false\n\nlocal function money()\n    local stats = player:FindFirstChild(\"leaderstats\")\n    local m = stats and stats:FindFirstChild(\"Money\")\n    return m and m.Value or 0\nend\n\nlocal function refresh()\n    for buttonName, id in pairs(buildButtons) do\n        local button = scroll:FindFirstChild(buttonName)\n        local cfg = Config.Buildables[id]\n        if button and button:IsA(\"TextButton\") and cfg then\n            local owned = player:GetAttribute(\"Own_\" .. id) or 0\n            button.Text = (\"%s  $%d  (%d/%d)\"):format(cfg.Name, cfg.Cost, owned, cfg.Max)\n        end\n    end\n\n    for buttonName, id in pairs(upgradeButtons) do\n        local button = scroll:FindFirstChild(buttonName)\n        local up = Config.Upgrades[id]\n        if button and button:IsA(\"TextButton\") and up then\n            local lvl = player:GetAttribute(\"Up_\" .. id) or 0\n            if lvl >= up.Max then\n                button.Text = (\"%s  MAX\"):format(up.Name)\n            else\n                button.Text = (\"%s  Lv %d/%d  $%d  (%s)\"):format(up.Name, lvl, up.Max, Config.UpgradeCost(id, lvl), up.Desc)\n            end\n        end\n    end\nend\n\nfor buttonName, id in pairs(buildButtons) do\n    local button = scroll:FindFirstChild(buttonName)\n    if button and button:IsA(\"TextButton\") then\n        button.Activated:Connect(function()\n            player:SetAttribute(\"BuildItem\", id)\n            frame.Visible = false\n        end)\n    end\nend\n\nfor buttonName, id in pairs(upgradeButtons) do\n    local button = scroll:FindFirstChild(buttonName)\n    if button and button:IsA(\"TextButton\") then\n        button.Activated:Connect(function()\n            pcall(function() Remotes.Upgrade:InvokeServer(id) end)\n            refresh()\n        end)\n    end\nend\n\nopenButton.Activated:Connect(function()\n    frame.Visible = not frame.Visible\n    if frame.Visible then\n        player:SetAttribute(\"BuildItem\", nil)\n        refresh()\n    end\nend)\n\n-- Atualiza os textos quando dinheiro/upgrades/constru\u00e7\u00f5es mudam\nplayer.AttributeChanged:Connect(refresh)\ntask.spawn(function()\n    local stats = player:WaitForChild(\"leaderstats\")\n    stats:WaitForChild(\"Money\"):GetPropertyChangedSignal(\"Value\"):Connect(refresh)\n    refresh()\nend)\nrefresh()\nEOF\ncat > Statusxplevelplayer/StatusController.client.lua <<'EOF'\n-- LocalScript: StarterGui/Statusxplevelplayer/StatusController\n-- HUD do jogador: dinheiro, kills, level, barra de XP e foto de perfil\n\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal player = Players.LocalPlayer\n\nlocal frame = script.Parent:WaitForChild(\"Frame\")\nlocal xpBack = frame:WaitForChild(\"xpBack\")\nlocal xpFill = xpBack:WaitForChild(\"xpFill\")\nlocal xpAmount = xpBack:WaitForChild(\"XpAmount\")\nlocal avatar = frame:WaitForChild(\"PlayerProfileImage\")\nlocal killsLabel = frame:WaitForChild(\"Kills\")\nlocal levelLabel = frame:WaitForChild(\"Level\")\nlocal moneyLabel = frame:WaitForChild(\"Money\")\n\nlocal stats = player:WaitForChild(\"leaderstats\")\nlocal money = stats:WaitForChild(\"Money\")\nlocal kills = stats:WaitForChild(\"Kills\")\nlocal level = stats:WaitForChild(\"Level\")\n\n-- 12345 -> \"12,345\"\nlocal function format(n)\n    local s = tostring(math.floor(n))\n    local formatted = s:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse()\n    return (formatted:gsub(\"^,\", \"\"))\nend\n\nlocal function updateXP()\n    local xp = player:GetAttribute(\"XP\") or 0\n    local needed = math.max(player:GetAttribute(\"XPNeeded\") or 1, 1)\n    xpAmount.Text = (\"XP: %s / %s\"):format(format(xp), format(needed))\n    TweenService:Create(xpFill, TweenInfo.new(0.25), {\n        Size = UDim2.new(math.clamp(xp / needed, 0, 1), 0, xpFill.Size.Y.Scale, xpFill.Size.Y.Offset),\n    }):Play()\nend\n\nlocal function update()\n    moneyLabel.Text = \"$\" .. format(money.Value)\n    killsLabel.Text = \"Kills: \" .. format(kills.Value)\n    levelLabel.Text = \"Level \" .. level.Value\n    updateXP()\nend\n\nmoney:GetPropertyChangedSignal(\"Value\"):Connect(update)\nkills:GetPropertyChangedSignal(\"Value\"):Connect(update)\nlevel:GetPropertyChangedSignal(\"Value\"):Connect(update)\nplayer:GetAttributeChangedSignal(\"XP\"):Connect(updateXP)\nplayer:GetAttributeChangedSignal(\"XPNeeded\"):Connect(updateXP)\nupdate()\n\ntask.spawn(function()\n    local ok, image = pcall(function()\n        return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)\n    end)\n    if ok then avatar.Image = image end\nend)\nEOF\ncat > VotingGUI/VotingUIController.client.lua <<'EOF'\n-- LocalScript: StarterGui/VotingGUI/VotingUIController\n-- Vota\u00e7\u00e3o de mapas (estado vem dos atributos de ReplicatedStorage)\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal HttpService = game:GetService(\"HttpService\")\n\nlocal Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")\n\nlocal frame = script.Parent:WaitForChild(\"Frame\")\nlocal votingFrame = frame:WaitForChild(\"votingframe\")\nlocal voteLabel = frame:WaitForChild(\"VoteTextLabel\")\n\nlocal buttons = {}\nfor i = 1, 4 do\n    local button = votingFrame:WaitForChild(\"Map\" .. i)\n    buttons[i] = { button = button, label = button:WaitForChild(\"Map\" .. i .. \"Name\"), map = nil }\nend\n\nlocal selected = nil\nframe.Visible = false\n\nlocal function render()\n    local open = ReplicatedStorage:GetAttribute(\"VotingOpen\") == true\n    frame.Visible = open\n    if not open then\n        selected = nil\n        return\n    end\n\n    local maps = {}\n    local list = ReplicatedStorage:GetAttribute(\"VoteMaps\") or \"\"\n    for name in string.gmatch(list, \"[^|]+\") do\n        table.insert(maps, name)\n    end\n\n    local ok, counts = pcall(function()\n        return HttpService:JSONDecode(ReplicatedStorage:GetAttribute(\"VoteCounts\") or \"{}\")\n    end)\n    if not ok then counts = {} end\n\n    for i, entry in ipairs(buttons) do\n        entry.map = maps[i]\n        entry.button.Visible = entry.map ~= nil\n        if entry.map then\n            local mark = (selected == entry.map) and \"\u2714 \" or \"\"\n            entry.label.Text = (\"%s%s  [%d]\"):format(mark, entry.map, counts[entry.map] or 0)\n        end\n    end\n\n    local timeLeft = ReplicatedStorage:GetAttribute(\"TimeLeft\") or 0\n    voteLabel.Text = (\"Vote for the next map!  (%ds)\"):format(timeLeft)\nend\n\nfor _, entry in ipairs(buttons) do\n    entry.button.Activated:Connect(function()\n        if entry.map then\n            selected = entry.map\n            Remotes.VoteMap:FireServer(entry.map)\n            render()\n        end\n    end)\nend\n\nfor _, attr in ipairs({ \"VotingOpen\", \"VoteMaps\", \"VoteCounts\", \"TimeLeft\" }) do\n    ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(render)\nend\nrender()\nEOF\ncat > ZombieHUD/WaveHUDController.client.lua <<'EOF'\n-- LocalScript: StarterGui/ZombieHUD/WaveHUDController\n-- HUD da wave: n\u00famero da wave, zumbis restantes e contagem regressiva\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal frame = script.Parent:WaitForChild(\"Wave\")\nlocal timeLabel = frame:WaitForChild(\"TimeLeftStatus\")\nlocal waveLabel = frame:WaitForChild(\"WaveTextStatus\")\nlocal zombiesLabel = frame:WaitForChild(\"ZombiesLeftStatus\")\n\nlocal function render()\n    local phase = ReplicatedStorage:GetAttribute(\"Phase\") or \"Waiting\"\n    local wave = ReplicatedStorage:GetAttribute(\"Wave\") or 0\n    local maxWave = ReplicatedStorage:GetAttribute(\"MaxWave\") or 0\n    local left = ReplicatedStorage:GetAttribute(\"ZombiesLeft\") or 0\n    local t = ReplicatedStorage:GetAttribute(\"TimeLeft\") or -1\n\n    if phase == \"Voting\" then\n        waveLabel.Text = \"Map vote\"\n        zombiesLabel.Text = \"Choose the next map!\"\n        timeLabel.Text = (\"Starting in %ds\"):format(t)\n    elseif phase == \"Intermission\" then\n        waveLabel.Text = (\"Wave %d / %d\"):format(wave, maxWave)\n        zombiesLabel.Text = \"Prepare your defenses!\"\n        timeLabel.Text = (\"Next wave in %ds\"):format(t)\n    elseif phase == \"Fight\" then\n        waveLabel.Text = (\"Wave %d / %d\"):format(wave, maxWave)\n        zombiesLabel.Text = (\"Zombies left: %d\"):format(left)\n        timeLabel.Text = \"Survive!\"\n    elseif phase == \"Victory\" then\n        waveLabel.Text = \"VICTORY!\"\n        zombiesLabel.Text = \"You survived all waves!\"\n        timeLabel.Text = (\"Restarting in %ds\"):format(t)\n    elseif phase == \"Defeat\" then\n        waveLabel.Text = \"GAME OVER\"\n        zombiesLabel.Text = (\"You reached wave %d\"):format(wave)\n        timeLabel.Text = (\"Restarting in %ds\"):format(t)\n    else\n        waveLabel.Text = \"Waiting...\"\n        zombiesLabel.Text = \"\"\n        timeLabel.Text = \"\"\n    end\nend\n\nfor _, attr in ipairs({ \"Phase\", \"Wave\", \"MaxWave\", \"ZombiesLeft\", \"TimeLeft\" }) do\n    ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(render)\nend\nrender()\nEOF\ncat > Bossbar/BossbarController.client.lua <<'EOF'\n-- LocalScript: StarterGui/Bossbar/BossbarController\n-- Barra de vida do boss (estado vem dos atributos de ReplicatedStorage)\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal TweenService = game:GetService(\"TweenService\")\n\nlocal frame = script.Parent:WaitForChild(\"BossbarFrame\")\nlocal fill = frame:WaitForChild(\"BossbarGreenhealth\")\nlocal status = frame:WaitForChild(\"BossHealthStatus\")\n\nlocal function render()\n    local name = ReplicatedStorage:GetAttribute(\"BossName\") or \"\"\n    local hp = ReplicatedStorage:GetAttribute(\"BossHealth\") or 0\n    local maxHp = math.max(ReplicatedStorage:GetAttribute(\"BossMaxHealth\") or 1, 1)\n\n    frame.Visible = name ~= \"\"\n    if name == \"\" then return end\n\n    status.Text = (\"%s  %d / %d\"):format(name, hp, maxHp)\n    TweenService:Create(fill, TweenInfo.new(0.2), {\n        Size = UDim2.new(math.clamp(hp / maxHp, 0, 1), 0, fill.Size.Y.Scale, fill.Size.Y.Offset),\n    }):Play()\nend\n\nfor _, attr in ipairs({ \"BossName\", \"BossHealth\", \"BossMaxHealth\" }) do\n    ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(render)\nend\nrender()\nEOF\necho ok", "description": "Write all StarterGui controllers"}, "message": "Write all StarterGui controllers", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/out/ZombieWave-Fixed/StarterGui && cat > BuildUI/BuildUIController.client.lua <<'EOF'\\n-- LocalScript: StarterGui/BuildUI/BuildUIController\\n-- Modo co