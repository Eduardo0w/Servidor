", "files_list": false}, "forgiven": false, "base_version": "ac47e095e0a9", "memory_op_kind": "write"}, "meta": null, "message": "Mem\u00f3ria atualizada", "integration_name": "Memory", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "edit", "display_content": {"type": "rich_content", "content": [{"title": "/projects/01a13278-b9a6-73d1-b303-96130fa900dd/areas/infection-survival.md", "subtitles": ["---\nname: infection-survival\ndescription: Projeto Roblox \"Infection Survival\" (L\u2026"], "url": null, "resource_type": null, "icon_url": null, "source": null}]}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-02T23:46:40.957266Z", "stop_timestamp": "2026-11-02T23:48:23.742762Z", "flags": null, "type": "text", "text": "# FASE 2 \u2014 JOGADORES E PROGRESS\u00c3O\n\n## Resumo das mudan\u00e7as\n\n| Arquivo | Status |\n|---|---|\n| `ReplicatedStorage/Modules/Config/GameConfig` | **modificado** (substitua inteiro) |\n| `ReplicatedStorage/Modules/Shared/Remotes` | **modificado** (substitua inteiro) |\n| `ReplicatedStorage/Modules/Shared/AvatarCache` | **novo** (ModuleScript) |\n| `ServerScriptService/Main` | **modificado** (substitua inteiro) |\n| `ServerScriptService/Services/PlayerService` | **modificado** (substitua inteiro) |\n| `ServerScriptService/Services/XPService` | **novo** (ModuleScript) |\n| `StarterPlayer/StarterPlayerScripts/HUDController` | **novo** (LocalScript) |\n| `StarterPlayer/StarterPlayerScripts/LeaderboardController` | **novo** (LocalScript) |\n\nSem altera\u00e7\u00e3o: `DataService`, `TeamService`, `SpawnService`, `DataController`, `ClientBootstrap`.\n\nOs ScreenGuis `HUD` e `Leaderboard` s\u00e3o criados por c\u00f3digo em `PlayerGui` (com `ResetOnSpawn = false`), ent\u00e3o n\u00e3o h\u00e1 nada para montar manualmente em `StarterGui`.\n\n---\n\n### `ReplicatedStorage/Modules/Config/GameConfig` (ModuleScript)\n\n```lua\n-- Configura\u00e7\u00e3o central do jogo (Fase 1 + Fase 2)\nlocal GameConfig = {}\n\nGameConfig.Debug = true\n\n-- Equipes; Infection n\u00e3o \u00e9 atribu\u00edda a jogadores nesta fase\nGameConfig.Teams = {\n\tSurvivor = { Name = \"Survivor\", TeamColor = BrickColor.new(\"Bright blue\"), PlaceholderSpawn = Vector3.new(0, 0.5, 0) },\n\tInfection = { Name = \"Infection\", TeamColor = BrickColor.new(\"Bright red\"), PlaceholderSpawn = Vector3.new(80, 0.5, 0) },\n}\nGameConfig.TeamOrder = { \"Survivor\", \"Infection\" } -- ordem na leaderboard\nGameConfig.DefaultTeam = \"Survivor\"\n\nGameConfig.Spawn = {\n\tFolderName = \"Spawns\",\n\tRespawnTime = 5, -- segundos at\u00e9 renascer\n\tProtectionTime = 3, -- ForceField ap\u00f3s nascer\n}\n\n-- Pastas criadas automaticamente em Workspace\nGameConfig.WorkspaceFolders = {\n\t\"Map\", \"InfectionAreas\", \"PlacedBuildings\", \"PlacedTurrets\", \"Monsters\", \"Infection\",\n}\n\nGameConfig.Data = {\n\tStoreName = \"InfectionSurvival_PlayerData_v1\",\n\tSchemaVersion = 1,\n\tAutosaveInterval = 120,\n\tMaxRetries = 5,\n\tRetryBaseDelay = 1,\n\tLockTimeout = 90, -- segundos para considerar um lock de sess\u00e3o expirado\n\tLockRetries = 3,\n\tLockRetryDelay = 6,\n}\n\n-- Dados permanentes (nada de estado tempor\u00e1rio de partida)\nGameConfig.DefaultData = {\n\tLevel = 1,\n\tXP = 0,\n\tXPRequired = 100,\n\tKills = 0,\n\tCredits = 100,\n\tInventory = {},\n\tUnlockedWeapons = { \"Pistol\" }, -- nomes provis\u00f3rios\n\tUnlockedBuildings = { \"Wall\" }, -- nomes provis\u00f3rios\n\tUnlockedEquipment = {},\n}\n\n-- Progress\u00e3o (Fase 2)\nGameConfig.Progression = {\n\tMaxLevel = 100,\n\tBaseXP = 100,\n\tXPGrowth = 1.15,\n\tLevelUpCredits = 50, -- b\u00f4nus de Credits por n\u00edvel\n\tSurvivalInterval = 60, -- segundos entre recompensas de sobreviv\u00eancia\n\n\t-- XP necess\u00e1rio para sair de `level` para `level + 1`\n\tGetXPRequired = function(level: number): number\n\t\tlocal P = GameConfig.Progression\n\t\treturn math.floor(P.BaseXP * P.XPGrowth ^ (math.max(1, level) - 1))\n\tend,\n\n\t-- Recompensas por motivo (usadas por XPService.Reward)\n\tRewards = {\n\t\tMonsterKill = { XP = 20, Credits = 10 },\n\t\tZombieKill = { XP = 10, Credits = 5 },\n\t\tAssist = { XP = 8, Credits = 4 },\n\t\tTentacleSegment = { XP = 5, Credits = 2 },\n\t\tTentacleKill = { XP = 40, Credits = 20 },\n\t\tCoreDestroyed = { XP = 300, Credits = 150 },\n\t\tMotherVirusDestroyed = { XP = 2000, Credits = 1000 },\n\t\tDefendRegion = { XP = 50, Credits = 25 },\n\t\tObjective = { XP = 100, Credits = 50 },\n\t\tSurvival = { XP = 5, Credits = 2 },\n\t\tBuild = { XP = 3, Credits = 0 },\n\t\tRepair = { XP = 4, Credits = 0 },\n\t\tEvent = { XP = 75, Credits = 35 },\n\t},\n}\n\nreturn GameConfig\n```\n\n### `ReplicatedStorage/Modules/Shared/Remotes` (ModuleScript)\n\n```lua\n-- Cria (servidor) e localiza (servidor/cliente) todos os remotes\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\n\nlocal Remotes = {}\n\nlocal ROOT_NAME = \"Remotes\"\nlocal DEFINITIONS = {\n\tPlayerData = { Events = { \"DataLoaded\", \"DataChanged\", \"LevelUp\" }, Functions = { \"RequestData\" } },\n\tCombat = { Events = {}, Functions = {} },\n\tBuilding = { Events = {}, Functions = {} },\n\tShop = { Events = {}, Functions = {} },\n\tInfection = { Events = {}, Functions = {} },\n}\n\nlocal function ensure(parent: Instance, className: string, name: string): Instance\n\tlocal found = parent:FindFirstChild(name)\n\tif found and found.ClassName == className then\n\t\treturn found\n\tend\n\tif found then\n\t\tfound:Destroy()\n\tend\n\tlocal obj = Instance.new(className)\n\tobj.Name = name\n\tobj.Parent = parent\n\treturn obj\nend\n\n-- Somente servidor\nfunction Remotes.Init()\n\tassert(RunService:IsServer(), \"Remotes.Init s\u00f3 no servidor\")\n\tlocal root = ensure(ReplicatedStorage, \"Folder\", ROOT_NAME)\n\tfor category, def in pairs(DEFINITIONS) do\n\t\tlocal folder = ensure(root, \"Folder\", category)\n\t\tfor _, name in ipairs(def.Events) do\n\t\t\tensure(folder, \"RemoteEvent\", name)\n\t\tend\n\t\tfor _, name in ipairs(def.Functions) do\n\t\t\tensure(folder, \"RemoteFunction\", name)\n\t\tend\n\tend\nend\n\nfunction Remotes.Get(category: string, name: string): Instance\n\tlocal root = ReplicatedStorage:WaitForChild(ROOT_NAME, 15)\n\tlocal folder = root and root:WaitForChild(category, 15)\n\tlocal remote = folder and folder:WaitForChild(name, 15)\n\tassert(remote, (\"Remote inexistente: %s/%s\"):format(category, name))\n\treturn remote\nend\n\nreturn Remotes\n```\n\n### `ReplicatedStorage/Modules/Shared/AvatarCache` (ModuleScript)\n\n```lua\n-- Cache ass\u00edncrono de thumbnails (GetUserThumbnailAsync) com retry\nlocal Players = game:GetService(\"Players\")\n\nlocal AvatarCache = {}\n\nlocal cache: { [number]: string } = {}\nlocal pending: { [number]: { (string) -> () } } = {}\n\nfunction AvatarCache.Get(userId: number, callback: (string) -> ())\n\tif cache[userId] then\n\t\tcallback(cache[userId])\n\t\treturn\n\tend\n\tif pending[userId] then\n\t\ttable.insert(pending[userId], callback)\n\t\treturn\n\tend\n\tpending[userId] = { callback }\n\n\ttask.spawn(function()\n\t\tlocal image\n\t\tfor _ = 1, 3 do\n\t\t\tlocal ok, content, ready = pcall(\n\t\t\t\tPlayers.GetUserThumbnailAsync,\n\t\t\t\tPlayers,\n\t\t\t\tuserId,\n\t\t\t\tEnum.ThumbnailType.HeadShot,\n\t\t\t\tEnum.ThumbnailSize.Size100x100\n\t\t\t)\n\t\t\tif ok and content then\n\t\t\t\timage = content\n\t\t\t\tif ready then\n\t\t\t\t\tbreak\n\t\t\t\tend\n\t\t\tend\n\t\t\ttask.wait(1)\n\t\tend\n\n\t\tlocal callbacks = pending[userId]\n\t\tpending[userId] = nil\n\t\tif image then\n\t\t\tcache[userId] = image\n\t\t\tfor _, cb in ipairs(callbacks) do\n\t\t\t\tcb(image)\n\t\t\tend\n\t\tend\n\tend)\nend\n\nreturn AvatarCache\n```\n\n---\n\n### `ServerScriptService/Main` (Script)\n\n```lua\n-- Bootstrap do servidor: ordem de inicializa\u00e7\u00e3o dos servi\u00e7os\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal GameConfig = require(Modules.Config.GameConfig)\nlocal Remotes = require(Modules.Shared.Remotes)\n\nlocal Services = script.Parent:WaitForChild(\"Services\")\nlocal TeamService = require(Services.TeamService)\nlocal SpawnService = require(Services.SpawnService)\nlocal DataService = require(Services.DataService)\nlocal XPService = require(Services.XPService)\nlocal PlayerService = require(Services.PlayerService)\n\nRemotes.Init()\n\nfor _, name in ipairs(GameConfig.WorkspaceFolders) do\n\tif not Workspace:FindFirstChild(name) then\n\t\tlocal folder = Instance.new(\"Folder\")\n\t\tfolder.Name = name\n\t\tfolder.Parent = Workspace\n\tend\nend\n\nTeamService.Init()\nSpawnService.Init()\nDataService.Init()\nXPService.Init()\nPlayerService.Init() -- por \u00faltimo: come\u00e7a a processar jogadores\n```\n\n### `ServerScriptService/Services/PlayerService` (ModuleScript)\n\n```lua\n-- Ciclo de vida do jogador: dados -> equipe -> leaderstats -> spawn\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerScriptService = game:GetService(\"ServerScriptService\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\n\nlocal Services = ServerScriptService:WaitForChild(\"Services\")\nlocal DataService = require(Services.DataService)\nlocal TeamService = require(Services.TeamService)\nlocal SpawnService = require(Services.SpawnService)\nlocal XPService = require(Services.XPService)\n\nlocal PlayerService = {}\nlocal lastRequest: { [Player]: number } = {}\n\nlocal function onPlayerAdded(player: Player)\n\tlocal status = DataService.Load(player)\n\tif status == \"Failed\" then\n\t\tplayer:Kick(\"N\u00e3o foi poss\u00edvel carregar seus dados. Tente entrar novamente.\")\n\t\treturn\n\tend\n\n\t-- Saiu durante o carregamento: libera o lock\n\tif not player.Parent then\n\t\tDataService.Release(player)\n\t\treturn\n\tend\n\n\tTeamService.SetTeam(player, GameConfig.DefaultTeam)\n\tXPService.Setup(player) -- cria leaderstats antes de enviar dados/spawnar\n\tplayer:SetAttribute(\"DataLoaded\", true)\n\tRemotes.Get(\"PlayerData\", \"DataLoaded\"):FireClient(player, DataService.GetCopy(player))\n\n\tSpawnService.Track(player)\n\tSpawnService.Spawn(player)\nend\n\nfunction PlayerService.Init()\n\t-- O cliente s\u00f3 pode pedir os PR\u00d3PRIOS dados, com limite de frequ\u00eancia\n\tlocal requestData = Remotes.Get(\"PlayerData\", \"RequestData\") :: RemoteFunction\n\trequestData.OnServerInvoke = function(player)\n\t\tlocal now = os.clock()\n\t\tif lastRequest[player] and now - lastRequest[player] < 1 then\n\t\t\treturn nil\n\t\tend\n\t\tlastRequest[player] = now\n\t\treturn DataService.GetCopy(player)\n\tend\n\n\tPlayers.PlayerRemoving:Connect(function(player)\n\t\tlastRequest[player] = nil\n\tend)\n\n\tPlayers.PlayerAdded:Connect(onPlayerAdded)\n\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\ttask.spawn(onPlayerAdded, player)\n\tend\nend\n\nreturn PlayerService\n```\n\n### `ServerScriptService/Services/XPService` (ModuleScript)\n\n```lua\n-- Autoridade sobre XP, Level, Kills e Credits + leaderstats\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal ServerScriptService = game:GetService(\"ServerScriptService\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\n\nlocal Services = ServerScriptService:WaitForChild(\"Services\")\nlocal DataService = require(Services.DataService)\nlocal TeamService = require(Services.TeamService)\n\nlocal P = GameConfig.Progression\nlocal STAT_NAMES = { \"Kills\", \"Level\", \"XP\" }\n\nlocal XPService = {}\n\nlocal function cleanAmount(amount: any): number?\n\tif type(amount) ~= \"number\" or amount ~= amount or amount == math.huge then\n\t\treturn nil\n\tend\n\tlocal value = math.floor(amount)\n\tif value < 1 then\n\t\treturn nil\n\tend\n\treturn value\nend\n\n-- Espelha os dados nos leaderstats (replicados para todos)\nlocal function syncLeaderstats(player: Player)\n\tlocal stats = player:FindFirstChild(\"leaderstats\")\n\tlocal data = DataService.GetData(player)\n\tif not stats or not data then\n\t\treturn\n\tend\n\tfor _, name in ipairs(STAT_NAMES) do\n\t\tlocal value = stats:FindFirstChild(name)\n\t\tif value and value:IsA(\"IntValue\") then\n\t\t\tvalue.Value = data[name]\n\t\tend\n\tend\nend\n\n-- Chamar ap\u00f3s o carregamento dos dados\nfunction XPService.Setup(player: Player)\n\tlocal data = DataService.GetData(player)\n\tif not data then\n\t\treturn\n\tend\n\n\tlocal stats = player:FindFirstChild(\"leaderstats\")\n\tif not stats then\n\t\tstats = Instance.new(\"Folder\")\n\t\tstats.Name = \"leaderstats\"\n\t\tstats.Parent = player\n\tend\n\tfor _, name in ipairs(STAT_NAMES) do\n\t\tif not stats:FindFirstChild(name) then\n\t\t\tlocal value = Instance.new(\"IntValue\")\n\t\t\tvalue.Name = name\n\t\t\tvalue.Parent = stats\n\t\tend\n\tend\n\n\t-- XPRequired sempre derivado da curva atual (protege contra mudan\u00e7a de balanceamento)\n\tlocal required = P.GetXPRequired(data.Level)\n\tif data.XPRequired ~= required then\n\t\tDataService.Set(player, \"XPRequired\", required)\n\tend\n\tsyncLeaderstats(player)\nend\n\nfunction XPService.AddXP(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\n\tlocal oldLevel = data.Level\n\tlocal level, xp, required = data.Level, data.XP + clean, data.XPRequired\n\twhile level < P.MaxLevel and xp >= required do\n\t\txp -= required\n\t\tlevel += 1\n\t\trequired = P.GetXPRequired(level)\n\tend\n\tif level >= P.MaxLevel then\n\t\txp = 0\n\tend\n\n\tlocal levelsGained = level - oldLevel\n\tif levelsGained > 0 then\n\t\tDataService.Set(player, \"Level\", level)\n\t\tDataService.Set(player, \"XPRequired\", required)\n\t\tDataService.Set(player, \"Credits\", data.Credits + levelsGained * P.LevelUpCredits)\n\tend\n\tDataService.Set(player, \"XP\", xp)\n\tsyncLeaderstats(player)\n\n\tif levelsGained > 0 then\n\t\tRemotes.Get(\"PlayerData\", \"LevelUp\"):FireClient(player, level)\n\tend\n\treturn true\nend\n\nfunction XPService.AddCredits(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\treturn DataService.Set(player, \"Credits\", data.Credits + clean)\nend\n\n-- Gasta Credits de forma at\u00f4mica; retorna false se n\u00e3o houver saldo\nfunction XPService.SpendCredits(player: Player, amount: number): boolean\n\tlocal clean = cleanAmount(amount)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data or data.Credits < clean then\n\t\treturn false\n\tend\n\treturn DataService.Set(player, \"Credits\", data.Credits - clean)\nend\n\nfunction XPService.AddKills(player: Player, amount: number?): boolean\n\tlocal clean = cleanAmount(amount or 1)\n\tlocal data = DataService.GetData(player)\n\tif not clean or not data then\n\t\treturn false\n\tend\n\tlocal ok = DataService.Set(player, \"Kills\", data.Kills + clean)\n\tsyncLeaderstats(player)\n\treturn ok\nend\n\n-- Recompensa por motivo definido em GameConfig.Progression.Rewards\nfunction XPService.Reward(player: Player, reason: string, multiplier: number?): boolean\n\tlocal reward = P.Rewards[reason]\n\tif not reward then\n\t\twarn(\"[XPService] Motivo de recompensa desconhecido:\", reason)\n\t\treturn false\n\tend\n\tlocal mult = math.clamp(type(multiplier) == \"number\" and multiplier or 1, 0, 100)\n\tlocal gaveAny = false\n\tif reward.XP > 0 then\n\t\tgaveAny = XPService.AddXP(player, reward.XP * mult) or gaveAny\n\tend\n\tif reward.Credits > 0 then\n\t\tgaveAny = XPService.AddCredits(player, reward.Credits * mult) or gaveAny\n\tend\n\treturn gaveAny\nend\n\nfunction XPService.Init()\n\t-- XP por sobreviver (somente Survivors vivos)\n\ttask.spawn(function()\n\t\twhile true do\n\t\t\ttask.wait(P.SurvivalInterval)\n\t\t\tfor _, player in ipairs(Players:GetPlayers()) do\n\t\t\t\tlocal humanoid = player.Character and player.Character:FindFirstChildOfClass(\"Humanoid\")\n\t\t\t\tif\n\t\t\t\t\thumanoid\n\t\t\t\t\tand humanoid.Health > 0\n\t\t\t\t\tand DataService.IsLoaded(player)\n\t\t\t\t\tand TeamService.GetTeamId(player) == \"Survivor\"\n\t\t\t\tthen\n\t\t\t\t\tXPService.Reward(player, \"Survival\")\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend\n\nreturn XPService\n```\n\n---\n\n### `StarterPlayer/StarterPlayerScripts/HUDController` (LocalScript)\n\n```lua\n-- HUD do jogador: avatar, vida, XP, kills, credits, muni\u00e7\u00e3o, equipe e estado\nlocal Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal GameConfig = require(Modules:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal Remotes = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"Remotes\"))\nlocal AvatarCache = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"AvatarCache\"))\nlocal DataController = require(script.Parent:WaitForChild(\"Controllers\"):WaitForChild(\"DataController\"))\n\nlocal LocalPlr = Players.LocalPlayer\nlocal PlayerGui = LocalPlr:WaitForChild(\"PlayerGui\")\n\nlocal BgColor = Color3.fromRGB(49, 51, 56)\nlocal TEXT = Color3.fromRGB(213, 215, 221)\nlocal WHITE = Color3.new(1, 1, 1)\nlocal XP_COLOR = Color3.fromRGB(124, 181, 255)\nlocal HP_GOOD = Color3.fromRGB(96, 200, 120)\nlocal HP_LOW = Color3.fromRGB(230, 90, 80)\nlocal FONT = Font.fromEnum(Enum.Font.BuilderSans)\nlocal FONT_BOLD = Font.fromEnum(Enum.Font.BuilderSansBold)\n\n-- Estados (atributo \"PlayerState\" definido pelo servidor em fases futuras)\nlocal STATE_NAMES = {\n\tNormal = \"Normal\",\n\tInjured = \"Ferido\",\n\tGrabbed = \"Agarrado\",\n\tInfected = \"Infectado\",\n\tPoisoned = \"Envenenado\",\n\tInCombat = \"Em combate\",\n}\n\n-- Desativa a barra de vida padr\u00e3o\npcall(function()\n\tStarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)\nend)\n\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\n\tlocal inst = Instance.new(className)\n\tfor key, value in pairs(props) do\n\t\tinst[key] = value\n\tend\n\tinst.Parent = parent\n\treturn inst\nend\n\nlocal function label(parent: Instance, props: { [string]: any }): TextLabel\n\tlocal base = {\n\t\tBackgroundTransparency = 1,\n\t\tTextColor3 = TEXT,\n\t\tTextSize = 14,\n\t\tFontFace = FONT,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t}\n\tfor key, value in pairs(props) do\n\t\tbase[key] = value\n\tend\n\treturn make(\"TextLabel\", base, parent)\nend\n\nlocal function formatNumber(n: number): string\n\tlocal reversed = tostring(math.floor(n)):reverse()\n\tlocal withCommas = reversed:gsub(\"(%d%d%d)\", \"%1,\")\n\tlocal result = withCommas:reverse()\n\treturn (result:gsub(\"^,\", \"\"))\nend\n\nlocal function bar(parent: Instance, position: UDim2, height: number, color: Color3)\n\tlocal back = make(\"Frame\", {\n\t\tPosition = position,\n\t\tSize = UDim2.new(1, -24, 0, height),\n\t\tBackgroundColor3 = Color3.fromRGB(30, 31, 34),\n\t\tBorderSizePixel = 0,\n\t\tClipsDescendants = true,\n\t}, parent)\n\tmake(\"UICorner\", { CornerRadius = UDim.new(0, 6) }, back)\n\tlocal fill = make(\"Frame\", {\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tBackgroundColor3 = color,\n\t\tBorderSizePixel = 0,\n\t}, back)\n\tmake(\"UICorner\", { CornerRadius = UDim.new(0, 6) }, fill)\n\tlocal text = label(back, {\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tTextXAlignment = Enum.TextXAlignment.Center,\n\t\tTextColor3 = WHITE,\n\t\tTextSize = 12,\n\t\tFontFace = FONT_BOLD,\n\t\tZIndex = 3,\n\t})\n\treturn fill, text\nend\n\n-- ===== Constru\u00e7\u00e3o da interface =====\nlocal gui = make(\"ScreenGui\", {\n\tName = \"HUD\",\n\tResetOnSpawn = false,\n\tIgnoreGuiInset = true,\n\tDisplayOrder = 4,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, PlayerGui)\n\nlocal root = make(\"Frame\", {\n\tName = \"Root\",\n\tAnchorPoint = Vector2.new(0, 1),\n\tPosition = UDim2.new(0, 16, 1, -16),\n\tSize = UDim2.fromOffset(340, 176),\n\tBackgroundColor3 = BgColor,\n\tBackgroundTransparency = 0.08,\n\tBorderSizePixel = 0,\n}, gui)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 10) }, root)\nmake(\"UIStroke\", { Color = Color3.fromRGB(70, 72, 80), Thickness = 1 }, root)\nlocal scale = make(\"UIScale\", {}, root)\n\nlocal avatar = make(\"ImageLabel\", {\n\tName = \"Avatar\",\n\tPosition = UDim2.fromOffset(12, 12),\n\tSize = UDim2.fromOffset(64, 64),\n\tBackgroundColor3 = Color3.fromRGB(30, 31, 34),\n\tBorderSizePixel = 0,\n}, root)\nmake(\"UICorner\", { CornerRadius = UDim.new(1, 0) }, avatar)\n\nlocal nameLabel = label(root, {\n\tPosition = UDim2.fromOffset(88, 12),\n\tSize = UDim2.new(1, -100, 0, 22),\n\tText = LocalPlr.DisplayName,\n\tTextSize = 18,\n\tTextColor3 = WHITE,\n\tFontFace = FONT_BOLD,\n\tTextTruncate = Enum.TextTruncate.AtEnd,\n})\nlocal teamLabel = label(root, { Position = UDim2.fromOffset(88, 34), Size = UDim2.new(1, -100, 0, 18), Text = \"\" })\nlocal levelLabel = label(root, { Position = UDim2.fromOffset(88, 54), Size = UDim2.new(1, -100, 0, 20), Text = \"N\u00edvel 1\", FontFace = FONT_BOLD })\n\nlocal healthFill, healthText = bar(root, UDim2.fromOffset(12, 86), 18, HP_GOOD)\nlocal xpFill, xpText = bar(root, UDim2.fromOffset(12, 110), 16, XP_COLOR)\n\nlocal killsLabel = label(root, { Position = UDim2.fromOffset(12, 134), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Abates: 0\" })\nlocal creditsLabel = label(root, { Position = UDim2.new(0.5, 0, 0, 134), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Cr\u00e9ditos: 0\" })\nlocal ammoLabel = label(root, { Position = UDim2.fromOffset(12, 154), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Muni\u00e7\u00e3o: --\" })\nlocal stateLabel = label(root, { Position = UDim2.new(0.5, 0, 0, 154), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Estado: Normal\" })\n\nlocal toast = make(\"TextLabel\", {\n\tName = \"Toast\",\n\tAnchorPoint = Vector2.new(0.5, 0),\n\tPosition = UDim2.new(0.5, 0, 0, 90),\n\tSize = UDim2.fromOffset(280, 40),\n\tBackgroundColor3 = BgColor,\n\tBackgroundTransparency = 1,\n\tTextTransparency = 1,\n\tTextColor3 = XP_COLOR,\n\tTextSize = 20,\n\tFontFace = FONT_BOLD,\n\tText = \"\",\n}, gui)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 8) }, toast)\n\n-- ===== Escala responsiva (PC, celular, console) =====\nlocal function updateScale()\n\tlocal camera = workspace.CurrentCamera\n\tif camera then\n\t\tscale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.65, 1.1)\n\tend\nend\nupdateScale()\nif workspace.CurrentCamera then\n\tworkspace.CurrentCamera:GetPropertyChangedSignal(\"ViewportSize\"):Connect(updateScale)\nend\n\n-- ===== Avatar =====\nAvatarCache.Get(LocalPlr.UserId, function(image)\n\tavatar.Image = image\nend)\n\n-- ===== Equipe =====\nlocal function refreshTeam()\n\tlocal team = LocalPlr.Team\n\tteamLabel.Text = team and (\"Equipe: \" .. team.Name) or \"Sem equipe\"\n\tteamLabel.TextColor3 = team and team.TeamColor.Color or TEXT\nend\nLocalPlr:GetPropertyChangedSignal(\"Team\"):Connect(refreshTeam)\nrefreshTeam()\n\n-- ===== Dados (level, XP, kills, credits) =====\nlocal function tweenFill(frame: Frame, ratio: number)\n\tTweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {\n\t\tSize = UDim2.fromScale(math.clamp(ratio, 0, 1), 1),\n\t}):Play()\nend\n\nlocal function refreshData()\n\tlocal level = DataController.Get(\"Level\") or 1\n\tlocal xp = DataController.Get(\"XP\") or 0\n\tlocal required = math.max(1, DataController.Get(\"XPRequired\") or 1)\n\tlocal maxed = level >= GameConfig.Progression.MaxLevel\n\n\tlevelLabel.Text = (\"N\u00edvel %d\"):format(level)\n\tif maxed then\n\t\txpText.Text = \"N\u00cdVEL M\u00c1XIMO\"\n\t\ttweenFill(xpFill, 1)\n\telse\n\t\txpText.Text = (\"XP %s / %s\"):format(formatNumber(xp), formatNumber(required))\n\t\ttweenFill(xpFill, xp / required)\n\tend\n\tkillsLabel.Text = \"Abates: \" .. formatNumber(DataController.Get(\"Kills\") or 0)\n\tcreditsLabel.Text = \"Cr\u00e9ditos: \" .. formatNumber(DataController.Get(\"Credits\") or 0)\nend\n\nDataController.Loaded:Connect(refreshData)\nDataController.Changed:Connect(refreshData)\nif DataController.IsLoaded() then\n\trefreshData()\nend\n\n-- ===== Vida e estado =====\nlocal characterConns: { RBXScriptConnection } = {}\n\nlocal function refreshState(humanoid: Humanoid?)\n\tlocal attr = LocalPlr:GetAttribute(\"PlayerState\")\n\tlocal key = type(attr) == \"string\" and attr or nil\n\tif not key and humanoid and humanoid.MaxHealth > 0 and humanoid.Health / humanoid.MaxHealth <= 0.35 and humanoid.Health > 0 then\n\t\tkey = \"Injured\"\n\tend\n\tstateLabel.Text = \"Estado: \" .. (STATE_NAMES[key or \"Normal\"] or \"Normal\")\nend\n\nlocal function bindCharacter(character: Model)\n\tfor _, conn in ipairs(characterConns) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(characterConns)\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\tif not humanoid then\n\t\treturn\n\tend\n\n\tlocal function update()\n\t\tlocal max = math.max(1, humanoid.MaxHealth)\n\t\tlocal ratio = humanoid.Health / max\n\t\thealthText.Text = (\"%d / %d\"):format(math.ceil(humanoid.Health), math.ceil(max))\n\t\thealthFill.BackgroundColor3 = ratio <= 0.35 and HP_LOW or HP_GOOD\n\t\ttweenFill(healthFill, ratio)\n\t\trefreshState(humanoid)\n\tend\n\n\ttable.insert(characterConns, humanoid.HealthChanged:Connect(update))\n\ttable.insert(characterConns, humanoid:GetPropertyChangedSignal(\"MaxHealth\"):Connect(update))\n\ttable.insert(characterConns, LocalPlr:GetAttributeChangedSignal(\"PlayerState\"):Connect(function()\n\t\trefreshState(humanoid)\n\tend))\n\tupdate()\nend\n\nLocalPlr.CharacterAdded:Connect(bindCharacter)\nif LocalPlr.Character then\n\ttask.spawn(bindCharacter, LocalPlr.Character)\nend\n\n-- ===== Muni\u00e7\u00e3o (atributos preenchidos pelo sistema de armas na Fase 3) =====\nlocal function refreshAmmo()\n\tlocal mag = LocalPlr:GetAttribute(\"AmmoInMagazine\")\n\tlocal reserve = LocalPlr:GetAttribute(\"AmmoReserve\")\n\tif type(mag) == \"number\" and type(reserve) == \"number\" then\n\t\tammoLabel.Text = (\"Muni\u00e7\u00e3o: %d / %d\"):format(mag, reserve)\n\telse\n\t\tammoLabel.Text = \"Muni\u00e7\u00e3o: --\"\n\tend\nend\nLocalPlr:GetAttributeChangedSignal(\"AmmoInMagazine\"):Connect(refreshAmmo)\nLocalPlr:GetAttributeChangedSignal(\"AmmoReserve\"):Connect(refreshAmmo)\nrefreshAmmo()\n\n-- ===== Notifica\u00e7\u00e3o de level up =====\nlocal toastToken = 0\nRemotes.Get(\"PlayerData\", \"LevelUp\").OnClientEvent:Connect(function(level)\n\tif type(level) ~= \"number\" then\n\t\treturn\n\tend\n\ttoastToken += 1\n\tlocal token = toastToken\n\ttoast.Text = (\"Voc\u00ea subiu para o n\u00edvel %d!\"):format(level)\n\tTweenService:Create(toast, TweenInfo.new(0.2), { TextTransparency = 0, BackgroundTransparency = 0.1 }):Play()\n\ttask.delay(2.5, function()\n\t\tif token == toastToken then\n\t\t\tTweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()\n\t\tend\n\tend)\nend)\n```\n\n### `StarterPlayer/StarterPlayerScripts/LeaderboardController` (LocalScript)\n\n```lua\n-- Leaderboard pr\u00f3pria (independente da PlayerList do Roblox), inspirada no PlayerListReskin\nlocal Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Teams = game:GetService(\"Teams\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedS