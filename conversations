at(bottom + 1 + (sz.Y - 1) / 2) }, model)\\n\\t\\tpart({ Name = \\\"CrossH\\\", Size = Vector3.new(2.2, 0.6, 0.3), Color = Color3.fromRGB(120, 255, 160),\\n\\t\\t\\tMaterial = Enum.Material.Neon, CanCollide = false, CFrame = at(0.3) * CFrame.new(0, 0, -0.8) }, model)\\n\\t\\tpart({ Name = \\\"CrossV\\\", Size = Vector3.new(0.6, 2.2, 0.3), Color = Color3.fromRGB(120, 255, 160),\\n\\t\\t\\tMaterial = Enum.Material.Neon, CanCollide = false, CFrame = at(0.3) * CFrame.new(0, 0, -0.8) }, model)\\n\\tend\\n\\n\\tmodel.PrimaryPart = base\\n\\tmodel:SetAttribute(\\\"Health\\\", cfg.Health)\\n\\tmodel:SetAttribute(\\\"MaxHealth\\\", cfg.Health)\\n\\tmodel:SetAttribute(\\\"OwnerId\\\", player.UserId)\\n\\tmodel:SetAttribute(\\\"ItemId\\\", id)\\n\\tstructures[model] = st\\n\\tmodel.Destroying:Connect(function()\\n\\t\\tstructures[model] = nil\\n\\t\\ttask.defer(refreshOwned, player)\\n\\tend)\\n\\taddHealthBar(model, base)\\n\\treturn model\\nend\\n\\n-- ===== valida\u00e7\u00e3o de espa\u00e7o =====\\nlocal function ignoreList()\\n\\tlocal list = { folder }\\n\\tlocal z = workspace:FindFirstChild(\\\"Zombies\\\")\\n\\tif z then table.insert(list, z) end\\n\\tfor _, p in ipairs(Players:GetPlayers()) do\\n\\t\\tif p.Character then table.insert(list, p.Character) end\\n\\tend\\n\\treturn list\\nend\\n\\nlocal function spaceFree(cf, size)\\n\\tlocal box = Vector3.new(math.max(size.X - 0.3, 0.1), math.max(size.Y - 0.3, 0.1), math.max(size.Z - 0.3, 0.1))\\n\\n\\tlocal p1 = OverlapParams.new()\\n\\tp1.FilterType = Enum.RaycastFilterType.Include\\n\\tp1.FilterDescendantsInstances = { folder }\\n\\tif #workspace:GetPartBoundsInBox(cf, box, p1) > 0 then return false, \\\"Espa\u00e7o ocupado\\\" end\\n\\n\\tlocal living = {}\\n\\tlocal z = workspace:FindFirstChild(\\\"Zombies\\\")\\n\\tif z then table.insert(living, z) end\\n\\tfor _, p in ipairs(Players:GetPlayers()) do\\n\\t\\tif p.Character then table.insert(living, p.Character) end\\n\\tend\\n\\tlocal p2 = OverlapParams.new()\\n\\tp2.FilterType = Enum.RaycastFilterType.Include\\n\\tp2.FilterDescendantsInstances = living\\n\\tif #workspace:GetPartBoundsInBox(cf, box, p2) > 0 then return false, \\\"Tem algu\u00e9m no local\\\" end\\n\\treturn true\\nend\\n\\nlocal function aliveRoot(player)\\n\\tlocal char = player.Character\\n\\tlocal hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\tlocal root = char and char:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\tif hum and root and hum.Health > 0 then return root end\\nend\\n\\n-- ===== a\u00e7\u00f5es =====\\nfunction BuildService.Place(player, id, pos, rotDeg)\\n\\tif typeof(id) ~= \\\"string\\\" or typeof(pos) ~= \\\"Vector3\\\" or typeof(rotDeg) ~= \\\"number\\\" then\\n\\t\\treturn false, \\\"Pedido inv\u00e1lido\\\"\\n\\tend\\n\\tlocal cfg = Config.Buildables[id]\\n\\tif not cfg then return false, \\\"Item inv\u00e1lido\\\" end\\n\\tif pos ~= pos or rotDeg ~= rotDeg or pos.Magnitude > 100000 then return false, \\\"Pedido inv\u00e1lido\\\" end\\n\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\tif (root.Position - pos).Magnitude > B.MaxDistance + 6 then return false, \\\"Longe demais\\\" end\\n\\tif BuildService.CountOwned(player, id) >= cfg.Max then return false, \\\"Limite atingido (\\\" .. cfg.Max .. \\\")\\\" end\\n\\n\\tlocal moneyVal = player:FindFirstChild(\\\"leaderstats\\\") and player.leaderstats:FindFirstChild(\\\"Money\\\")\\n\\tif not moneyVal or moneyVal.Value < cfg.Cost then return false, \\\"Dinheiro insuficiente\\\" end\\n\\n\\trotDeg = math.round(rotDeg / 15) * 15\\n\\n\\tlocal params = RaycastParams.new()\\n\\tparams.FilterType = Enum.RaycastFilterType.Exclude\\n\\tparams.FilterDescendantsInstances = ignoreList()\\n\\tlocal res = workspace:Raycast(Vector3.new(pos.X, pos.Y + 20, pos.Z), Vector3.new(0, -60, 0), params)\\n\\tif not res then return false, \\\"Sem ch\u00e3o aqui\\\" end\\n\\n\\tlocal center = Vector3.new(pos.X, res.Position.Y + cfg.Size.Y / 2, pos.Z)\\n\\tlocal cf = CFrame.new(center) * CFrame.Angles(0, math.rad(rotDeg), 0)\\n\\tlocal free, why = spaceFree(cf, cfg.Size)\\n\\tif not free then return false, why end\\n\\n\\tif not PlayerData.SpendMoney(player, cfg.Cost) then return false, \\\"Dinheiro insuficiente\\\" end\\n\\tlocal model = build(player, id, cfg, cf)\\n\\tmodel.Parent = folder\\n\\trefreshOwned(player)\\n\\treturn true, cfg.Name .. \\\" constru\u00eddo!\\\"\\nend\\n\\nfunction BuildService.Repair(player)\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\n\\tlocal list = {}\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal p = model.PrimaryPart\\n\\t\\tif p and (p.Position - root.Position).Magnitude <= B.RepairRadius then\\n\\t\\t\\tlocal hp, max = model:GetAttribute(\\\"Health\\\"), model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\t\\tif hp < max then table.insert(list, { model = model, ratio = hp / max }) end\\n\\t\\tend\\n\\tend\\n\\tif #list == 0 then return false, \\\"Nada para reparar por perto\\\" end\\n\\ttable.sort(list, function(a, b) return a.ratio < b.ratio end)\\n\\n\\tlocal moneyVal = player:FindFirstChild(\\\"leaderstats\\\") and player.leaderstats:FindFirstChild(\\\"Money\\\")\\n\\tlocal money = moneyVal and moneyVal.Value or 0\\n\\tlocal spent, fixed = 0, 0\\n\\tfor _, e in ipairs(list) do\\n\\t\\tlocal hp, max = e.model:GetAttribute(\\\"Health\\\"), e.model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\tlocal canHp = math.min(max - hp, math.floor((money - spent) / B.RepairCostPerHp))\\n\\t\\tif canHp <= 0 then break end\\n\\t\\te.model:SetAttribute(\\\"Health\\\", hp + canHp)\\n\\t\\tspent += math.ceil(canHp * B.RepairCostPerHp)\\n\\t\\tfixed += 1\\n\\tend\\n\\tif fixed == 0 then return false, \\\"Dinheiro insuficiente para reparar\\\" end\\n\\tspent = math.min(spent, money)\\n\\tPlayerData.SpendMoney(player, spent)\\n\\treturn true, (\\\"Reparou %d estrutura(s)  -$%d\\\"):format(fixed, spent)\\nend\\n\\nfunction BuildService.Demolish(player)\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\tlocal best, bestD\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal p = model.PrimaryPart\\n\\t\\tif p and model:GetAttribute(\\\"OwnerId\\\") == player.UserId then\\n\\t\\t\\tlocal d = (p.Position - root.Position).Magnitude\\n\\t\\t\\tif d <= B.DemolishRadius and (not bestD or d < bestD) then best, bestD = model, d end\\n\\t\\tend\\n\\tend\\n\\tif not best then return false, \\\"Nenhuma estrutura sua por perto\\\" end\\n\\tlocal refund = math.floor(structures[best].cfg.Cost * B.RefundPct)\\n\\tbest:Destroy()\\n\\tPlayerData.AddMoney(player, refund)\\n\\treturn true, (\\\"Demolido  +$%d\\\"):format(refund)\\nend\\n\\nfunction BuildService.RegenAll(fraction)\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal max = model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\tmodel:SetAttribute(\\\"Health\\\", math.min(max, (model:GetAttribute(\\\"Health\\\") or 0) + max * fraction))\\n\\tend\\nend\\n\\nfunction BuildService.RemoveOwner(player)\\n\\tlocal userId = player.UserId\\n\\tfor _, m in ipairs(folder:GetChildren()) do\\n\\t\\tif m:GetAttribute(\\\"OwnerId\\\") == userId then m:Destroy() end\\n\\tend\\nend\\n\\nfunction BuildService.ClearAll()\\n\\tfor _, m in ipairs(folder:GetChildren()) do m:Destroy() end\\nend\\n\\nfunction BuildService.Init()\\n\\tRemotes.Build.OnServerInvoke = function(player, action, ...)\\n\\t\\tlocal now = os.clock()\\n\\t\\tif now - (lastAction[player] or 0) < 0.12 then return false, \\\"Calma!\\\" end\\n\\t\\tlastAction[player] = now\\n\\t\\tif not player:FindFirstChild(\\\"leaderstats\\\") then return false, \\\"Aguarde...\\\" end\\n\\n\\t\\tlocal ok, msg\\n\\t\\tif action == \\\"Place\\\" then\\n\\t\\t\\tlocal id, pos, rot = ...\\n\\t\\t\\tok, msg = BuildService.Place(player, id, pos, rot)\\n\\t\\telseif action == \\\"Repair\\\" then\\n\\t\\t\\tok, msg = BuildService.Repair(player)\\n\\t\\telseif action == \\\"Demolish\\\" then\\n\\t\\t\\tok, msg = BuildService.Demolish(player)\\n\\t\\telse\\n\\t\\t\\treturn false, \\\"Pedido inv\u00e1lido\\\"\\n\\t\\tend\\n\\t\\tif msg and (not ok or action ~= \\\"Place\\\") then notify(player, (ok and \\\"\u2714 \\\" or \\\"\u2716 \\\") .. msg) end\\n\\t\\treturn ok, msg\\n\\tend\\n\\tPlayers.PlayerRemoving:Connect(function(p) lastAction[p] = nil end)\\nend\\n\\n-- ===== comportamento das estruturas (loop) =====\\nlocal function explode(model, st)\\n\\tlocal cfg = st.cfg\\n\\tlocal pos = model.PrimaryPart.Position\\n\\tlocal owner = ownerOf(model)\\n\\n\\tlocal ex = Instance.new(\\\"Explosion\\\")\\n\\tex.Position = pos\\n\\tex.BlastRadius = cfg.Radius\\n\\tex.BlastPressure = 0\\n\\tex.DestroyJointRadiusPercent = 0\\n\\tex.ExplosionType = Enum.ExplosionType.NoCraters\\n\\tex.Parent = workspace\\n\\n\\tlocal dmg = cfg.Damage * dmgMult(owner)\\n\\tfor _, z in ipairs(ZombieService.ZombiesInRadius(pos, cfg.Radius)) do\\n\\t\\tZombieService.Damage(z, dmg, owner)\\n\\tend\\n\\tmodel:Destroy()\\nend\\n\\nfunction BuildService.Start()\\n\\ttask.spawn(function()\\n\\t\\twhile true do\\n\\t\\t\\ttask.wait(0.1)\\n\\t\\t\\tlocal now = os.clock()\\n\\n\\t\\t\\tlocal zombiesOnSpikes = {}\\n\\n\\t\\t\\tfor model, st in pairs(structures) do\\n\\t\\t\\t\\tlocal base = model.PrimaryPart\\n\\t\\t\\t\\tif not model.Parent or not base then\\n\\t\\t\\t\\t\\tstructures[model] = nil\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tlocal cfg = st.cfg\\n\\t\\t\\t\\t\\tlocal kind = cfg.Kind\\n\\n\\t\\t\\t\\t\\tif kind == \\\"Turret\\\" then\\n\\t\\t\\t\\t\\t\\tif now - st.last >= cfg.Cooldown then\\n\\t\\t\\t\\t\\t\\t\\tlocal origin = st.body.Position\\n\\t\\t\\t\\t\\t\\t\\tlocal target = ZombieService.NearestZombie(origin, cfg.Range)\\n\\t\\t\\t\\t\\t\\t\\tif target then\\n\\t\\t\\t\\t\\t\\t\\t\\tst.last = now\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal tPos = target.HumanoidRootPart.Position\\n\\t\\t\\t\\t\\t\\t\\t\\tst.head.CFrame = CFrame.lookAt(origin, tPos) * CFrame.new(0, 0, -1.8)\\n\\t\\t\\t\\t\\t\\t\\t\\ttracer((st.head.CFrame * CFrame.new(0, 0, -1.5)).Position, tPos)\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal owner = ownerOf(model)\\n\\t\\t\\t\\t\\t\\t\\t\\tZombieService.Damage(target, cfg.Damage * dmgMult(owner), owner)\\n\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\tend\\n\\n\\t\\t\\t\\t\\telseif kind == \\\"Spikes\\\" then\\n\\t\\t\\t\\t\\t\\tif now - st.last >= 0.1 then\\n\\t\\t\\t\\t\\t\\t\\tlocal dt = now - st.last\\n\\t\\t\\t\\t\\t\\t\\tst.last = now\\n\\t\\t\\t\\t\\t\\t\\tlocal hits = ZombieService.ZombiesInRadius(base.Position, cfg.Radius)\\n\\t\\t\\t\\t\\t\\t\\tif #hits > 0 then\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal owner = ownerOf(model)\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal dmg = (cfg.DPS or 30) * dt * dmgMult(owner)\\n\\t\\t\\t\\t\\t\\t\\t\\tfor _, z in ipairs(hits) do\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tzombiesOnSpikes[z] = true\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tZombieService.Damage(z, dmg, owner)\\n\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tlocal zHum = z:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tif zHum and zHum.Health > 0 then\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tlocal baseSpeed = z:GetAttribute(\\\"BaseSpeed\\\") or 10\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tzHum.WalkSpeed = baseSpeed * 0.5\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tzombieSlowExpiry[z] = now + 3\\n\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tzombieBleed[z] = {\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\ttimeRemaining = 15,\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\tnextTick = now + 3,\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t\\towner = owner\\n\\t\\t\\t\\t\\t\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\t\\t\\tend\\n\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal maxHp = model:GetAttribute(\\\"MaxHealth\\\") or cfg.Health\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal wearAmount = maxHp * 0.07 * #hits * dt\\n\\t\\t\\t\\t\\t\\t\\t\\thurt(model, wearAmount)\\n\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\tend\\n\\n\\t\\t\\t\\t\\telseif kind == \\\"Mine\\\" then\\n\\t\\t\\t\\t\\t\\tif now - st.last >= 0.2 then\\n\\t\\t\\t\\t\\t\\t\\tst.last = now\\n\\t\\t\\t\\t\\t\\t\\tif ZombieService.NearestZombie(base.Position, cfg.Trigger) then\\n\\t\\t\\t\\t\\t\\t\\t\\texplode(model, st)\\n\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\tend\\n\\n\\t\\t\\t\\t\\telseif kind == \\\"Station\\\" then\\n\\t\\t\\t\\t\\t\\tif now - st.last >= 1 then\\n\\t\\t\\t\\t\\t\\t\\tst.last = now\\n\\t\\t\\t\\t\\t\\t\\tlocal playersInRadius = Players:GetPlayers()\\n\\t\\t\\t\\t\\t\\t\\tfor _, plr in ipairs(playersInRadius) do\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal char = plr.Character\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\t\\t\\t\\t\\t\\t\\tlocal r = char and char:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\t\\t\\t\\t\\t\\t\\t\\tif hum and r and hum.Health > 0 and hum.Health < hum.MaxHealth\\n\\t\\t\\t\\t\\t\\t\\t\\t\\tand (r.Position - base.Position).Magnitude <= cfg.Radius then\\n\\t\\t\\t\\t\\t\\t\\t\\t\\thum.Health = math.min(hum.MaxHealth, hum.Health + hum.MaxHealth * cfg.HealPct)\\n\\t\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\n\\t\\t\\tfor z, data in pairs(zombieBleed) do\\n\\t\\t\\t\\tlocal zHum = z:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\t\\t\\tif not z.Parent or not zHum or zHum.Health <= 0 or data.timeRemaining <= 0 then\\n\\t\\t\\t\\t\\tzombieBleed[z] = nil\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tdata.timeRemaining = data.timeRemaining - 0.1\\n\\t\\t\\t\\t\\tif now >= data.nextTick then\\n\\t\\t\\t\\t\\t\\tdata.nextTick = now + 3\\n\\t\\t\\t\\t\\t\\tlocal bleedDmg = zHum.MaxHealth * 0.05\\n\\t\\t\\t\\t\\t\\tZombieService.Damage(z, bleedDmg, data.owner)\\n\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\n\\t\\t\\tfor z, expiryTime in pairs(zombieSlowExpiry) do\\n\\t\\t\\t\\tlocal zHum = z:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\t\\t\\tif not z.Parent or not zHum or zHum.Health <= 0 then\\n\\t\\t\\t\\t\\tzombieSlowExpiry[z] = nil\\n\\t\\t\\t\\telseif not zombiesOnSpikes[z] then\\n\\t\\t\\t\\t\\tif now >= expiryTime then\\n\\t\\t\\t\\t\\t\\tlocal baseSpeed = z:GetAttribute(\\\"BaseSpeed\\\") or 10\\n\\t\\t\\t\\t\\t\\tzHum.WalkSpeed = baseSpeed\\n\\t\\t\\t\\t\\t\\tzombieSlowExpiry[z] = nil\\n\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend)\\nend\\n\\nreturn BuildService\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"-- ModuleScript: ServerScriptService/Game/BuildService\\n-- Sistema de constru\u00e7\u00e3o: paredes, sacos de areia, arame farpado, minas, torretas e esta\u00e7\u00e3o de cura.\\n-- Toda estrutura tem vida (barra em cima), pode ser atacada, reparada (F) e demolida (X)\\n\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\nlocal Debris = game:GetService(\\\"Debris\\\")\\n\\nlocal Config = require(ReplicatedStorage:WaitForChild(\\\"Config\\\"))\\nlocal Remotes = ReplicatedStorage:WaitForChild(\\\"Remotes\\\")\\nlocal PlayerData = require(script.Parent.PlayerData)\\nlocal ZombieService = require(script.Parent.ZombieService)\\n\\nlocal folder = workspace:WaitForChild(\\\"Structures\\\")\\nlocal B = Config.Build\\n\\nlocal BuildService = {}\\nlocal structures = {} -- [model] = { cfg, id, last, body, head }\\nlocal lastAction = {}\\n\\n-- Tabelas para rastreamento dos efeitos do Spike\\nlocal zombieBleed = {}      -- [z] = { timeRemaining = 15, nextTick = time, owner = owner }\\nlocal zombieSlowExpiry = {} -- [z] = expiryTime\\n\\n-- ===== helpers =====\\nlocal function part(props, parent)\\n\\tlocal p = Instance.new(\\\"Part\\\")\\n\\tif props.Shape then p.Shape = props.Shape end\\n\\tp.Anchored = true\\n\\tp.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth\\n\\tfor k, v in pairs(props) do\\n\\t\\tif k ~= \\\"Shape\\\" then p[k] = v end\\n\\tend\\n\\tp.Parent = parent\\n\\treturn p\\nend\\n\\nlocal function notify(player, msg)\\n\\tRemotes.Notify:FireClient(player, msg)\\nend\\n\\nlocal function ownerOf(model)\\n\\treturn Players:GetPlayerByUserId(model:GetAttribute(\\\"OwnerId\\\") or 0)\\nend\\n\\nlocal function dmgMult(owner)\\n\\tif owner and owner:FindFirstChild(\\\"leaderstats\\\") then return PlayerData.GetDamageMult(owner) end\\n\\treturn 1\\nend\\n\\nlocal function hurt(model, amount)\\n\\tlocal hp = (model:GetAttribute(\\\"Health\\\") or 0) - amount\\n\\tmodel:SetAttribute(\\\"Health\\\", hp)\\n\\tif hp <= 0 then model:Destroy() end\\nend\\n\\nlocal function tracer(a, b)\\n\\tlocal d = (b - a).Magnitude\\n\\tlocal p = part({\\n\\t\\tSize = Vector3.new(0.15, 0.15, d), Material = Enum.Material.Neon,\\n\\t\\tColor = Color3.fromRGB(255, 220, 100), CanCollide = false, CanQuery = false, CanTouch = false,\\n\\t\\tCFrame = CFrame.lookAt(a, b) * CFrame.new(0, 0, -d / 2),\\n\\t}, workspace)\\n\\tDebris:AddItem(p, 0.06)\\nend\\n\\nfunction BuildService.CountOwned(player, id)\\n\\tlocal n = 0\\n\\tfor _, m in ipairs(folder:GetChildren()) do\\n\\t\\tif m:GetAttribute(\\\"OwnerId\\\") == player.UserId and m:GetAttribute(\\\"ItemId\\\") == id then n += 1 end\\n\\tend\\n\\treturn n\\nend\\n\\nlocal function refreshOwned(player)\\n\\tif not player.Parent then return end\\n\\tfor id in pairs(Config.Buildables) do\\n\\t\\tplayer:SetAttribute(\\\"Own_\\\" .. id, BuildService.CountOwned(player, id))\\n\\tend\\nend\\n\\n-- barra de vida acima da estrutura\\nlocal function addHealthBar(model, base)\\n\\tlocal cf, size = model:GetBoundingBox()\\n\\tlocal offsetY = (cf.Position.Y + size.Y / 2 + 1.5) - base.Position.Y\\n\\n\\tlocal gui = Instance.new(\\\"BillboardGui\\\")\\n\\tgui.Name = \\\"HealthBar\\\"\\n\\tgui.Adornee = base\\n\\tgui.Size = UDim2.fromOffset(70, 8)\\n\\tgui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)\\n\\tgui.MaxDistance = 90\\n\\tgui.Parent = base\\n\\n\\tlocal back = Instance.new(\\\"Frame\\\")\\n\\tback.Size = UDim2.fromScale(1, 1)\\n\\tback.BackgroundColor3 = Color3.fromRGB(20, 20, 20)\\n\\tback.BorderSizePixel = 0\\n\\tback.Parent = gui\\n\\tlocal fill = Instance.new(\\\"Frame\\\")\\n\\tfill.Size = UDim2.fromScale(1, 1)\\n\\tfill.BorderSizePixel = 0\\n\\tfill.Parent = back\\n\\n\\tlocal function update()\\n\\t\\tlocal r = math.clamp((model:GetAttribute(\\\"Health\\\") or 0) / (model:GetAttribute(\\\"MaxHealth\\\") or 1), 0, 1)\\n\\t\\tfill.Size = UDim2.fromScale(r, 1)\\n\\t\\tfill.BackgroundColor3 = Color3.fromRGB(220, 60, 50):Lerp(Color3.fromRGB(80, 210, 90), r)\\n\\tend\\n\\tmodel:GetAttributeChangedSignal(\\\"Health\\\"):Connect(update)\\n\\tupdate()\\nend\\n\\n-- ===== constru\u00e7\u00e3o das pe\u00e7as por tipo =====\\nlocal function build(player, id, cfg, cf)\\n\\tlocal model = Instance.new(\\\"Model\\\")\\n\\tmodel.Name = cfg.Name\\n\\tlocal st = { cfg = cfg, id = id, last = os.clock() }\\n\\tlocal sz = cfg.Size\\n\\tlocal bottom = -sz.Y / 2\\n\\tlocal function at(y) return cf * CFrame.new(0, y, 0) end\\n\\tlocal kind = cfg.Kind\\n\\tlocal base\\n\\tlocal dark = Color3.fromRGB(40, 40, 45)\\n\\n\\tif kind == \\\"Wall\\\" then\\n\\t\\tif cfg.Style == \\\"Sandbag\\\" then\\n\\t\\t\\tlocal lowH, upH = sz.Y * 0.55, sz.Y * 0.45\\n\\t\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(sz.X, lowH, sz.Z), Color = cfg.Color,\\n\\t\\t\\t\\tMaterial = cfg.Material, CFrame = at(bottom + lowH / 2) }, model)\\n\\t\\t\\tpart({ Name = \\\"Top\\\", Size = Vector3.new(sz.X * 0.8, upH, sz.Z * 0.8),\\n\\t\\t\\t\\tColor = cfg.Color:Lerp(Color3.new(0, 0, 0), 0.12), Material = cfg.Material,\\n\\t\\t\\t\\tCFrame = at(bottom + lowH + upH / 2) }, model)\\n\\t\\telse\\n\\t\\t\\tbase = part({ Name = \\\"Base\\\", Size = sz, Color = cfg.Color, Material = cfg.Material, CFrame = cf }, model)\\n\\t\\tend\\n\\n\\telseif kind == \\\"Turret\\\" then\\n\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(3, 1, 3), Color = dark, Material = Enum.Material.Metal,\\n\\t\\t\\tCFrame = at(bottom + 0.5) }, model)\\n\\t\\tlocal bodyCF = at(bottom + 2)\\n\\t\\tst.body = part({ Name = \\\"Body\\\", Size = Vector3.new(2, 2, 2), Color = cfg.Color, Material = Enum.Material.Metal,\\n\\t\\t\\tCFrame = bodyCF }, model)\\n\\t\\tst.head = part({ Name = \\\"Barrel\\\", Size = Vector3.new(0.6, 0.6, 3), Color = Color3.fromRGB(25, 25, 25),\\n\\t\\t\\tMaterial = Enum.Material.Metal, CFrame = bodyCF * CFrame.new(0, 0, -1.8) }, model)\\n\\n\\telseif kind == \\\"Spikes\\\" then\\n\\t\\tlocal plate = 0.3\\n\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(sz.X, plate, sz.Z), Color = Color3.fromRGB(60, 60, 65),\\n\\t\\t\\tMaterial = Enum.Material.Metal, CanCollide = false, CFrame = at(bottom + plate / 2) }, model)\\n\\t\\tfor ix = 1, 4 do\\n\\t\\t\\tfor iz = 1, 2 do\\n\\t\\t\\t\\tlocal x = (ix - 2.5) * (sz.X / 4)\\n\\t\\t\\t\\tlocal z = (iz - 1.5) * (sz.Z / 2)\\n\\t\\t\\t\\tpart({ Name = \\\"Spike\\\", Size = Vector3.new(0.35, sz.Y - plate, 0.35), Color = Color3.fromRGB(170, 170, 175),\\n\\t\\t\\t\\t\\tMaterial = Enum.Material.Metal, CanCollide = false,\\n\\t\\t\\t\\t\\tCFrame = at(bottom + plate + (sz.Y - plate) / 2) * CFrame.new(x, 0, z) }, model)\\n\\t\\t\\tend\\n\\t\\tend\\n\\n\\telseif kind == \\\"Mine\\\" then\\n\\t\\tbase = part({ Name = \\\"Base\\\", Shape = Enum.PartType.Cylinder, Size = Vector3.new(sz.Y, sz.X, sz.Z),\\n\\t\\t\\tColor = Color3.fromRGB(70, 70, 60), Material = Enum.Material.Metal, CanCollide = false,\\n\\t\\t\\tCFrame = at(0) * CFrame.Angles(0, 0, math.rad(90)) }, model)\\n\\t\\tpart({ Name = \\\"Light\\\", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6),\\n\\t\\t\\tColor = Color3.fromRGB(255, 40, 40), Material = Enum.Material.Neon, CanCollide = false,\\n\\t\\t\\tCFrame = at(sz.Y / 2 + 0.1) }, model)\\n\\n\\telseif kind == \\\"Station\\\" then\\n\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(3, 1, 3), Color = Color3.fromRGB(235, 235, 235),\\n\\t\\t\\tMaterial = Enum.Material.Metal, CFrame = at(bottom + 0.5) }, model)\\n\\t\\tpart({ Name = \\\"Pillar\\\", Size = Vector3.new(1.4, sz.Y - 1, 1.4), Color = cfg.Color,\\n\\t\\t\\tMaterial = Enum.Material.SmoothPlastic, CFrame = at(bottom + 1 + (sz.Y - 1) / 2) }, model)\\n\\t\\tpart({ Name = \\\"CrossH\\\", Size = Vector3.new(2.2, 0.6, 0.3), Color = Color3.fromRGB(120, 255, 160),\\n\\t\\t\\tMaterial = Enum.Material.Neon, CanCollide = false, CFrame = at(0.3) * CFrame.new(0, 0, -0.8) }, model)\\n\\t\\tpart({ Name = \\\"CrossV\\\", Size = Vector3.new(0.6, 2.2, 0.3), Color = Color3.fromRGB(120, 255, 160),\\n\\t\\t\\tMaterial = Enum.Material.Neon, CanCollide = false, CFrame = at(0.3) * CFrame.new(0, 0, -0.8) }, model)\\n\\tend\\n\\n\\tmodel.PrimaryPart = base\\n\\tmodel:SetAttribute(\\\"Health\\\", cfg.Health)\\n\\tmodel:SetAttribute(\\\"MaxHealth\\\", cfg.Health)\\n\\tmodel:SetAttribute(\\\"OwnerId\\\", player.UserId)\\n\\tmodel:SetAttribute(\\\"ItemId\\\", id)\\n\\tstructures[model] = st\\n\\tmodel.Destroying:Connect(function()\\n\\t\\tstructures[model] = nil\\n\\t\\ttask.defer(refreshOwned, player)\\n\\tend)\\n\\taddHealthBar(model, base)\\n\\treturn model\\nend\\n\\n-- ===== valida\u00e7\u00e3o de espa\u00e7o =====\\nlocal function ignoreList()\\n\\tlocal list = { folder }\\n\\tlocal z = workspace:FindFirstChild(\\\"Zombies\\\")\\n\\tif z then table.insert(list, z) end\\n\\tfor _, p in ipairs(Players:GetPlayers()) do\\n\\t\\tif p.Character then table.insert(list, p.Character) end\\n\\tend\\n\\treturn list\\nend\\n\\nlocal function spaceFree(cf, size)\\n\\tlocal box = Vector3.new(math.max(size.X - 0.3, 0.1), math.max(size.Y - 0.3, 0.1), math.max(size.Z - 0.3, 0.1))\\n\\n\\tlocal p1 = OverlapParams.new()\\n\\tp1.FilterType = Enum.RaycastFilterType.Include\\n\\tp1.FilterDescendantsInstances = { folder }\\n\\tif #workspace:GetPartBoundsInBox(cf, box, p1) > 0 then return false, \\\"Espa\u00e7o ocupado\\\" end\\n\\n\\tlocal living = {}\\n\\tlocal z = workspace:FindFirstChild(\\\"Zombies\\\")\\n\\tif z then table.insert(living, z) end\\n\\tfor _, p in ipairs(Players:GetPlayers()) do\\n\\t\\tif p.Character then table.insert(living, p.Character) end\\n\\tend\\n\\tlocal p2 = OverlapParams.new()\\n\\tp2.FilterType = Enum.RaycastFilterType.Include\\n\\tp2.FilterDescendantsInstances = living\\n\\tif #workspace:GetPartBoundsInBox(cf, box, p2) > 0 then return false, \\\"Tem algu\u00e9m no local\\\" end\\n\\treturn true\\nend\\n\\nlocal function aliveRoot(player)\\n\\tlocal char = player.Character\\n\\tlocal hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\tlocal root = char and char:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\tif hum and root and hum.Health > 0 then return root end\\nend\\n\\n-- ===== a\u00e7\u00f5es =====\\nfunction BuildService.Place(player, id, pos, rotDeg)\\n\\tif typeof(id) ~= \\\"string\\\" or typeof(pos) ~= \\\"Vector3\\\" or typeof(rotDeg) ~= \\\"number\\\" then\\n\\t\\treturn false, \\\"Pedido inv\u00e1lido\\\"\\n\\tend\\n\\tlocal cfg = Config.Buildables[id]\\n\\tif not cfg then return false, \\\"Item inv\u00e1lido\\\" end\\n\\tif pos ~= pos or rotDeg ~= rotDeg or pos.Magnitude > 100000 then return false, \\\"Pedido inv\u00e1lido\\\" end\\n\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\tif (root.Position - pos).Magnitude > B.MaxDistance + 6 then return false, \\\"Longe demais\\\" end\\n\\tif BuildService.CountOwned(player, id) >= cfg.Max then return false, \\\"Limite atingido (\\\" .. cfg.Max .. \\\")\\\" end\\n\\n\\tlocal moneyVal = player:FindFirstChild(\\\"leaderstats\\\") and player.leaderstats:FindFirstChild(\\\"Money\\\")\\n\\tif not moneyVal or moneyVal.Value < cfg.Cost then return false, \\\"Dinheiro insuficiente\\\" end\\n\\n\\trotDeg = math.round(rotDeg / 15) * 15\\n\\n\\tlocal params = RaycastParams.new()\\n\\tparams.FilterType = Enum.RaycastFilterType.Exclude\\n\\tparams.FilterDescendantsInstances = ignoreList()\\n\\tlocal res = workspace:Raycast(Vector3.new(pos.X, pos.Y + 20, pos.Z), Vector3.new(0, -60, 0), params)\\n\\tif not res then return false, \\\"Sem ch\u00e3o aqui\\\" end\\n\\n\\tlocal center = Vector3.new(pos.X, res.Position.Y + cfg.Size.Y / 2, pos.Z)\\n\\tlocal cf = CFrame.new(center) * CFrame.Angles(0, math.rad(rotDeg), 0)\\n\\tlocal free, why = spaceFree(cf, cfg.Size)\\n\\tif not free then return false, why end\\n\\n\\tif not PlayerData.SpendMoney(player, cfg.Cost) then return false, \\\"Dinheiro insuficiente\\\" end\\n\\tlocal model = build(player, id, cfg, cf)\\n\\tmodel.Parent = folder\\n\\trefreshOwned(player)\\n\\treturn true, cfg.Name .. \\\" constru\u00eddo!\\\"\\nend\\n\\nfunction BuildService.Repair(player)\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\n\\tlocal list = {}\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal p = model.PrimaryPart\\n\\t\\tif p and (p.Position - root.Position).Magnitude <= B.RepairRadius then\\n\\t\\t\\tlocal hp, max = model:GetAttribute(\\\"Health\\\"), model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\t\\tif hp < max then table.insert(list, { model = model, ratio = hp / max }) end\\n\\t\\tend\\n\\tend\\n\\tif #list == 0 then return false, \\\"Nada para reparar por perto\\\" end\\n\\ttable.sort(list, function(a, b) return a.ratio < b.ratio end)\\n\\n\\tlocal moneyVal = player:FindFirstChild(\\\"leaderstats\\\") and player.leaderstats:FindFirstChild(\\\"Money\\\")\\n\\tlocal money = moneyVal and moneyVal.Value or 0\\n\\tlocal spent, fixed = 0, 0\\n\\tfor _, e in ipairs(list) do\\n\\t\\tlocal hp, max = e.model:GetAttribute(\\\"Health\\\"), e.model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\tlocal canHp = math.min(max - hp, math.floor((money - spent) / B.RepairCostPerHp))\\n\\t\\tif canHp <= 0 then break end\\n\\t\\te.model:SetAttribute(\\\"Health\\\", hp + canHp)\\n\\t\\tspent += math.ceil(canHp * B.RepairCostPerHp)\\n\\t\\tfixed += 1\\n\\tend\\n\\tif fixed == 0 then return false, \\\"Dinheiro insuficiente para reparar\\\" end\\n\\tspent = math.min(spent, money)\\n\\tPlayerData.SpendMoney(player, spent)\\n\\treturn true, (\\\"Reparou %d estrutura(s)  -$%d\\\"):format(fixed, spent)\\nend\\n\\nfunction BuildService.Demolish(player)\\n\\tlocal root = aliveRoot(player)\\n\\tif not root then return false, \\\"Voc\u00ea est\u00e1 morto\\\" end\\n\\tlocal best, bestD\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal p = model.PrimaryPart\\n\\t\\tif p and model:GetAttribute(\\\"OwnerId\\\") == player.UserId then\\n\\t\\t\\tlocal d = (p.Position - root.Position).Magnitude\\n\\t\\t\\tif d <= B.DemolishRadius and (not bestD or d < bestD) then best, bestD = model, d end\\n\\t\\tend\\n\\tend\\n\\tif not best then return false, \\\"Nenhuma estrutura sua por perto\\\" end\\n\\tlocal refund = math.floor(structures[best].cfg.Cost * B.RefundPct)\\n\\tbest:Destroy()\\n\\tPlayerData.AddMoney(player, refund)\\n\\treturn true, (\\\"Demolido  +$%d\\\"):format(refund)\\nend\\n\\nfunction BuildService.RegenAll(fraction)\\n\\tfor model in pairs(structures) do\\n\\t\\tlocal max = model:GetAttribute(\\\"MaxHealth\\\")\\n\\t\\tmodel:SetAttribute(\\\"Health\\\", math.min(max, (model:GetAttribute(\\\"Health\\\") or 0) + max * fraction))\\n\\tend\\nend\\n\\nfunction BuildService.RemoveOwner(player)\\n\\tlocal userId = player.UserId\\n\\tfor _, m in ipairs(folder:GetChildren()) do\\n\\t\\tif m:GetAttribute(\\\"OwnerId\\\") == userId then m:Destroy() end\\n\\tend\\nend\\n\\nfunction BuildService.ClearAll()\\n\\tfor _, m in ipairs(folder:GetChildren()) do m:Destroy() end\\nend\\n\\nfunction BuildService.Init()\\n\\tRemotes.Build.OnServerInvoke = function(player, action, ...)\\n\\t\\tlocal now = os.clock()\\n\\t\\tif now - (lastAction[player] or 0) < 0.12 then return false, \\\"Calma!\\\" end\\n\\t\\tlastAction[player] = now\\n\\t\\tif not player:FindFirstChild(\\\"leaderstats\\\") then return false, \\\"Aguarde...\\\" end\\n\\n\\t\\tlocal ok, msg\\n\\t\\tif action == \\\"Place\\\" then\\n\\t\\t\\tlocal id, pos, rot = ...\\n\\t\\t\\tok, msg = BuildService.Place(player, id, pos, rot)\\n\\t\\telseif action == \\\"Repair\\\" then\\n\\t\\t\\tok, msg = BuildService.Repair(player)\\n\\t\\telseif action == \\\"Demolish\\\" then\\n\\t\\t\\tok, msg = BuildService.Demolish(player)\\n\\t\\telse\\n\\t\\t\\treturn false, \\\"Pedido inv\u00e1lido\\\"\\n\\t\\tend\\n\\t\\tif msg and (not ok or action ~= \\\"Place\\\") then notify(player, (ok and \\\"\u2714 \\\" or \\\"\u2716 \\\") .. msg) end\\n\\t\\treturn ok, msg\\n\\tend\\n\\tPlayers.PlayerRemoving:Connect(function(p) lastAction[p] = nil end)\\nend\\n\\n-- ===== comportamento das estruturas (loop) =====\\nlocal function explode(model, st)\\n\\tlocal cfg = st.cfg\\n\\tlocal pos = model.PrimaryPart.Position\\n\\tlocal owner = ownerOf(model)\\n\\n\\tlocal ex = Instance.new(\\\"Explosion\\\")\\n\\tex.Position = pos\\n\\tex.BlastRadius = cfg.Radius\\n\\tex.BlastPressure = 0\\n\\tex.DestroyJointRadiusPercent = 0\\n\\tex.ExplosionType = Enum.ExplosionType.NoCraters\\n\\tex.Parent = workspace\\n\\n\\tlocal dmg = cfg.Damage * dmgMult(owner)\\n\\tfor _, z in ipairs(ZombieService.ZombiesInRadius(pos, cfg.Radius)) do\\n\\t\\tZombieService.Damage(z, dmg, owner)\\n\\tend\\n\\tmodel:Destroy()\\nend\\n\\nfunction BuildService.Start()\\n\\ttask.spawn(function()\\n\\t\\twhile true do\\n\\t\\t\\ttask.wait(0.1)\\n\\t\\t\\tlocal now = os.clock()\\n\\n\\t\\t\\tlocal zombiesOnSpikes = {}\\n\\n\\t\\t\\tfor model, st in pairs(structures) do\\n\\t\\t\\t\\tlocal base = model.PrimaryPart\\n\\t\\t\\t\\tif not model.Parent or not base then\\n\\t\\t\\t\\t\\tstructures[model] = nil\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tlocal cfg = st.cfg\\n\\t\\t\\t\\t\\tlocal kind = cfg.Kind\\n\\n\\t\\t\\t\\t\\tif kind == \\\"Turret\\\" then\\n\\t\\t\\t\\t\\t\\tif now - st.last >= cfg.Cooldown then\\n\\t\\t\\t\\t\\t\\t\\tlocal origin = st.body.Posi