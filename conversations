(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal GameConfig = require(Modules:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal WeaponConfig = require(Modules:WaitForChild(\"Weapons\"):WaitForChild(\"WeaponConfig\"))\nlocal Remotes = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"Remotes\"))\nlocal CombatEffects = require(script.Parent:WaitForChild(\"Controllers\"):WaitForChild(\"CombatEffects\"))\n\nlocal LocalPlr = Players.LocalPlayer\nlocal PlayerGui = LocalPlr:WaitForChild(\"PlayerGui\")\n\nlocal fireRemote = Remotes.Get(\"Combat\", \"Fire\") :: RemoteEvent\nlocal reloadRemote = Remotes.Get(\"Combat\", \"Reload\") :: RemoteEvent\nlocal hitMarkerRemote = Remotes.Get(\"Combat\", \"HitMarker\") :: RemoteEvent\nlocal reloadStartedRemote = Remotes.Get(\"Combat\", \"ReloadStarted\") :: RemoteEvent\n\nCombatEffects.Init()\n\nlocal FIRE_ACTION, RELOAD_ACTION = \"WeaponFire\", \"WeaponReload\"\nlocal MAX_RECOIL = math.rad(12)\n\nlocal current: { Tool: Tool, Id: string, Def: any }? = nil\nlocal firing = false\nlocal fireToken = 0\nlocal lastFire = 0\nlocal lastReloadRequest = 0\nlocal recoil = 0\nlocal tracks: { [string]: AnimationTrack } = {}\n\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\n\tlocal inst = Instance.new(className)\n\tfor key, value in pairs(props) do\n\t\tinst[key] = value\n\tend\n\tinst.Parent = parent\n\treturn inst\nend\n\n-- ===== Mira =====\nlocal function usesCenterAim(): boolean\n\tlocal last = UserInputService:GetLastInputType()\n\tif last == Enum.UserInputType.Touch or last.Name:find(\"Gamepad\") then\n\t\treturn true\n\tend\n\treturn UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter\nend\n\nlocal function getScreenAimPosition(): Vector2\n\tlocal camera = workspace.CurrentCamera\n\tif usesCenterAim() then\n\t\treturn camera.ViewportSize / 2\n\tend\n\treturn UserInputService:GetMouseLocation()\nend\n\nlocal function getAimPoint(): Vector3\n\tlocal camera = workspace.CurrentCamera\n\tlocal pos = getScreenAimPosition()\n\tlocal ray = camera:ViewportPointToRay(pos.X, pos.Y)\n\n\tlocal ignore = {}\n\tif LocalPlr.Character then\n\t\ttable.insert(ignore, LocalPlr.Character)\n\tend\n\tlocal projectiles = workspace:FindFirstChild(GameConfig.Combat.ProjectilesFolder)\n\tif projectiles then\n\t\ttable.insert(ignore, projectiles)\n\tend\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tparams.FilterDescendantsInstances = ignore\n\n\tlocal result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)\n\treturn result and result.Position or (ray.Origin + ray.Direction * 1000)\nend\n\n-- ===== Interface: mira central e hit marker =====\nlocal gui = make(\"ScreenGui\", {\n\tName = \"Combat\",\n\tResetOnSpawn = false,\n\tIgnoreGuiInset = true,\n\tDisplayOrder = 3,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, PlayerGui)\n\nlocal crosshair = make(\"Frame\", {\n\tName = \"Crosshair\",\n\tAnchorPoint = Vector2.new(0.5, 0.5),\n\tPosition = UDim2.fromScale(0.5, 0.5),\n\tSize = UDim2.fromOffset(24, 24),\n\tBackgroundTransparency = 1,\n\tVisible = false,\n}, gui)\nfor _, def in ipairs({\n\t{ UDim2.new(0.5, -1, 0, 0), UDim2.fromOffset(2, 7) },\n\t{ UDim2.new(0.5, -1, 1, -7), UDim2.fromOffset(2, 7) },\n\t{ UDim2.new(0, 0, 0.5, -1), UDim2.fromOffset(7, 2) },\n\t{ UDim2.new(1, -7, 0.5, -1), UDim2.fromOffset(7, 2) },\n}) do\n\tmake(\"Frame\", { Position = def[1], Size = def[2], BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, crosshair)\nend\n\nlocal marker = make(\"Frame\", {\n\tName = \"HitMarker\",\n\tAnchorPoint = Vector2.new(0.5, 0.5),\n\tSize = UDim2.fromOffset(28, 28),\n\tBackgroundTransparency = 1,\n\tVisible = false,\n}, gui)\nlocal markerBars = {}\nfor _, rotation in ipairs({ 45, -45 }) do\n\ttable.insert(markerBars, make(\"Frame\", {\n\t\tAnchorPoint = Vector2.new(0.5, 0.5),\n\t\tPosition = UDim2.fromScale(0.5, 0.5),\n\t\tSize = UDim2.fromOffset(3, 24),\n\t\tRotation = rotation,\n\t\tBackgroundColor3 = Color3.new(1, 1, 1),\n\t\tBorderSizePixel = 0,\n\t}, marker))\nend\n\nlocal MARKER_COLORS = {\n\tHit = Color3.new(1, 1, 1),\n\tHeadshot = Color3.fromRGB(255, 200, 60),\n\tKill = Color3.fromRGB(235, 70, 70),\n}\nlocal markerToken = 0\n\nhitMarkerRemote.OnClientEvent:Connect(function(kind)\n\tlocal color = MARKER_COLORS[kind]\n\tif not color then\n\t\treturn\n\tend\n\tmarkerToken += 1\n\tlocal token = markerToken\n\tlocal screen = getScreenAimPosition()\n\tmarker.Position = UDim2.fromOffset(screen.X, screen.Y)\n\tmarker.Visible = true\n\tfor _, bar in ipairs(markerBars) do\n\t\tbar.BackgroundColor3 = color\n\t\tbar.BackgroundTransparency = 0\n\t\tTweenService:Create(bar, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()\n\tend\n\ttask.delay(0.3, function()\n\t\tif token == markerToken then\n\t\t\tmarker.Visible = false\n\t\tend\n\tend)\nend)\n\n-- ===== Recuo (cosm\u00e9tico) e mira =====\nRunService:BindToRenderStep(\"WeaponRecoil\", Enum.RenderPriority.Camera.Value + 1, function(dt)\n\tcrosshair.Visible = current ~= nil and usesCenterAim()\n\tif recoil > 0.0001 then\n\t\tlocal camera = workspace.CurrentCamera\n\t\tcamera.CFrame = camera.CFrame * CFrame.Angles(recoil, 0, 0)\n\t\trecoil = recoil * math.max(0, 1 - 8 * dt)\n\telse\n\t\trecoil = 0\n\tend\nend)\n\n-- ===== Anima\u00e7\u00f5es (somente se houver IDs na config) =====\nlocal function loadAnimations(def)\n\ttable.clear(tracks)\n\tlocal character = LocalPlr.Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tlocal animator = humanoid and humanoid:FindFirstChildOfClass(\"Animator\")\n\tif not animator then\n\t\treturn\n\tend\n\tfor name, id in pairs(def.Animations) do\n\t\tif id ~= \"\" then\n\t\t\tlocal animation = Instance.new(\"Animation\")\n\t\t\tanimation.AnimationId = id\n\t\t\tlocal ok, track = pcall(function()\n\t\t\t\treturn animator:LoadAnimation(animation)\n\t\t\tend)\n\t\t\tif ok and track then\n\t\t\t\ttrack.Priority = name == \"Idle\" and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Action\n\t\t\t\ttrack.Looped = name == \"Idle\"\n\t\t\t\ttracks[name] = track\n\t\t\tend\n\t\tend\n\tend\nend\n\nlocal function playAnimation(name: string)\n\tlocal track = tracks[name]\n\tif track then\n\t\ttrack:Play()\n\tend\nend\n\nlocal function stopAnimations()\n\tfor _, track in pairs(tracks) do\n\t\ttrack:Stop()\n\tend\n\ttable.clear(tracks)\nend\n\n-- ===== Disparo =====\nlocal function requestReload()\n\tlocal now = os.clock()\n\tif now - lastReloadRequest < 0.4 then\n\t\treturn\n\tend\n\tlastReloadRequest = now\n\treloadRemote:FireServer()\nend\n\nlocal function tryFire()\n\tlocal weapon = current\n\tif not weapon or weapon.Tool.Parent ~= LocalPlr.Character then\n\t\treturn\n\tend\n\tlocal def = weapon.Def\n\tlocal now = os.clock()\n\tif now - lastFire < 60 / def.FireRate then\n\t\treturn\n\tend\n\tif LocalPlr:GetAttribute(\"Reloading\") == true then\n\t\treturn\n\tend\n\n\tif def.Mode ~= \"Melee\" then\n\t\tlocal mag = LocalPlr:GetAttribute(\"AmmoInMagazine\")\n\t\tif type(mag) ~= \"number\" or mag <= 0 then\n\t\t\tlocal root = LocalPlr.Character and LocalPlr.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\t\tif root and now - lastFire > 0.3 then\n\t\t\t\tCombatEffects.PlaySound(def.Sounds.Empty, root.Position, 0.6)\n\t\t\tend\n\t\t\tlastFire = now\n\t\t\trequestReload()\n\t\t\treturn\n\t\tend\n\tend\n\n\tlastFire = now\n\tfireRemote:FireServer(getAimPoint()) -- somente o ponto de mira; o servidor decide o resto\n\trecoil = math.min(recoil + math.rad(def.Recoil), MAX_RECOIL)\n\tplayAnimation(\"Fire\")\nend\n\nlocal function startFiring()\n\tif firing or not current then\n\t\treturn\n\tend\n\tfiring = true\n\tfireToken += 1\n\tlocal token = fireToken\n\ttryFire()\n\tif current and current.Def.FireMode == \"Auto\" then\n\t\ttask.spawn(function()\n\t\t\twhile firing and fireToken == token and current do\n\t\t\t\ttryFire()\n\t\t\t\ttask.wait()\n\t\t\tend\n\t\tend)\n\tend\nend\n\nlocal function stopFiring()\n\tfiring = false\n\tfireToken += 1\nend\n\n-- ===== Equipar / desequipar =====\nlocal function onFireAction(_, state)\n\tif state == Enum.UserInputState.Begin then\n\t\tstartFiring()\n\telse\n\t\tstopFiring()\n\tend\n\treturn Enum.ContextActionResult.Sink\nend\n\nlocal function onReloadAction(_, state)\n\tif state == Enum.UserInputState.Begin then\n\t\trequestReload()\n\tend\n\treturn Enum.ContextActionResult.Sink\nend\n\nlocal function unequip()\n\tstopFiring()\n\tContextActionService:UnbindAction(FIRE_ACTION)\n\tContextActionService:UnbindAction(RELOAD_ACTION)\n\tstopAnimations()\n\tcurrent = nil\nend\n\nlocal function equip(tool: Tool)\n\tif current then\n\t\tunequip()\n\tend\n\tlocal id = tool:GetAttribute(\"WeaponId\")\n\tlocal def = id and WeaponConfig.Weapons[id]\n\tif not def then\n\t\treturn\n\tend\n\tcurrent = { Tool = tool, Id = id, Def = def }\n\n\t-- Bot\u00f5es de toque s\u00e3o criados automaticamente pelo ContextActionService\n\tContextActionService:BindAction(FIRE_ACTION, onFireAction, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)\n\tContextActionService:SetTitle(FIRE_ACTION, \"Fire\")\n\tContextActionService:SetPosition(FIRE_ACTION, UDim2.new(1, -100, 1, -190))\n\tif def.Mode ~= \"Melee\" then\n\t\tContextActionService:BindAction(RELOAD_ACTION, onReloadAction, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)\n\t\tContextActionService:SetTitle(RELOAD_ACTION, \"Reload\")\n\t\tContextActionService:SetPosition(RELOAD_ACTION, UDim2.new(1, -180, 1, -120))\n\tend\n\n\tloadAnimations(def)\n\tplayAnimation(\"Equip\")\n\tplayAnimation(\"Idle\")\nend\n\nreloadStartedRemote.OnClientEvent:Connect(function(id)\n\tlocal def = WeaponConfig.Weapons[id]\n\tlocal root = LocalPlr.Character and LocalPlr.Character:FindFirstChild(\"HumanoidRootPart\")\n\tif not def then\n\t\treturn\n\tend\n\tplayAnimation(\"Reload\")\n\tif root then\n\t\tCombatEffects.PlaySound(def.Sounds.Reload, root.Position, 0.7)\n\tend\nend)\n\nlocal function onCharacter(character: Model)\n\tunequip()\n\tcharacter.ChildAdded:Connect(function(child)\n\t\tif child:IsA(\"Tool\") and child:GetAttribute(\"WeaponId\") then\n\t\t\tequip(child)\n\t\tend\n\tend)\n\tcharacter.ChildRemoved:Connect(function(child)\n\t\tif current and current.Tool == child then\n\t\t\tunequip()\n\t\tend\n\tend)\n\tfor _, child in ipairs(character:GetChildren()) do\n\t\tif child:IsA(\"Tool\") and child:GetAttribute(\"WeaponId\") then\n\t\t\tequip(child)\n\t\tend\n\tend\nend\n\nLocalPlr.CharacterAdded:Connect(onCharacter)\nif LocalPlr.Character then\n\tonCharacter(LocalPlr.Character)\nend\nEOF\n\ncat > AmmoHUDController.client.lua <<'EOF'\n-- Ammo HUD: nome da arma equipada, muni\u00e7\u00e3o e indicador de recarga\nlocal Players = game:GetService(\"Players\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal WeaponConfig = require(Modules:WaitForChild(\"Weapons\"):WaitForChild(\"WeaponConfig\"))\n\nlocal LocalPlr = Players.LocalPlayer\nlocal PlayerGui = LocalPlr:WaitForChild(\"PlayerGui\")\n\nlocal BgColor = Color3.fromRGB(49, 51, 56)\nlocal WHITE = Color3.new(1, 1, 1)\nlocal LOW = Color3.fromRGB(255, 170, 60)\nlocal EMPTY = Color3.fromRGB(235, 70, 70)\nlocal BLUE = Color3.fromRGB(124, 181, 255)\nlocal FONT_BOLD = Font.fromEnum(Enum.Font.BuilderSansBold)\n\nlocal current: { Tool: Tool, Def: any }? = nil\nlocal reloadTween: Tween? = nil\n\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\n\tlocal inst = Instance.new(className)\n\tfor key, value in pairs(props) do\n\t\tinst[key] = value\n\tend\n\tinst.Parent = parent\n\treturn inst\nend\n\n-- ===== Interface =====\nlocal gui = make(\"ScreenGui\", {\n\tName = \"AmmoHUD\",\n\tResetOnSpawn = false,\n\tIgnoreGuiInset = true,\n\tDisplayOrder = 4,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, PlayerGui)\n\nlocal root = make(\"Frame\", {\n\tName = \"Root\",\n\tAnchorPoint = Vector2.new(0.5, 1),\n\tPosition = UDim2.new(0.5, 0, 1, -96),\n\tSize = UDim2.fromOffset(260, 100),\n\tBackgroundColor3 = BgColor,\n\tBackgroundTransparency = 0.08,\n\tBorderSizePixel = 0,\n\tVisible = false,\n}, gui)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 10) }, root)\nmake(\"UIStroke\", { Color = Color3.fromRGB(70, 72, 80), Thickness = 1 }, root)\nlocal scale = make(\"UIScale\", {}, root)\n\nlocal nameLabel = make(\"TextLabel\", {\n\tBackgroundTransparency = 1,\n\tPosition = UDim2.fromOffset(14, 8),\n\tSize = UDim2.new(1, -28, 0, 24),\n\tText = \"\",\n\tTextColor3 = WHITE,\n\tTextSize = 20,\n\tFontFace = FONT_BOLD,\n\tTextXAlignment = Enum.TextXAlignment.Left,\n\tTextTruncate = Enum.TextTruncate.AtEnd,\n}, root)\n\nlocal ammoLabel = make(\"TextLabel\", {\n\tBackgroundTransparency = 1,\n\tPosition = UDim2.fromOffset(14, 30),\n\tSize = UDim2.new(1, -28, 0, 38),\n\tText = \"--\",\n\tRichText = true,\n\tTextColor3 = WHITE,\n\tTextSize = 34,\n\tFontFace = FONT_BOLD,\n\tTextXAlignment = Enum.TextXAlignment.Left,\n}, root)\n\nlocal statusLabel = make(\"TextLabel\", {\n\tBackgroundTransparency = 1,\n\tPosition = UDim2.fromOffset(14, 66),\n\tSize = UDim2.new(1, -28, 0, 14),\n\tText = \"\",\n\tTextColor3 = BLUE,\n\tTextSize = 12,\n\tFontFace = FONT_BOLD,\n\tTextXAlignment = Enum.TextXAlignment.Left,\n}, root)\n\nlocal barBack = make(\"Frame\", {\n\tPosition = UDim2.fromOffset(14, 83),\n\tSize = UDim2.new(1, -28, 0, 8),\n\tBackgroundColor3 = Color3.fromRGB(30, 31, 34),\n\tBorderSizePixel = 0,\n\tClipsDescendants = true,\n\tVisible = false,\n}, root)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 4) }, barBack)\nlocal barFill = make(\"Frame\", {\n\tSize = UDim2.fromScale(0, 1),\n\tBackgroundColor3 = BLUE,\n\tBorderSizePixel = 0,\n}, barBack)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 4) }, barFill)\n\n-- Escala responsiva (PC, celular, console)\nlocal function updateScale()\n\tlocal camera = workspace.CurrentCamera\n\tif camera then\n\t\tscale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.7, 1.1)\n\tend\nend\nupdateScale()\nif workspace.CurrentCamera then\n\tworkspace.CurrentCamera:GetPropertyChangedSignal(\"ViewportSize\"):Connect(updateScale)\nend\n\n-- ===== Atualiza\u00e7\u00e3o =====\nlocal function refresh()\n\tlocal weapon = current\n\troot.Visible = weapon ~= nil\n\tif not weapon then\n\t\treturn\n\tend\n\n\tlocal def = weapon.Def\n\tnameLabel.Text = string.upper(def.DisplayName)\n\n\tif def.Mode == \"Melee\" then\n\t\tammoLabel.Text = \"MELEE\"\n\t\tammoLabel.TextColor3 = WHITE\n\t\tstatusLabel.Text = \"\"\n\t\treturn\n\tend\n\n\tlocal mag = LocalPlr:GetAttribute(\"AmmoInMagazine\")\n\tlocal reserve = LocalPlr:GetAttribute(\"AmmoReserve\")\n\tif type(mag) ~= \"number\" or type(reserve) ~= \"number\" then\n\t\tammoLabel.Text = \"--\"\n\t\tammoLabel.TextColor3 = WHITE\n\t\tstatusLabel.Text = \"\"\n\t\treturn\n\tend\n\n\tlocal color = WHITE\n\tif mag <= 0 then\n\t\tcolor = EMPTY\n\telseif mag <= math.max(1, math.floor(def.MagazineSize * 0.25)) then\n\t\tcolor = LOW\n\tend\n\tammoLabel.TextColor3 = color\n\tammoLabel.Text = ('%d <font size=\"22\" color=\"rgb(160,163,170)\">/ %d</font>'):format(mag, reserve)\n\n\tif LocalPlr:GetAttribute(\"Reloading\") == true then\n\t\tstatusLabel.Text = \"RELOADING\"\n\t\tstatusLabel.TextColor3 = BLUE\n\telseif mag <= 0 and reserve <= 0 then\n\t\tstatusLabel.Text = \"NO AMMO\"\n\t\tstatusLabel.TextColor3 = EMPTY\n\telse\n\t\tstatusLabel.Text = \"\"\n\tend\nend\n\nlocal function updateReloadBar()\n\tif reloadTween then\n\t\treloadTween:Cancel()\n\t\treloadTween = nil\n\tend\n\n\tlocal weapon = current\n\tlocal reloading = weapon ~= nil\n\t\tand weapon.Def.Mode ~= \"Melee\"\n\t\tand LocalPlr:GetAttribute(\"Reloading\") == true\n\n\tbarBack.Visible = reloading\n\tif reloading and weapon then\n\t\tbarFill.Size = UDim2.fromScale(0, 1)\n\t\treloadTween = TweenService:Create(\n\t\t\tbarFill,\n\t\t\tTweenInfo.new(math.max(0.1, weapon.Def.ReloadTime), Enum.EasingStyle.Linear),\n\t\t\t{ Size = UDim2.fromScale(1, 1) }\n\t\t)\n\t\treloadTween:Play()\n\tend\n\trefresh()\nend\n\nLocalPlr:GetAttributeChangedSignal(\"AmmoInMagazine\"):Connect(refresh)\nLocalPlr:GetAttributeChangedSignal(\"AmmoReserve\"):Connect(refresh)\nLocalPlr:GetAttributeChangedSignal(\"Reloading\"):Connect(updateReloadBar)\n\n-- ===== Detec\u00e7\u00e3o da arma equipada =====\nlocal function setCurrent(tool: Tool?)\n\tif tool then\n\t\tlocal id = tool:GetAttribute(\"WeaponId\")\n\t\tlocal def = id and WeaponConfig.Weapons[id]\n\t\tcurrent = def and { Tool = tool, Def = def } or nil\n\telse\n\t\tcurrent = nil\n\tend\n\tupdateReloadBar()\nend\n\nlocal function onCharacter(character: Model)\n\tsetCurrent(nil)\n\tcharacter.ChildAdded:Connect(function(child)\n\t\tif child:IsA(\"Tool\") and child:GetAttribute(\"WeaponId\") then\n\t\t\tsetCurrent(child)\n\t\tend\n\tend)\n\tcharacter.ChildRemoved:Connect(function(child)\n\t\tif current and current.Tool == child then\n\t\t\tsetCurrent(nil)\n\t\tend\n\tend)\n\tfor _, child in ipairs(character:GetChildren()) do\n\t\tif child:IsA(\"Tool\") and child:GetAttribute(\"WeaponId\") then\n\t\t\tsetCurrent(child)\n\t\tend\n\tend\nend\n\nLocalPlr.CharacterAdded:Connect(onCharacter)\nif LocalPlr.Character then\n\tonCharacter(LocalPlr.Character)\nend\nEOF\ncd /home/claude/InfectionSurvival && find src -type f | sort && echo && which luau luau-analyze selene stylua rojo 2>&1 | head", "description": "Escrever WeaponController e AmmoHUDController; listar arquivos e checar ferramentas dispon\u00edveis"}, "message": "Escrever WeaponController e AmmoHUDController; listar arquivos e checar ferramentas dispon\u00edveis", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/InfectionSurvival/src/StarterPlayer/StarterPlayerScripts\\ncat > WeaponController.client.lua <<'EOF'\\n-- Entrada do jogador para armas (PC, celular e console), mira, recuo, anima\\u00e7\\u00f5es e hit marker\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ContextActionService = game:GetService(\\\"ContextActionService\\\")\\nlocal UserInputService = game:GetService(\\\"UserInputService\\\")\\nlocal RunService = game:GetService(\\\"RunService\\\")\\nlocal TweenService = game:GetService(\\\"TweenService\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\n\\nlocal Modules = ReplicatedStorage:WaitForChild(\\\"Modules\\\")\\nlocal GameConfig = require(Modules:WaitForChild(\\\"Config\\\"):WaitForChild(\\\"GameConfig\\\"))\\nlocal WeaponConfig = require(Modules:WaitForChild(\\\"Weapons\\\"):WaitForChild(\\\"WeaponConfig\\\"))\\nlocal Remotes = require(Modules:WaitForChild(\\\"Shared\\\"):WaitForChild(\\\"Remotes\\\"))\\nlocal CombatEffects = require(script.Parent:WaitForChild(\\\"Controllers\\\"):WaitForChild(\\\"CombatEffects\\\"))\\n\\nlocal LocalPlr = Players.LocalPlayer\\nlocal PlayerGui = LocalPlr:WaitForChild(\\\"PlayerGui\\\")\\n\\nlocal fireRemote = Remotes.Get(\\\"Combat\\\", \\\"Fire\\\") :: RemoteEvent\\nlocal reloadRemote = Remotes.Get(\\\"Combat\\\", \\\"Reload\\\") :: RemoteEvent\\nlocal hitMarkerRemote = Remotes.Get(\\\"Combat\\\", \\\"HitMarker\\\") :: RemoteEvent\\nlocal reloadStartedRemote = Remotes.Get(\\\"Combat\\\", \\\"ReloadStarted\\\") :: RemoteEvent\\n\\nCombatEffects.Init()\\n\\nlocal FIRE_ACTION, RELOAD_ACTION = \\\"WeaponFire\\\", \\\"WeaponReload\\\"\\nlocal MAX_RECOIL = math.rad(12)\\n\\nlocal current: { Tool: Tool, Id: string, Def: any }? = nil\\nlocal firing = false\\nlocal fireToken = 0\\nlocal lastFire = 0\\nlocal lastReloadRequest = 0\\nlocal recoil = 0\\nlocal tracks: { [string]: AnimationTrack } = {}\\n\\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\\n\\tlocal inst = Instance.new(className)\\n\\tfor key, value in pairs(props) do\\n\\t\\tinst[key] = value\\n\\tend\\n\\tinst.Parent = parent\\n\\treturn inst\\nend\\n\\n-- ===== Mira =====\\nlocal function usesCenterAim(): boolean\\n\\tlocal last = UserInputService:GetLastInputType()\\n\\tif last == Enum.UserInputType.Touch or last.Name:find(\\\"Gamepad\\\") then\\n\\t\\treturn true\\n\\tend\\n\\treturn UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter\\nend\\n\\nlocal function getScreenAimPosition(): Vector2\\n\\tlocal camera = workspace.CurrentCamera\\n\\tif usesCenterAim() then\\n\\t\\treturn camera.ViewportSize / 2\\n\\tend\\n\\treturn UserInputService:GetMouseLocation()\\nend\\n\\nlocal function getAimPoint(): Vector3\\n\\tlocal camera = workspace.CurrentCamera\\n\\tlocal pos = getScreenAimPosition()\\n\\tlocal ray = camera:ViewportPointToRay(pos.X, pos.Y)\\n\\n\\tlocal ignore = {}\\n\\tif LocalPlr.Character then\\n\\t\\ttable.insert(ignore, LocalPlr.Character)\\n\\tend\\n\\tlocal projectiles = workspace:FindFirstChild(GameConfig.Combat.ProjectilesFolder)\\n\\tif projectiles then\\n\\t\\ttable.insert(ignore, projectiles)\\n\\tend\\n\\tlocal params = RaycastParams.new()\\n\\tparams.FilterType = Enum.RaycastFilterType.Exclude\\n\\tparams.FilterDescendantsInstances = ignore\\n\\n\\tlocal result = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)\\n\\treturn result and result.Position or (ray.Origin + ray.Direction * 1000)\\nend\\n\\n-- ===== Interface: mira central e hit marker =====\\nlocal gui = make(\\\"ScreenGui\\\", {\\n\\tName = \\\"Combat\\\",\\n\\tResetOnSpawn = false,\\n\\tIgnoreGuiInset = true,\\n\\tDisplayOrder = 3,\\n\\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\\n}, PlayerGui)\\n\\nlocal crosshair = make(\\\"Frame\\\", {\\n\\tName = \\\"Crosshair\\\",\\n\\tAnchorPoint = Vector2.new(0.5, 0.5),\\n\\tPosition = UDim2.fromScale(0.5, 0.5),\\n\\tSize = UDim2.fromOffset(24, 24),\\n\\tBackgroundTransparency = 1,\\n\\tVisible = false,\\n}, gui)\\nfor _, def in ipairs({\\n\\t{ UDim2.new(0.5, -1, 0, 0), UDim2.fromOffset(2, 7) },\\n\\t{ UDim2.new(0.5, -1, 1, -7), UDim2.fromOffset(2, 7) },\\n\\t{ UDim2.new(0, 0, 0.5, -1), UDim2.fromOffset(7, 2) },\\n\\t{ UDim2.new(1, -7, 0.5, -1), UDim2.fromOffset(7, 2) },\\n}) do\\n\\tmake(\\\"Frame\\\", { Position = def[1], Size = def[2], BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, crosshair)\\nend\\n\\nlocal marker = make(\\\"Frame\\\", {\\n\\tName = \\\"HitMarker\\\",\\n\\tAnchorPoint = Vector2.new(0.5, 0.5),\\n\\tSize = UDim2.fromOffset(28, 28),\\n\\tBackgroundTransparency = 1,\\n\\tVisible = false,\\n}, gui)\\nlocal markerBars = {}\\nfor _, rotation in ipairs({ 45, -45 }) do\\n\\ttable.insert(markerBars, make(\\\"Frame\\\", {\\n\\t\\tAnchorPoint = Vector2.new(0.5, 0.5),\\n\\t\\tPosition = UDim2.fromScale(0.5, 0.5),\\n\\t\\tSize = UDim2.fromOffset(3, 24),\\n\\t\\tRotation = rotation,\\n\\t\\tBackgroundColor3 = Color3.new(1, 1, 1),\\n\\t\\tBorderSizePixel = 0,\\n\\t}, marker))\\nend\\n\\nlocal MARKER_COLORS = {\\n\\tHit = Color3.new(1, 1, 1),\\n\\tHeadshot = Color3.fromRGB(255, 200, 60),\\n\\tKill = Color3.fromRGB(235, 70, 70),\\n}\\nlocal markerToken = 0\\n\\nhitMarkerRemote.OnClientEvent:Connect(function(kind)\\n\\tlocal color = MARKER_COLORS[kind]\\n\\tif not color then\\n\\t\\treturn\\n\\tend\\n\\tmarkerToken += 1\\n\\tlocal token = markerToken\\n\\tlocal screen = getScreenAimPosition()\\n\\tmarker.Position = UDim2.fromOffset(screen.X, screen.Y)\\n\\tmarker.Visible = true\\n\\tfor _, bar in ipairs(markerBars) do\\n\\t\\tbar.BackgroundColor3 = color\\n\\t\\tbar.BackgroundTransparency = 0\\n\\t\\tTweenService:Create(bar, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()\\n\\tend\\n\\ttask.delay(0.3, function()\\n\\t\\tif token == markerToken then\\n\\t\\t\\tmarker.Visible = false\\n\\t\\tend\\n\\tend)\\nend)\\n\\n-- ===== Recuo (cosm\\u00e9tico) e mira =====\\nRunService:BindToRenderSt