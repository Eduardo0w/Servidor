er no tab do player eu quero que esses tipos de nomes sempre sejam em ingles e nao em portugues", "content": [{"start_timestamp": "2026-11-03T00:19:13.906596Z", "stop_timestamp": "2026-11-03T00:19:13.906596Z", "flags": null, "type": "text", "text": "mude o tab escrito Jogadores para Players mude Creditos para Credits mude estado para Status mude muni\u00e7\u00e3o para Ammo mude abates para Kills e bote escrito \"Kills\" junto com as kills do player no tab do player eu quero que esses tipos de nomes sempre sejam em ingles e nao em portugues", "citations": []}], "sender": "human", "created_at": "2026-11-03T00:19:13.906836Z", "updated_at": "2026-11-03T00:19:13.906836Z", "attachments": [], "files": [], "parent_message_uuid": "01a19ec1-8a06-76e5-8cdf-4c3ef1edbb48"}, {"uuid": "01a19ec6-38f9-7d9a-ba19-3029e59248c3", "text": "\n```\nThis block is not supported on your current device yet.\n```\n\n\n```\nThis block is not supported on your current device yet.\n```\n\nAlterei apenas os dois LocalScripts, e daqui em diante todo texto de interface do jogo sai em ingl\u00eas. Substitua os dois arquivos inteiros.\n\nAl\u00e9m dos nomes que voc\u00ea pediu, traduzi os outros textos da UI: Level, Team, MAX LEVEL, estados do jogador, aviso de level up, \"NO TEAM\" e os bot\u00f5es do menu (Add Friend, Unfriend, Block, Unblock). Na leaderboard, cada linha agora mostra `Kills` junto do n\u00famero.\n\n### `StarterPlayer/StarterPlayerScripts/HUDController` (LocalScript)\n\n```lua\n-- HUD do jogador: avatar, vida, XP, kills, credits, muni\u00e7\u00e3o, equipe e estado\nlocal Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal GameConfig = require(Modules:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal Remotes = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"Remotes\"))\nlocal AvatarCache = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"AvatarCache\"))\nlocal DataController = require(script.Parent:WaitForChild(\"Controllers\"):WaitForChild(\"DataController\"))\n\nlocal LocalPlr = Players.LocalPlayer\nlocal PlayerGui = LocalPlr:WaitForChild(\"PlayerGui\")\n\nlocal BgColor = Color3.fromRGB(49, 51, 56)\nlocal TEXT = Color3.fromRGB(213, 215, 221)\nlocal WHITE = Color3.new(1, 1, 1)\nlocal XP_COLOR = Color3.fromRGB(124, 181, 255)\nlocal HP_GOOD = Color3.fromRGB(96, 200, 120)\nlocal HP_LOW = Color3.fromRGB(230, 90, 80)\nlocal FONT = Font.fromEnum(Enum.Font.BuilderSans)\nlocal FONT_BOLD = Font.fromEnum(Enum.Font.BuilderSansBold)\n\n-- Estados (atributo \"PlayerState\" definido pelo servidor em fases futuras)\nlocal STATE_NAMES = {\n\tNormal = \"Normal\",\n\tInjured = \"Injured\",\n\tGrabbed = \"Grabbed\",\n\tInfected = \"Infected\",\n\tPoisoned = \"Poisoned\",\n\tInCombat = \"In Combat\",\n}\n\n-- Desativa a barra de vida padr\u00e3o\npcall(function()\n\tStarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)\nend)\n\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\n\tlocal inst = Instance.new(className)\n\tfor key, value in pairs(props) do\n\t\tinst[key] = value\n\tend\n\tinst.Parent = parent\n\treturn inst\nend\n\nlocal function label(parent: Instance, props: { [string]: any }): TextLabel\n\tlocal base = {\n\t\tBackgroundTransparency = 1,\n\t\tTextColor3 = TEXT,\n\t\tTextSize = 14,\n\t\tFontFace = FONT,\n\t\tTextXAlignment = Enum.TextXAlignment.Left,\n\t}\n\tfor key, value in pairs(props) do\n\t\tbase[key] = value\n\tend\n\treturn make(\"TextLabel\", base, parent)\nend\n\nlocal function formatNumber(n: number): string\n\tlocal reversed = tostring(math.floor(n)):reverse()\n\tlocal withCommas = reversed:gsub(\"(%d%d%d)\", \"%1,\")\n\tlocal result = withCommas:reverse()\n\treturn (result:gsub(\"^,\", \"\"))\nend\n\nlocal function bar(parent: Instance, position: UDim2, height: number, color: Color3)\n\tlocal back = make(\"Frame\", {\n\t\tPosition = position,\n\t\tSize = UDim2.new(1, -24, 0, height),\n\t\tBackgroundColor3 = Color3.fromRGB(30, 31, 34),\n\t\tBorderSizePixel = 0,\n\t\tClipsDescendants = true,\n\t}, parent)\n\tmake(\"UICorner\", { CornerRadius = UDim.new(0, 6) }, back)\n\tlocal fill = make(\"Frame\", {\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tBackgroundColor3 = color,\n\t\tBorderSizePixel = 0,\n\t}, back)\n\tmake(\"UICorner\", { CornerRadius = UDim.new(0, 6) }, fill)\n\tlocal text = label(back, {\n\t\tSize = UDim2.fromScale(1, 1),\n\t\tTextXAlignment = Enum.TextXAlignment.Center,\n\t\tTextColor3 = WHITE,\n\t\tTextSize = 12,\n\t\tFontFace = FONT_BOLD,\n\t\tZIndex = 3,\n\t})\n\treturn fill, text\nend\n\n-- ===== Constru\u00e7\u00e3o da interface =====\nlocal gui = make(\"ScreenGui\", {\n\tName = \"HUD\",\n\tResetOnSpawn = false,\n\tIgnoreGuiInset = true,\n\tDisplayOrder = 4,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, PlayerGui)\n\nlocal root = make(\"Frame\", {\n\tName = \"Root\",\n\tAnchorPoint = Vector2.new(0, 1),\n\tPosition = UDim2.new(0, 16, 1, -16),\n\tSize = UDim2.fromOffset(340, 176),\n\tBackgroundColor3 = BgColor,\n\tBackgroundTransparency = 0.08,\n\tBorderSizePixel = 0,\n}, gui)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 10) }, root)\nmake(\"UIStroke\", { Color = Color3.fromRGB(70, 72, 80), Thickness = 1 }, root)\nlocal scale = make(\"UIScale\", {}, root)\n\nlocal avatar = make(\"ImageLabel\", {\n\tName = \"Avatar\",\n\tPosition = UDim2.fromOffset(12, 12),\n\tSize = UDim2.fromOffset(64, 64),\n\tBackgroundColor3 = Color3.fromRGB(30, 31, 34),\n\tBorderSizePixel = 0,\n}, root)\nmake(\"UICorner\", { CornerRadius = UDim.new(1, 0) }, avatar)\n\nlocal nameLabel = label(root, {\n\tPosition = UDim2.fromOffset(88, 12),\n\tSize = UDim2.new(1, -100, 0, 22),\n\tText = LocalPlr.DisplayName,\n\tTextSize = 18,\n\tTextColor3 = WHITE,\n\tFontFace = FONT_BOLD,\n\tTextTruncate = Enum.TextTruncate.AtEnd,\n})\nlocal teamLabel = label(root, { Position = UDim2.fromOffset(88, 34), Size = UDim2.new(1, -100, 0, 18), Text = \"\" })\nlocal levelLabel = label(root, { Position = UDim2.fromOffset(88, 54), Size = UDim2.new(1, -100, 0, 20), Text = \"Level 1\", FontFace = FONT_BOLD })\n\nlocal healthFill, healthText = bar(root, UDim2.fromOffset(12, 86), 18, HP_GOOD)\nlocal xpFill, xpText = bar(root, UDim2.fromOffset(12, 110), 16, XP_COLOR)\n\nlocal killsLabel = label(root, { Position = UDim2.fromOffset(12, 134), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Kills: 0\" })\nlocal creditsLabel = label(root, { Position = UDim2.new(0.5, 0, 0, 134), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Credits: 0\" })\nlocal ammoLabel = label(root, { Position = UDim2.fromOffset(12, 154), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Ammo: --\" })\nlocal stateLabel = label(root, { Position = UDim2.new(0.5, 0, 0, 154), Size = UDim2.new(0.5, -12, 0, 18), Text = \"Status: Normal\" })\n\nlocal toast = make(\"TextLabel\", {\n\tName = \"Toast\",\n\tAnchorPoint = Vector2.new(0.5, 0),\n\tPosition = UDim2.new(0.5, 0, 0, 90),\n\tSize = UDim2.fromOffset(280, 40),\n\tBackgroundColor3 = BgColor,\n\tBackgroundTransparency = 1,\n\tTextTransparency = 1,\n\tTextColor3 = XP_COLOR,\n\tTextSize = 20,\n\tFontFace = FONT_BOLD,\n\tText = \"\",\n}, gui)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 8) }, toast)\n\n-- ===== Escala responsiva (PC, celular, console) =====\nlocal function updateScale()\n\tlocal camera = workspace.CurrentCamera\n\tif camera then\n\t\tscale.Scale = math.clamp(camera.ViewportSize.Y / 900, 0.65, 1.1)\n\tend\nend\nupdateScale()\nif workspace.CurrentCamera then\n\tworkspace.CurrentCamera:GetPropertyChangedSignal(\"ViewportSize\"):Connect(updateScale)\nend\n\n-- ===== Avatar =====\nAvatarCache.Get(LocalPlr.UserId, function(image)\n\tavatar.Image = image\nend)\n\n-- ===== Equipe =====\nlocal function refreshTeam()\n\tlocal team = LocalPlr.Team\n\tteamLabel.Text = team and (\"Team: \" .. team.Name) or \"No team\"\n\tteamLabel.TextColor3 = team and team.TeamColor.Color or TEXT\nend\nLocalPlr:GetPropertyChangedSignal(\"Team\"):Connect(refreshTeam)\nrefreshTeam()\n\n-- ===== Dados (level, XP, kills, credits) =====\nlocal function tweenFill(frame: Frame, ratio: number)\n\tTweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {\n\t\tSize = UDim2.fromScale(math.clamp(ratio, 0, 1), 1),\n\t}):Play()\nend\n\nlocal function refreshData()\n\tlocal level = DataController.Get(\"Level\") or 1\n\tlocal xp = DataController.Get(\"XP\") or 0\n\tlocal required = math.max(1, DataController.Get(\"XPRequired\") or 1)\n\tlocal maxed = level >= GameConfig.Progression.MaxLevel\n\n\tlevelLabel.Text = (\"Level %d\"):format(level)\n\tif maxed then\n\t\txpText.Text = \"MAX LEVEL\"\n\t\ttweenFill(xpFill, 1)\n\telse\n\t\txpText.Text = (\"XP %s / %s\"):format(formatNumber(xp), formatNumber(required))\n\t\ttweenFill(xpFill, xp / required)\n\tend\n\tkillsLabel.Text = \"Kills: \" .. formatNumber(DataController.Get(\"Kills\") or 0)\n\tcreditsLabel.Text = \"Credits: \" .. formatNumber(DataController.Get(\"Credits\") or 0)\nend\n\nDataController.Loaded:Connect(refreshData)\nDataController.Changed:Connect(refreshData)\nif DataController.IsLoaded() then\n\trefreshData()\nend\n\n-- ===== Vida e estado =====\nlocal characterConns: { RBXScriptConnection } = {}\n\nlocal function refreshState(humanoid: Humanoid?)\n\tlocal attr = LocalPlr:GetAttribute(\"PlayerState\")\n\tlocal key = type(attr) == \"string\" and attr or nil\n\tif not key and humanoid and humanoid.MaxHealth > 0 and humanoid.Health / humanoid.MaxHealth <= 0.35 and humanoid.Health > 0 then\n\t\tkey = \"Injured\"\n\tend\n\tstateLabel.Text = \"Status: \" .. (STATE_NAMES[key or \"Normal\"] or \"Normal\")\nend\n\nlocal function bindCharacter(character: Model)\n\tfor _, conn in ipairs(characterConns) do\n\t\tconn:Disconnect()\n\tend\n\ttable.clear(characterConns)\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10) :: Humanoid?\n\tif not humanoid then\n\t\treturn\n\tend\n\n\tlocal function update()\n\t\tlocal max = math.max(1, humanoid.MaxHealth)\n\t\tlocal ratio = humanoid.Health / max\n\t\thealthText.Text = (\"%d / %d\"):format(math.ceil(humanoid.Health), math.ceil(max))\n\t\thealthFill.BackgroundColor3 = ratio <= 0.35 and HP_LOW or HP_GOOD\n\t\ttweenFill(healthFill, ratio)\n\t\trefreshState(humanoid)\n\tend\n\n\ttable.insert(characterConns, humanoid.HealthChanged:Connect(update))\n\ttable.insert(characterConns, humanoid:GetPropertyChangedSignal(\"MaxHealth\"):Connect(update))\n\ttable.insert(characterConns, LocalPlr:GetAttributeChangedSignal(\"PlayerState\"):Connect(function()\n\t\trefreshState(humanoid)\n\tend))\n\tupdate()\nend\n\nLocalPlr.CharacterAdded:Connect(bindCharacter)\nif LocalPlr.Character then\n\ttask.spawn(bindCharacter, LocalPlr.Character)\nend\n\n-- ===== Muni\u00e7\u00e3o (atributos preenchidos pelo sistema de armas na Fase 3) =====\nlocal function refreshAmmo()\n\tlocal mag = LocalPlr:GetAttribute(\"AmmoInMagazine\")\n\tlocal reserve = LocalPlr:GetAttribute(\"AmmoReserve\")\n\tif type(mag) == \"number\" and type(reserve) == \"number\" then\n\t\tammoLabel.Text = (\"Ammo: %d / %d\"):format(mag, reserve)\n\telse\n\t\tammoLabel.Text = \"Ammo: --\"\n\tend\nend\nLocalPlr:GetAttributeChangedSignal(\"AmmoInMagazine\"):Connect(refreshAmmo)\nLocalPlr:GetAttributeChangedSignal(\"AmmoReserve\"):Connect(refreshAmmo)\nrefreshAmmo()\n\n-- ===== Notifica\u00e7\u00e3o de level up =====\nlocal toastToken = 0\nRemotes.Get(\"PlayerData\", \"LevelUp\").OnClientEvent:Connect(function(level)\n\tif type(level) ~= \"number\" then\n\t\treturn\n\tend\n\ttoastToken += 1\n\tlocal token = toastToken\n\ttoast.Text = (\"You reached level %d!\"):format(level)\n\tTweenService:Create(toast, TweenInfo.new(0.2), { TextTransparency = 0, BackgroundTransparency = 0.1 }):Play()\n\ttask.delay(2.5, function()\n\t\tif token == toastToken then\n\t\t\tTweenService:Create(toast, TweenInfo.new(0.4), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()\n\t\tend\n\tend)\nend)\n```\n\n### `StarterPlayer/StarterPlayerScripts/LeaderboardController` (LocalScript)\n\n```lua\n-- Leaderboard pr\u00f3pria (independente da PlayerList do Roblox), inspirada no PlayerListReskin\nlocal Players = game:GetService(\"Players\")\nlocal StarterGui = game:GetService(\"StarterGui\")\nlocal GuiService = game:GetService(\"GuiService\")\nlocal UserInputService = game:GetService(\"UserInputService\")\nlocal Teams = game:GetService(\"Teams\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Modules = ReplicatedStorage:WaitForChild(\"Modules\")\nlocal GameConfig = require(Modules:WaitForChild(\"Config\"):WaitForChild(\"GameConfig\"))\nlocal AvatarCache = require(Modules:WaitForChild(\"Shared\"):WaitForChild(\"AvatarCache\"))\n\n-- ===== Configura\u00e7\u00f5es visuais obrigat\u00f3rias =====\nlocal BgColor = Color3.fromRGB(49, 51, 56)\n\nlocal SELF_COLOR = Color3.fromRGB(124, 181, 255)\n\nlocal FRIEND_COLOR = Color3.fromRGB(255, 233, 108)\n\nlocal SELF_FONT = Font.new(\n\t\"rbxassetid://12187366846\",\n\tEnum.FontWeight.Medium,\n\tEnum.FontStyle.Normal\n)\n\nlocal DEFAULT_TEXT = Color3.fromRGB(213, 215, 221) -- cor padr\u00e3o do original\nlocal WHITE = Color3.new(1, 1, 1)\nlocal MUTED = Color3.fromRGB(160, 163, 170)\nlocal DEFAULT_FONT = Font.fromEnum(Enum.Font.BuilderSans)\nlocal BOLD_FONT = Font.fromEnum(Enum.Font.BuilderSansBold)\n\nlocal WIDTH, HEADER_H, ROW_H, TEAM_H = 260, 32, 36, 24\nlocal FRIEND_TTL, FRIEND_FAIL_TTL = 120, 20\n\nlocal LocalPlr = Players.LocalPlayer\nlocal PlayerGui = LocalPlr:WaitForChild(\"PlayerGui\")\n\n-- Esconde a PlayerList padr\u00e3o (API oficial; sem tocar no CoreGui)\ntask.spawn(function()\n\tfor _ = 1, 10 do\n\t\tif pcall(function()\n\t\t\tStarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)\n\t\tend) then\n\t\t\tbreak\n\t\tend\n\t\ttask.wait(0.5)\n\tend\nend)\n\nlocal function make(className: string, props: { [string]: any }, parent: Instance?): any\n\tlocal inst = Instance.new(className)\n\tfor key, value in pairs(props) do\n\t\tinst[key] = value\n\tend\n\tinst.Parent = parent\n\treturn inst\nend\n\n-- ===== Amizade com cache e tratamento de falhas =====\nlocal friendCache: { [number]: { value: boolean, time: number, ttl: number } } = {}\nlocal friendPending: { [number]: { (boolean) -> () } } = {}\n\nlocal function requestFriend(userId: number, callback: (boolean) -> ())\n\tif userId == LocalPlr.UserId then\n\t\tcallback(false)\n\t\treturn\n\tend\n\tlocal entry = friendCache[userId]\n\tif entry and os.clock() - entry.time < entry.ttl then\n\t\tcallback(entry.value)\n\t\treturn\n\tend\n\tif friendPending[userId] then\n\t\ttable.insert(friendPending[userId], callback)\n\t\treturn\n\tend\n\tfriendPending[userId] = { callback }\n\ttask.spawn(function()\n\t\tlocal ok, result = pcall(function()\n\t\t\treturn LocalPlr:IsFriendsWithAsync(userId)\n\t\tend)\n\t\tfriendCache[userId] = {\n\t\t\tvalue = ok and result == true,\n\t\t\ttime = os.clock(),\n\t\t\tttl = ok and FRIEND_TTL or FRIEND_FAIL_TTL,\n\t\t}\n\t\tlocal callbacks = friendPending[userId]\n\t\tfriendPending[userId] = nil\n\t\tfor _, cb in ipairs(callbacks) do\n\t\t\tcb(friendCache[userId].value)\n\t\tend\n\tend)\nend\n\nlocal function isBlocked(userId: number): boolean\n\tlocal ok, list = pcall(function()\n\t\treturn StarterGui:GetCore(\"GetBlockedUserIds\")\n\tend)\n\tif ok and type(list) == \"table\" then\n\t\treturn table.find(list, userId) ~= nil\n\tend\n\treturn false\nend\n\n-- ===== Interface =====\nlocal gui = make(\"ScreenGui\", {\n\tName = \"Leaderboard\",\n\tResetOnSpawn = false,\n\tIgnoreGuiInset = true,\n\tDisplayOrder = 5,\n\tZIndexBehavior = Enum.ZIndexBehavior.Sibling,\n}, PlayerGui)\n\nlocal container = make(\"Frame\", {\n\tName = \"Container\",\n\tAnchorPoint = Vector2.new(1, 0),\n\tPosition = UDim2.new(1, -14, 0, GuiService:GetGuiInset().Y + 8),\n\tSize = UDim2.fromOffset(WIDTH, HEADER_H),\n\tBackgroundTransparency = 1,\n}, gui)\n\nlocal shadow = make(\"Frame\", {\n\tName = \"Shadow\",\n\tAnchorPoint = Vector2.new(0.5, 0.5),\n\tPosition = UDim2.new(0.5, 0, 0.5, 4),\n\tSize = UDim2.new(1, 12, 1, 12),\n\tBackgroundColor3 = Color3.new(0, 0, 0),\n\tBackgroundTransparency = 0.6,\n\tBorderSizePixel = 0,\n\tZIndex = 0,\n}, container)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 14) }, shadow)\n\nlocal panel = make(\"Frame\", {\n\tName = \"Panel\",\n\tSize = UDim2.fromScale(1, 1),\n\tBackgroundColor3 = BgColor,\n\tBorderSizePixel = 0,\n\tClipsDescendants = true,\n}, container)\nmake(\"UICorner\", { CornerRadius = UDim.new(0, 8) }, panel)\nmake(\"UIStroke\", { Color = Color3.fromRGB(70, 72, 80), Thickness = 1 }, panel)\n\nlocal header = make(\"Frame\", { Name = \"Header\", Size = UDim2.new(1, 0, 0, HEADER_H), BackgroundTransparency = 1 }, panel)\nlocal title = make(\"TextLabel\", {\n\tBackgroundTransparency = 1,\n\tPosition = UDim2.fromOffset(12, 0),\n\tSize = UDim2.new(1, -52, 1, 0),\n\tText = \"Players\",\n\tTextColor3 = WHITE,\n\tTextSize = 15,\n\tFontFace = BOLD_FONT,\n\tTextXAlignment = Enum.TextXAlignment.Left,\n}, header)\nlocal toggleButton = make(\"TextButton\", {\n\tAnchorPoint = Vector2.new(1, 0.5),\n\tPosition = UDim2.new(1, -6, 0.5, 0),\n\tSize = UDim2.fromOffset(28, 24),\n\tBackgroundTransparency = 1,\n\tText = \"\u2013\",\n\tTextColor3 = DEFAULT_TEXT,\n\tTextSize = 18,\n\tFontFace = BOLD_FONT,\n}, header)\n\nlocal body = make(\"ScrollingFrame\", {\n\tName = \"ScrollingFrame\",\n\tPosition = UDim2.fromOffset(0, HEADER_H),\n\tSize = UDim2.new(1, 0, 1, -HEADER_H),\n\tBackgroundTransparency = 1,\n\tBorderSizePixel = 0,\n\tScrollBarThickness = 4,\n\tCanvasSize = UDim2.new(),\n\tAutomaticCanvasSize = Enum.AutomaticSize.Y,\n}, panel)\nmake(\"UIPadding\", {\n\tPaddingTop = UDim.new(0, 2),\n\tPaddingBottom = UDim.new(0, 6),\n\tPaddingLeft = UDim.new(0, 4),\n\tPaddingRight = UDim.new(0, 4),\n}, body)\nlocal list = make(\"UIListLayout\", { SortOrder = Enum.SortOrder