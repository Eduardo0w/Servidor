d\n\nlocal function onDied(data)\n    if data.dead then return end\n    data.dead = true\n    active[data.model] = nil\n\n    local cfg = data.cfg\n    local money = math.floor(cfg.Money * (data.isBoss and 1 or Config.ZombieMoneyMult(data.wave)))\n\n    local killer = data.lastHitBy\n    if killer and killer.Parent then PlayerData.AddKill(killer) end\n\n    if data.isBoss then\n        -- Boss: todos os jogadores recebem a recompensa\n        for _, plr in ipairs(Players:GetPlayers()) do\n            PlayerData.AddMoney(plr, money)\n            PlayerData.AddXP(plr, cfg.XP)\n        end\n        setBoss(\"\", 0, 0)\n    elseif killer and killer.Parent then\n        PlayerData.AddMoney(killer, money)\n        PlayerData.AddXP(killer, cfg.XP)\n    end\n\n    for _, part in ipairs(data.model:GetDescendants()) do\n        if part:IsA(\"BasePart\") then part.CanCollide = false end\n    end\n    Debris:AddItem(data.model, 5)\nend\n\nfunction ZombieService.SpawnZombie(typeId, spawnCFrame, wave)\n    wave = wave or 1\n    local isBoss = Config.Bosses[typeId] ~= nil\n    local cfg = Config.Bosses[typeId] or Config.Zombies[typeId]\n    if not cfg then\n        warn(\"[ZombieService] Unknown zombie type: \" .. tostring(typeId))\n        return nil\n    end\n    if not template then return nil end\n\n    local model = template:Clone()\n    local hum = model:FindFirstChildOfClass(\"Humanoid\")\n    local root = model:FindFirstChild(\"HumanoidRootPart\")\n    if not hum or not root then\n        model:Destroy()\n        warn(\"[ZombieService] Zombie model needs a Humanoid and a HumanoidRootPart.\")\n        return nil\n    end\n\n    if not templateIsCustom then paint(model, cfg.Color) end\n    model.Name = cfg.Name\n    if cfg.Scale ~= 1 then model:ScaleTo(cfg.Scale) end\n\n    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None\n    hum.MaxHealth = math.floor(cfg.Health * (isBoss and 1 or Config.ZombieHealthMult(wave)))\n    hum.Health = hum.MaxHealth\n    hum.WalkSpeed = cfg.Speed\n    model:SetAttribute(\"BaseSpeed\", cfg.Speed)\n\n    -- Um pouco acima do ch\u00e3o para n\u00e3o prender nem atravessar\n    model:PivotTo((spawnCFrame or CFrame.new(0, 10, 0)) + Vector3.new(0, 3 + (cfg.Scale - 1) * 3, 0))\n    model.Parent = zombiesFolder\n    pcall(function() root:SetNetworkOwner(nil) end)\n\n    local data = {\n        model = model, hum = hum, root = root, cfg = cfg, wave = wave, isBoss = isBoss,\n        dmgMult = isBoss and 1 or Config.ZombieDamageMult(wave),\n        lastAttack = 0,\n        nextSlam = os.clock() + (cfg.SlamCooldown or 0),\n    }\n    active[model] = data\n\n    hum.Died:Connect(function() onDied(data) end)\n    model.Destroying:Connect(function()\n        active[model] = nil\n        if isBoss then setBoss(\"\", 0, 0) end\n    end)\n    return model\nend\n\n-- Retorna o modelo do zumbi a partir de qualquer parte dele\nfunction ZombieService.FromInstance(inst)\n    local cur = inst\n    while cur and cur.Parent ~= zombiesFolder do\n        cur = cur.Parent\n    end\n    if cur and active[cur] and not active[cur].dead then return cur end\n    return nil\nend\n\nfunction ZombieService.IsZombie(model)\n    local data = active[model]\n    return data ~= nil and not data.dead\nend\n\nfunction ZombieService.Damage(model, amount, owner)\n    local data = active[model]\n    if not data or data.dead then return end\n    if type(amount) ~= \"number\" or amount ~= amount or amount <= 0 then return end\n    if owner then data.lastHitBy = owner end\n    data.hum:TakeDamage(amount)\nend\n\nfunction ZombieService.ZombiesInRadius(pos, radius)\n    local list = {}\n    for model, data in pairs(active) do\n        if not data.dead and data.root.Parent and (data.root.Position - pos).Magnitude <= radius then\n            table.insert(list, model)\n        end\n    end\n    return list\nend\n\nfunction ZombieService.NearestZombie(pos, range)\n    local best, bestDist = nil, range\n    for model, data in pairs(active) do\n        if not data.dead and data.root.Parent then\n            local d = (data.root.Position - pos).Magnitude\n            if d <= bestDist then best, bestDist = model, d end\n        end\n    end\n    return best\nend\n\nfunction ZombieService.GetActiveCount()\n    local count = 0\n    for model, data in pairs(active) do\n        if model.Parent and not data.dead then count = count + 1 end\n    end\n    return count\nend\n\nfunction ZombieService.ClearAll()\n    for model in pairs(active) do model:Destroy() end\n    table.clear(active)\n    for _, child in ipairs(zombiesFolder:GetChildren()) do child:Destroy() end\n    setBoss(\"\", 0, 0)\nend\n\n-- ===== IA =====\nlocal function collectTargets()\n    local list = {}\n    for _, plr in ipairs(Players:GetPlayers()) do\n        local char = plr.Character\n        local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n        local root = char and char:FindFirstChild(\"HumanoidRootPart\")\n        if hum and root and hum.Health > 0 then\n            table.insert(list, { hum = hum, root = root })\n        end\n    end\n    return list\nend\n\n-- Ataque em \u00e1rea dos bosses (dano em jogadores e estruturas)\nlocal function slam(data, targets)\n    local cfg = data.cfg\n    local pos = data.root.Position\n    local dmg = cfg.SlamDamage * data.dmgMult\n\n    for _, t in ipairs(targets) do\n        if (t.root.Position - pos).Magnitude <= cfg.SlamRadius then\n            t.hum:TakeDamage(dmg)\n        end\n    end\n    for _, s in ipairs(structuresFolder:GetChildren()) do\n        local p = s.PrimaryPart\n        if p and (p.Position - pos).Magnitude <= cfg.SlamRadius then\n            hurtStructure(s, dmg * 0.5)\n        end\n    end\n\n    local ring = Instance.new(\"Part\")\n    ring.Shape = Enum.PartType.Ball\n    ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false\n    ring.Material = Enum.Material.Neon\n    ring.Color = Color3.fromRGB(255, 120, 60)\n    ring.Transparency = 0.6\n    ring.Size = Vector3.one * cfg.SlamRadius * 2\n    ring.CFrame = CFrame.new(pos)\n    ring.Parent = workspace\n    Debris:AddItem(ring, 0.35)\nend\n\nlocal function stepZombie(data, targets, now)\n    local hum, root, cfg = data.hum, data.root, data.cfg\n    if hum.Health <= 0 then return end\n\n    if data.isBoss then\n        setBoss(cfg.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))\n    end\n\n    -- Jogador vivo mais pr\u00f3ximo\n    local best, bestDist = nil, math.huge\n    for _, t in ipairs(targets) do\n        local d = (t.root.Position - root.Position).Magnitude\n        if d < bestDist then best, bestDist = t, d end\n    end\n    if not best then return end\n\n    hum:MoveTo(best.root.Position)\n\n    if data.isBoss and now >= data.nextSlam and bestDist <= cfg.SlamRadius then\n        data.nextSlam = now + cfg.SlamCooldown\n        slam(data, targets)\n    end\n\n    if now - data.lastAttack < cfg.AttackCooldown then return end\n\n    if bestDist <= cfg.AttackRange then\n        data.lastAttack = now\n        best.hum:TakeDamage(cfg.Damage * data.dmgMult)\n        return\n    end\n\n    -- Estrutura bloqueando o caminho (parede, torreta etc.)\n    structureParams.FilterDescendantsInstances = { structuresFolder }\n    local nearby = workspace:GetPartBoundsInRadius(root.Position, cfg.AttackRange * 0.9, structureParams)\n    local toTarget = best.root.Position - root.Position\n    local blocker, blockerDist = nil, math.huge\n    for _, part in ipairs(nearby) do\n        if part.CanCollide then\n            local dir = part.Position - root.Position\n            local facing = dir.Magnitude < 0.01 or toTarget.Magnitude < 0.01 or dir.Unit:Dot(toTarget.Unit) > 0.2\n            if facing and dir.Magnitude < blockerDist then\n                local model = structureOf(part)\n                if model then blocker, blockerDist = model, dir.Magnitude end\n            end\n        end\n    end\n    if blocker then\n        data.lastAttack = now\n        hurtStructure(blocker, cfg.Damage * data.dmgMult)\n    end\nend\n\nfunction ZombieService.Init()\n    zombiesFolder = workspace:WaitForChild(\"Zombies\")\n    structuresFolder = workspace:WaitForChild(\"Structures\")\n    template, templateIsCustom = buildTemplate()\n    setBoss(\"\", 0, 0)\n\n    -- Um \u00fanico loop para todos os zumbis (mais leve que uma thread por zumbi)\n    task.spawn(function()\n        while true do\n            task.wait(0.2)\n            local now = os.clock()\n            local targets = collectTargets()\n            for model, data in pairs(active) do\n                if model.Parent and not data.dead then\n                    local ok, err = pcall(stepZombie, data, targets, now)\n                    if not ok then warn(\"[ZombieService] AI error: \" .. tostring(err)) end\n                else\n                    active[model] = nil\n                end\n            end\n        end\n    end)\nend\n\nreturn ZombieService\nEOF\ncat > WeaponService.lua <<'EOF'\n-- ModuleScript: ServerScriptService/Game/WeaponService\n-- Tiro validado no servidor (cooldown, dist\u00e2ncia e raycast)\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Config = require(ReplicatedStorage:WaitForChild(\"Config\"))\nlocal Remotes = ReplicatedStorage:WaitForChild(\"Remotes\")\nlocal PlayerData = require(script.Parent:WaitForChild(\"PlayerData\"))\nlocal ZombieService = require(script.Parent:WaitForChild(\"ZombieService\"))\n\nlocal WeaponService = {}\nlocal lastShot = {}\n\nlocal function onShoot(player, origin, targetPoint)\n    if typeof(origin) ~= \"Vector3\" or typeof(targetPoint) ~= \"Vector3\" then return end\n    if origin ~= origin or targetPoint ~= targetPoint then return end -- bloqueia NaN\n\n    local char = player.Character\n    local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\n    local root = char and char:FindFirstChild(\"HumanoidRootPart\")\n    if not hum or not root or hum.Health <= 0 then return end\n\n    -- Cooldown no servidor (com pequena toler\u00e2ncia para lat\u00eancia)\n    local now = os.clock()\n    local cooldown = Config.FireCooldown(PlayerData.GetUpgrade(player, \"FireRate\"))\n    if now - (lastShot[player] or 0) < cooldown * 0.8 then return end\n    lastShot[player] = now\n\n    -- A origem do tiro precisa estar perto do personagem\n    if (origin - root.Position).Magnitude > 15 then return end\n\n    local offset = targetPoint - origin\n    if offset.Magnitude < 0.1 then return end\n\n    local ignoreList = { workspace:FindFirstChild(\"Structures\") }\n    for _, p in ipairs(Players:GetPlayers()) do\n        if p.Character then table.insert(ignoreList, p.Character) end\n    end\n\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n    params.FilterDescendantsInstances = ignoreList\n\n    local result = workspace:Raycast(origin, offset.Unit * Config.Weapon.Range, params)\n    if not result then return end\n\n    local zombie = ZombieService.FromInstance(result.Instance)\n    if not zombie then return end\n\n    local damage = Config.Weapon.Damage * PlayerData.GetDamageMult(player)\n    if result.Instance.Name == \"Head\" then\n        damage = damage * Config.Weapon.HeadshotMult\n    end\n    ZombieService.Damage(zombie, damage, player)\nend\n\nfunction WeaponService.Init()\n    Remotes.Shoot.OnServerEvent:Connect(onShoot)\n    Players.PlayerRemoving:Connect(function(p) lastShot[p] = nil end)\nend\n\nreturn WeaponService\nEOF\necho ok", "description": "Write ZombieService and WeaponService"}, "message": "Write ZombieService and WeaponService", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/out/ZombieWave-Fixed/ServerScriptService/Game && cat > ZombieService.lua <<'EOF'\\n-- ModuleScript: ServerScriptService/Game/ZombieService\\n-- Spawn, IA, combate e recompensas de zumbis e bosses\\n\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ServerStorage = game:GetService(\\\"ServerStorage\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\nlocal Debris = game:GetService(\\\"Debris\\\")\\n\\nlocal Config = require(ReplicatedStorage:WaitForChild(\\\"Config\\\"))\\nlocal PlayerData = require(script.Parent:WaitForChild(\\\"PlayerData\\\"))\\n\\nlocal ZombieService = {}\\nlocal active = {} -- [model] = dados do zumbi\\n\\nlocal zombiesFolder, structuresFolder, template, templateIsCustom\\n\\nlocal structureParams = OverlapParams.new()\\nstructureParams.FilterType = Enum.RaycastFilterType.Include\\n\\n-- Estado da boss bar (replicado via atributos para todos os clientes)\\nlocal function setBoss(name, hp, maxHp)\\n    ReplicatedStorage:SetAttribute(\\\"BossName\\\", name)\\n    ReplicatedStorage:SetAttribute(\\\"BossHealth\\\", hp)\\n    ReplicatedStorage:SetAttribute(\\\"BossMaxHealth\\\", maxHp)\\nend\\n\\nlocal function buildTemplate()\\n    -- 1) Modelo pr\\u00f3prio em ServerStorage (ZombieModel ou Zombie)\\n    local custom = ServerStorage:FindFirstChild(\\\"ZombieModel\\\") or ServerStorage:FindFirstChild(\\\"Zombie\\\")\\n    if custom and custom:IsA(\\\"Model\\\") then return custom, true end\\n\\n    -- 2) Rig R6 padr\\u00e3o gerado pela engine\\n    local ok, rig = pcall(function()\\n        return Players:CreateHumanoidModelFromDescription(Instance.new(\\\"HumanoidDescription\\\"), Enum.HumanoidRigType.R6)\\n    end)\\n    if ok and rig then\\n        rig.Name = \\\"Zombie\\\"\\n        return rig, false\\n    end\\n\\n    -- 3) Fallback m\\u00ednimo\\n    local model = Instance.new(\\\"Model\\\")\\n    model.Name = \\\"Zombie\\\"\\n    local hrp = Instance.new(\\\"Part\\\")\\n    hrp.Name = \\\"HumanoidRootPart\\\"\\n    hrp.Size = Vector3.new(2, 2, 1)\\n    hrp.Parent = model\\n    local head = Instance.new(\\\"Part\\\")\\n    head.Name = \\\"Head\\\"\\n    head.Size = Vector3.new(1, 1, 1)\\n    head.Parent = model\\n    local neck = Instance.new(\\\"Weld\\\")\\n    neck.Part0, neck.Part1 = hrp, head\\n    neck.C0 = CFrame.new(0, 1.5, 0)\\n    neck.Parent = hrp\\n    local hum = Instance.new(\\\"Humanoid\\\")\\n    hum.HipHeight = 2\\n    hum.Parent = model\\n    model.PrimaryPart = hrp\\n    return model, false\\nend\\n\\nlocal function paint(model, color)\\n    for _, d in ipairs(model:GetDescendants()) do\\n        if d:IsA(\\\"BodyColors\\\") or d:IsA(\\\"Shirt\\\") or d:IsA(\\\"Pants\\\") or d:IsA(\\\"ShirtGraphic\\\") then\\n            d:Destroy()\\n        end\\n    end\\n    for _, d in ipairs(model:GetDescendants()) do\\n        if d:IsA(\\\"BasePart\\\") and d.Name ~= \\\"HumanoidRootPart\\\" then\\n            d.Color = color\\n        end\\n    end\\nend\\n\\n-- Sobe na hierarquia at\\u00e9 achar o modelo da estrutura (filho direto de workspace.Structures)\\nlocal function structureOf(inst)\\n    local cur = inst\\n    while cur and cur.Parent ~= structuresFolder do\\n        cur = cur.Parent\\n    end\\n    return cur\\nend\\n\\nlocal function hurtStructure(structure, amount)\\n    if not structure or not structure.Parent then return end\\n    local hp = (structure:GetAttribute(\\\"Health\\\") or 0) - amount\\n    structure:SetAttribute(\\\"Health\\\", hp)\\n    if hp <= 0 then structure:Destroy() end\\nend\\n\\nlocal function onDied(data)\\n    if data.dead then return end\\n    data.dead = true\\n    active[data.model] = nil\\n\\n    local cfg = data.cfg\\n    local money = math.floor(cfg.Money * (data.isBoss and 1 or Config.ZombieMoneyMult(data.wave)))\\n\\n    local killer = data.lastHitBy\\n    if killer and killer.Parent then PlayerData.AddKill(killer) end\\n\\n    if data.isBoss then\\n        -- Boss: todos os jogadores recebem a recompensa\\n        for _, plr in ipairs(Players:GetPlayers()) do\\n            PlayerData.AddMoney(plr, money)\\n            PlayerData.AddXP(plr, cfg.XP)\\n        end\\n        setBoss(\\\"\\\", 0, 0)\\n    elseif killer and killer.Parent then\\n        PlayerData.AddMoney(killer, money)\\n        PlayerData.AddXP(killer, cfg.XP)\\n    end\\n\\n    for _, part in ipairs(data.model:GetDescendants()) do\\n        if part:IsA(\\\"BasePart\\\") then part.CanCollide = false end\\n    end\\n    Debris:AddItem(data.model, 5)\\nend\\n\\nfunction ZombieService.SpawnZombie(typeId, spawnCFrame, wave)\\n    wave = wave or 1\\n    local isBoss = Config.Bosses[typeId] ~= nil\\n    local cfg = Config.Bosses[typeId] or Config.Zombies[typeId]\\n    if not cfg then\\n        warn(\\\"[ZombieService] Unknown zombie type: \\\" .. tostring(typeId))\\n        return nil\\n    end\\n    if not template then return nil end\\n\\n    local model = template:Clone()\\n    local hum = model:FindFirstChildOfClass(\\\"Humanoid\\\")\\n    local root = model:FindFirstChild(\\\"HumanoidRootPart\\\")\\n    if not hum or not root then\\n        model:Destroy()\\n        warn(\\\"[ZombieService] Zombie model needs a Humanoid and a HumanoidRootPart.\\\")\\n        return nil\\n    end\\n\\n    if not templateIsCustom then paint(model, cfg.Color) end\\n    model.Name = cfg.Name\\n    if cfg.Scale ~= 1 then model:ScaleTo(cfg.Scale) end\\n\\n    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None\\n    hum.MaxHealth = math.floor(cfg.Health * (isBoss and 1 or Config.ZombieHealthMult(wave)))\\n    hum.Health = hum.MaxHealth\\n    hum.WalkSpeed = cfg.Speed\\n    model:SetAttribute(\\\"BaseSpeed\\\", cfg.Speed)\\n\\n    -- Um pouco acima do ch\\u00e3o para n\\u00e3o prender nem atravessar\\n    model:PivotTo((spawnCFrame or CFrame.new(0, 10, 0)) + Vector3.new(0, 3 + (cfg.Scale - 1) * 3, 0))\\n    model.Parent = zombiesFolder\\n    pcall(function() root:SetNetworkOwner(nil) end)\\n\\n    local data = {\\n        model = model, hum = hum, root = root, cfg = cfg, wave = wave, isBoss = isBoss,\\n        dmgMult = isBoss and 1 or Config.ZombieDamageMult(wave),\\n        lastAttack = 0,\\n        nextSlam = os.clock() + (cfg.SlamCooldown or 0),\\n    }\\n    active[model] = data\\n\\n    hum.Died:Connect(function() onDied(data) end)\\n    model.Destroying:Connect(function()\\n        active[model] = nil\\n        if isBoss then setBoss(\\\"\\\", 0, 0) end\\n    end)\\n    return model\\nend\\n\\n-- Retorna o modelo do zumbi a partir de qualquer parte dele\\nfunction ZombieService.FromInstance(inst)\\n    local cur = inst\\n    while cur and cur.Parent ~= zombiesFolder do\\n        cur = cur.Parent\\n    end\\n    if cur and active[cur] and not active[cur].dead then return cur end\\n    return nil\\nend\\n\\nfunction ZombieService.IsZombie(model)\\n    local data = active[model]\\n    return data ~= nil and not data.dead\\nend\\n\\nfunction ZombieService.Damage(model, amount, owner)\\n    local data = active[model]\\n    if not data or data.dead then return end\\n    if type(amount) ~= \\\"number\\\" or amount ~= amount or amount <= 0 then return end\\n    if owner then data.lastHitBy = owner end\\n    data.hum:TakeDamage(amount)\\nend\\n\\nfunction ZombieService.ZombiesInRadius(pos, radius)\\n    local list = {}\\n    for model, data in pairs(active) do\\n        if not data.dead and data.root.Parent and (data.root.Position - pos).Magnitude <= radius then\\n            table.insert(list, model)\\n        end\\n    end\\n    return list\\nend\\n\\nfunction ZombieService.NearestZombie(pos, range)\\n    local best, bestDist = nil, range\\n    for model, data in pairs(active) do\\n        if not data.dead and data.root.Parent then\\n            local d = (data.root.Position - pos).Magnitude\\n            if d <= bestDist then best, bestDist = model, d end\\n        end\\n    end\\n    return best\\nend\\n\\nfunction ZombieService.GetActiveCount()\\n    local count = 0\\n    for model, data in pairs(active) do\\n        if model.Parent and not data.dead then count = count + 1 end\\n    end\\n    return count\\nend\\n\\nfunction ZombieService.ClearAll()\\n    for model in pairs(active) do model:Destroy() end\\n    table.clear(active)\\n    for _, child in ipairs(zombiesFolder:GetChildren()) do child:Destroy() end\\n    setBoss(\\\"\\\", 0, 0)\\nend\\n\\n-- ===== IA =====\\nlocal function collectTargets()\\n    local list = {}\\n    for _, plr in ipairs(Players:GetPlayers()) do\\n        local char = plr.Character\\n        local hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")\\n        local root = char and char:FindFirstChild(\\\"HumanoidRootPart\\\")\\n        if hum and root and hum.Health > 0 then\\n            table.insert(list, { hum = hum, root = root })\\n        end\\n    end\\n    return list\\nend\\n\\n-- Ataque em \\u00e1rea dos bosses (dano em jogadores e estruturas)\\nlocal function slam(data, targets)\\n    local cfg = data.cfg\\n    local pos = data.root.Position\\n    local dmg = cfg.SlamDamage * data.dmgMult\\n\\n    for _, t in ipairs(targets) do\\n        if (t.root.Position - pos).Magnitude <= cfg.SlamRadius then\\n            t.hum:TakeDamage(dmg)\\n        end\\n    end\\n    for _, s in ipairs(structuresFolder:GetChildren()) do\\n        local p = s.PrimaryPart\\n        if p and (p.Position - pos).Magnitude <= cfg.SlamRadius then\\n            hurtStructure(s, dmg * 0.5)\\n        end\\n    end\\n\\n    local ring = Instance.new(\\\"Part\\\")\\n    ring.Shape = Enum.PartType.Ball\\n    ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false\\n    ring.Material = Enum.Material.Neon\\n    ring.Color = Color3.fromRGB(255, 120, 60)\\n    ring.Transparency = 0.6\\n    ring.Size = Vector3.one * cfg.SlamRadius * 2\\n    ring.CFrame = CFrame.new(pos)\\n    ring.Parent = workspace\\n    Debris:AddItem(ring, 0.35)\\nend\\n\\nlocal function stepZombie(data, targets, now)\\n    local hum, root, cfg = data.hum, data.root, data.cfg\\n    if hum.Health <= 0 then return end\\n\\n    if data.isBoss then\\n        setBoss(cfg.Name, math.floor(hum.Health), math.floor(hum.MaxHealth))\\n    end\\n\\n    -- Jogador vivo mais pr\\u00f3ximo\\n    local best, bestDist = nil, math.huge\\n    for _, t in ipairs(targets) do\\n        local d = (t.root.Position - root.Position).Magnitude\\n        if d < bestDist then best, bestDist = t, d end\\n    end\\n    if not best then return end\\n\\n    hum:MoveTo(best.root.Position)\\n\\n    if data.isBoss and now >= data.nextSlam and bestDist <= cfg.SlamRadius then\\n        data.nextSlam = now + cfg.SlamCooldown\\n        slam(data, targets)\\n    end\\n\\n    if now - data.lastAttack < cfg.AttackCooldown then return end\\n\\n    if bestDist <= cfg.AttackRange then\\n        data.lastAttack = now\\n        best.hum:TakeDamage(cfg.Damage * data.dmgMult)\\n        return\\n    end\\n\\n    -- Estrutura bloqueando o caminho (parede, torreta etc.)\\n    structureParams.FilterDescendantsInstances = { structuresFolder }\\n    local nearby = workspace:GetPartBoundsInRadius(root.Position, cfg.AttackRange * 0.9, structureParams)\\n    local toTarget = best.root.Position - root.Position\\n    local blocker, blockerDist = nil, math.huge\\n    for _, part in ipairs(nearby) do\\n        if part.CanCollide then\\n            local dir = part.Position - root.Position\\n            local facing = dir.Magnitude < 0.01 or toTarget.Magnitude < 0.01 or dir.Unit:Dot(toTarget.Unit) > 0.2\\n            if facing and dir.Magnitude < blockerDist then\\n                local model = structureOf(part)\\n                if model then blocker, blockerDist = model, dir.Magnitude end\\n            end\\n        end\\n    end\\n    if blocker then\\n        data.lastAttack = now\\n        hurtStructure(blocker, cfg.Damage * data.dmgMult)\\n    end\\nend\\n\\nfunction ZombieService.Init()\\n    zombiesFolder = workspace:WaitForChild(\\\"Zombies\\\")\\n    structuresFolder = workspace:WaitForChild(\\\"Structures\\\")\\n    template, templateIsCustom = buildTemplate()\\n    setBoss(\\\"\\\", 0, 0)\\n\\n    -- Um \\u00fanico loop para todos os zumbis (mais leve que uma thread por zumbi)\\n    task.spawn(function()\\n        while true do\\n            task.wait(0.2)\\n            local now = os.clock()\\n            local targets = collectTargets()\\n            for model, data in pairs(active) do\\n                if model.Parent and not data.dead then\\n                    local ok, err = pcall(stepZombie, data, targets, now)\\n                    if not ok then warn(\\\"[ZombieService] AI error: \\\" .. tostring(err)) end\\n                else\\n                    active[model] = nil\\n                end\\n            end\\n        end\\n    end)\\nend\\n\\nreturn ZombieService\\nEOF\\ncat > WeaponService.lua <<'EOF'\\n-- ModuleScript: ServerScriptService/Game/WeaponService\\n-- Tiro validado no servidor (cooldown, dist\\u00e2ncia e raycast)\\n\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\n\\nlocal Config = require(ReplicatedStorage:WaitForChild(\\\"Config\\\"))\\nlocal Remotes = ReplicatedStorage:WaitForChild(\\\"Remotes\\\")\\nlocal PlayerData = require(script.Parent:WaitForChild(\\\"PlayerData\\\"))\\nlocal ZombieService = require(script.Parent:WaitForChild(\\\"ZombieService\\\"))\\n\\nlocal WeaponService = {}\\nlocal lastShot = {}\\n\\nlocal function onShoot(player, origin, targetPoint)\\n    if typeof(origin) ~= \\\"Vector3\\\" or typeof(targetPoint) ~= \\\"Vector3\\\" then return end\\n    if origin ~= origin or targetPoint ~= targetPoint then return end -- bloqueia NaN\\n\\n    local char = player.Character\\n    local hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")\\n    local root = char and char:FindFirstChild(\\\"HumanoidRootPart\\\")\\n    if not hum or not root or hum.Health <= 0 then return end\\n\\n    -- Cooldown no servidor (com pequena toler\\u00e2ncia para lat\\u00eancia)\\n    local now = os.clock()\\n    local cooldown = Config.FireCooldown(PlayerData.GetUpgrade(player, \\\"FireRate\\\"))\\n    if now - (lastShot[player] or 0) < cooldown * 0.8 then return end\\n    lastShot[player] = now\\n\\n    -- A origem do tiro precisa estar perto do personagem\\n    if (origin - root.Position).Magnitude > 15 then return end\\n\\n    local offset = targetPoint - origin\\n    if offset.Magnitude < 0.1 then return end\\n\\n    local ignoreList = { workspace:FindFirstChild(\\\"Structures\\\") }\\n    for _, p in ipairs(Players:GetPlayers()) do\\n        if p.Character then table.insert(ignoreList, p.Character) end\\n    end\\n\\n    local params = RaycastParams.new()\\n    params.FilterType = Enum.RaycastFilterType.Exclude\\n    params.FilterDescendantsInstances = ignoreList\\n\\n    local result = workspace:Raycast(origin, offset.Unit * Config.Weapon.Range, params)\\n    if not result then return end\\n\\n    local zombie = ZombieService.FromInstance(result.Instance)\\n    if not zombie then return end\\n\\n    local damage = Config.Weapon.Damage * PlayerData.GetDamageMult(player)\\n    if result.Instance.Name == \\\"Head\\\" then\\n        damage = damage * Config.Weapon.HeadshotMult\\n    end\\n    ZombieService.Damage(zombie, damage, player)\\nend\\n\\nfunction WeaponService.Init()\\n    Remotes.Shoot.OnServerEvent:Connect(onShoot)\\n    Players.PlayerRemoving:Connect(function(p) lastShot[p] = nil end)\\nend\\n\\nreturn WeaponService\\nEOF\\necho ok\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-10-17T19:21:53.826395Z", "stop_timestamp": "2026-10-17T19:21:53.826453Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01HD8xSKnrcsZ49WnqnL8yQK", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"ok\\n\",\"stderr\":\"\"}"}], "is_error": false, "