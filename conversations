d\n\n\tstopSpectating()\n\n\tspectatingPlr = plr\n\tfocusOn(plr)\n\n\t-- Se o jogador renascer, continua seguindo\n\tspectateConn = plr.CharacterAdded:Connect(function()\n\t\ttask.wait(0.2)\n\t\tif spectatingPlr == plr then\n\t\t\tfocusOn(plr)\n\t\tend\n\tend)\n\nend\n\ngotoButton.Activated:Connect(function()\n\n\tlocal target = currentTarget\n\tlocal myChar = LocalPlr.Character\n\n\tif target and target.Character and myChar then\n\t\tmyChar:PivotTo(target.Character:GetPivot() * CFrame.new(0, 0, 3))\n\tend\n\n\thideMenu()\n\nend)\n\nspecButton.Activated:Connect(function()\n\n\tlocal target = currentTarget\n\n\tif target then\n\n\t\tif spectatingPlr == target then\n\t\t\tstopSpectating()\n\t\telse\n\t\t\tspectate(target)\n\t\tend\n\n\tend\n\n\thideMenu()\n\nend)\n\nbackdrop.Activated:Connect(hideMenu)\nbackdrop.MouseButton2Click:Connect(hideMenu)\n\nlocal function showMenu(plr)\n\n\tcurrentTarget = plr\n\n\theader.Text = plr.DisplayName .. \" (@\" .. plr.Name .. \")\"\n\tidBox.Text = tostring(plr.UserId)\n\tspecButton.Text = (spectatingPlr == plr) and \"Parar de espectar\" or \"Espectar\"\n\tgotoButton.Visible = plr ~= LocalPlr\n\tspecButton.Visible = plr ~= LocalPlr\n\n\tlocal mouse = UserInputService:GetMouseLocation()\n\tlocal viewport = workspace.CurrentCamera.ViewportSize\n\n\tmenu.Position = UDim2.fromOffset(\n\t\tmath.clamp(mouse.X, 0, viewport.X - 230),\n\t\tmath.clamp(mouse.Y, 0, viewport.Y - 170)\n\t)\n\n\tbackdrop.Visible = true\n\tmenu.Visible = true\n\nend\n\n--------------------------------------------------\n-- AMIGOS\n--------------------------------------------------\n\nlocal friendCache = {}\n\nlocal function colorFor(plr)\n\n\tif plr == LocalPlr then\n\t\treturn SELF_COLOR\n\tend\n\n\tif friendCache[plr.UserId] then\n\t\treturn FRIEND_COLOR\n\tend\n\n\treturn NORMAL_COLOR\n\nend\n\n--------------------------------------------------\n-- LINHAS\n--------------------------------------------------\n\nlocal rows = {} -- rows[plr] = {row, label}\n\nlocal