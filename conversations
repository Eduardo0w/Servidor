rd.Data = snapshot\\n\\t\\t\\tif release then\\n\\t\\t\\t\\trecord.SessionLock = nil\\n\\t\\t\\telse\\n\\t\\t\\t\\trecord.SessionLock = { JobId = game.JobId, Time = os.time() }\\n\\t\\t\\tend\\n\\t\\t\\treturn record\\n\\t\\tend)\\n\\tend, \\\"Save \\\" .. player.Name, maxRetries or cfg.MaxRetries)\\n\\n\\tif lostLock then\\n\\t\\twarn(\\\"[DataService] Lock perdido, save descartado:\\\", player.Name)\\n\\t\\treturn false\\n\\tend\\n\\treturn ok\\nend\\n\\n-- Salva com libera\\u00e7\\u00e3o de lock e remove a sess\\u00e3o (idempotente)\\nfunction DataService.Release(player: Player, maxRetries: number?)\\n\\tlocal session = sessions[player]\\n\\tif not session or session.Releasing then\\n\\t\\treturn\\n\\tend\\n\\tsession.Releasing = true\\n\\tDataService.Save(player, true, maxRetries)\\n\\tsessions[player] = nil\\nend\\n\\nfunction DataService.IsLoaded(player: Player): boolean\\n\\treturn sessions[player] ~= nil\\nend\\n\\n-- Refer\\u00eancia viva (somente para uso interno de servi\\u00e7os do servidor)\\nfunction DataService.GetData(player: Player)\\n\\tlocal session = sessions[player]\\n\\treturn session and session.Data or nil\\nend\\n\\nfunction DataService.GetCopy(player: Player)\\n\\tlocal session = sessions[player]\\n\\treturn session and deepCopy(session.Data) or nil\\nend\\n\\n-- \\u00danico ponto de escrita: valida tipo e notifica o cliente dono\\nfunction DataService.Set(player: Player, key: string, value: any): boolean\\n\\tlocal session = sessions[player]\\n\\tlocal default = GameConfig.DefaultData[key]\\n\\tif not session or default == nil then\\n\\t\\treturn false\\n\\tend\\n\\n\\tlocal clean\\n\\tif type(default) == \\\"number\\\" then\\n\\t\\tif not isValidNumber(value) then\\n\\t\\t\\treturn false\\n\\t\\tend\\n\\t\\tclean = math.floor(value)\\n\\telseif type(default) == \\\"table\\\" then\\n\\t\\tclean = sanitizeList(value)\\n\\t\\tif not clean then\\n\\t\\t\\treturn false\\n\\t\\tend\\n\\telse\\n\\t\\treturn false\\n\\tend\\n\\n\\tsession.Data[key] = clean\\n\\tRemotes.Get(\\\"PlayerData\\\", \\\"DataChanged\\\"):FireClient(player, key, deepCopy(clean))\\n\\treturn true\\nend\\n\\nreturn DataService\\nEOF\\n\\ncat > XPService.lua <<'EOF'\\n-- Autoridade sobre XP, Level, Kills e Credits + leaderstats\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\n\\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\\n\\nlocal DataService = require(script.Parent.DataService)\\nlocal TeamService = require(script.Parent.TeamService)\\n\\nlocal P = GameConfig.Progression\\nlocal STAT_NAMES = { \\\"Kills\\\", \\\"Level\\\", \\\"XP\\\" }\\n\\nlocal XPService = {}\\n\\nlocal function cleanAmount(amount: any): number?\\n\\tif type(amount) ~= \\\"number\\\" or amount ~= amount or amount == math.huge then\\n\\t\\treturn nil\\n\\tend\\n\\tlocal value = math.floor(amount)\\n\\tif value < 1 then\\n\\t\\treturn nil\\n\\tend\\n\\treturn value\\nend\\n\\n-- Espelha os dados nos leaderstats (replicados para todos)\\nlocal function syncLeaderstats(player: Player)\\n\\tlocal stats = player:FindFirstChild(\\\"leaderstats\\\")\\n\\tlocal data = DataService.GetData(player)\\n\\tif not stats or not data then\\n\\t\\treturn\\n\\tend\\n\\tfor _, name in ipairs(STAT_NAMES) do\\n\\t\\tlocal value = stats:FindFirstChild(name)\\n\\t\\tif value and value:IsA(\\\"IntValue\\\") then\\n\\t\\t\\tvalue.Value = data[name]\\n\\t\\tend\\n\\tend\\nend\\n\\n-- Chamar ap\\u00f3s o carregamento dos dados\\nfunction XPService.Setup(player: Player)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not data then\\n\\t\\treturn\\n\\tend\\n\\n\\tlocal stats = player:FindFirstChild(\\\"leaderstats\\\")\\n\\tif not stats then\\n\\t\\tstats = Instance.new(\\\"Folder\\\")\\n\\t\\tstats.Name = \\\"leaderstats\\\"\\n\\t\\tstats.Parent = player\\n\\tend\\n\\tfor _, name in ipairs(STAT_NAMES) do\\n\\t\\tif not stats:FindFirstChild(name) then\\n\\t\\t\\tlocal value = Instance.new(\\\"IntValue\\\")\\n\\t\\t\\tvalue.Name = name\\n\\t\\t\\tvalue.Parent = stats\\n\\t\\tend\\n\\tend\\n\\n\\t-- XPRequired sempre derivado da curva atual (protege contra mudan\\u00e7a de balanceamento)\\n\\tlocal required = P.GetXPRequired(data.Level)\\n\\tif data.XPRequired ~= required then\\n\\t\\tDataService.Set(player, \\\"XPRequired\\\", required)\\n\\tend\\n\\tsyncLeaderstats(player)\\nend\\n\\nfunction XPService.AddXP(player: Player, amount: number): boolean\\n\\tlocal clean = cleanAmount(amount)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not clean or not data then\\n\\t\\treturn false\\n\\tend\\n\\n\\tlocal oldLevel = data.Level\\n\\tlocal level, xp, required = data.Level, data.XP + clean, data.XPRequired\\n\\twhile level < P.MaxLevel and xp >= required do\\n\\t\\txp -= required\\n\\t\\tlevel += 1\\n\\t\\trequired = P.GetXPRequired(level)\\n\\tend\\n\\tif level >= P.MaxLevel then\\n\\t\\txp = 0\\n\\tend\\n\\n\\tlocal levelsGained = level - oldLevel\\n\\tif levelsGained > 0 then\\n\\t\\tDataService.Set(player, \\\"Level\\\", level)\\n\\t\\tDataService.Set(player, \\\"XPRequired\\\", required)\\n\\t\\tDataService.Set(player, \\\"Credits\\\", data.Credits + levelsGained * P.LevelUpCredits)\\n\\tend\\n\\tDataService.Set(player, \\\"XP\\\", xp)\\n\\tsyncLeaderstats(player)\\n\\n\\tif levelsGained > 0 then\\n\\t\\tRemotes.Get(\\\"PlayerData\\\", \\\"LevelUp\\\"):FireClient(player, level)\\n\\tend\\n\\treturn true\\nend\\n\\nfunction XPService.AddCredits(player: Player, amount: number): boolean\\n\\tlocal clean = cleanAmount(amount)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not clean or not data then\\n\\t\\treturn false\\n\\tend\\n\\treturn DataService.Set(player, \\\"Credits\\\", data.Credits + clean)\\nend\\n\\n-- Gasta Credits de forma at\\u00f4mica; retorna false se n\\u00e3o houver saldo\\nfunction XPService.SpendCredits(player: Player, amount: number): boolean\\n\\tlocal clean = cleanAmount(amount)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not clean or not data or data.Credits < clean then\\n\\t\\treturn false\\n\\tend\\n\\treturn DataService.Set(player, \\\"Credits\\\", data.Credits - clean)\\nend\\n\\nfunction XPService.AddKills(player: Player, amount: number?): boolean\\n\\tlocal clean = cleanAmount(amount or 1)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not clean or not data then\\n\\t\\treturn false\\n\\tend\\n\\tlocal ok = DataService.Set(player, \\\"Kills\\\", data.Kills + clean)\\n\\tsyncLeaderstats(player)\\n\\treturn ok\\nend\\n\\n-- Recompensa por motivo definido em GameConfig.Progression.Rewards\\nfunction XPService.Reward(player: Player, reason: string, multiplier: number?): boolean\\n\\tlocal reward = P.Rewards[reason]\\n\\tif not reward then\\n\\t\\twarn(\\\"[XPService] Motivo de recompensa desconhecido:\\\", reason)\\n\\t\\treturn false\\n\\tend\\n\\tlocal mult = math.clamp(type(multiplier) == \\\"number\\\" and multiplier or 1, 0, 100)\\n\\tlocal gaveAny = false\\n\\tif reward.XP > 0 then\\n\\t\\tgaveAny = XPService.AddXP(player, reward.XP * mult) or gaveAny\\n\\tend\\n\\tif reward.Credits > 0 then\\n\\t\\tgaveAny = XPService.AddCredits(player, reward.Credits * mult) or gaveAny\\n\\tend\\n\\treturn gaveAny\\nend\\n\\nfunction XPService.Init()\\n\\t-- XP por sobreviver (somente Survivors vivos)\\n\\ttask.spawn(function()\\n\\t\\twhile true do\\n\\t\\t\\ttask.wait(P.SurvivalInterval)\\n\\t\\t\\tfor _, player in ipairs(Players:GetPlayers()) do\\n\\t\\t\\t\\tlocal humanoid = player.Character and player.Character:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\t\\t\\tif\\n\\t\\t\\t\\t\\thumanoid\\n\\t\\t\\t\\t\\tand humanoid.Health > 0\\n\\t\\t\\t\\t\\tand DataService.IsLoaded(player)\\n\\t\\t\\t\\t\\tand TeamService.GetTeamId(player) == \\\"Survivor\\\"\\n\\t\\t\\t\\tthen\\n\\t\\t\\t\\t\\tXPService.Reward(player, \\\"Survival\\\")\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend)\\nend\\n\\nreturn XPService\\nEOF\\n\\ncat > PlayerService.lua <<'EOF'\\n-- Ciclo de vida do jogador: dados -> equipe -> leaderstats -> armas -> spawn\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\n\\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\\n\\nlocal DataService = require(script.Parent.DataService)\\nlocal TeamService = require(script.Parent.TeamService)\\nlocal SpawnService = require(script.Parent.SpawnService)\\nlocal XPService = require(script.Parent.XPService)\\nlocal WeaponService = require(script.Parent.WeaponService)\\n\\nlocal PlayerService = {}\\nlocal lastRequest: { [Player]: number } = {}\\n\\nlocal function onPlayerAdded(player: Player)\\n\\tlocal status = DataService.Load(player)\\n\\tif status == \\\"Failed\\\" then\\n\\t\\tplayer:Kick(\\\"Could not load your data. Please rejoin.\\\")\\n\\t\\treturn\\n\\tend\\n\\n\\t-- Saiu durante o carregamento: libera o lock\\n\\tif not player.Parent then\\n\\t\\tDataService.Release(player)\\n\\t\\treturn\\n\\tend\\n\\n\\tTeamService.SetTeam(player, GameConfig.DefaultTeam)\\n\\tXPService.Setup(player) -- cria leaderstats antes de enviar dados/spawnar\\n\\tWeaponService.SetupPlayer(player) -- invent\\u00e1rio e armas (antes do spawn)\\n\\tplayer:SetAttribute(\\\"DataLoaded\\\", true)\\n\\tRemotes.Get(\\\"PlayerData\\\", \\\"DataLoaded\\\"):FireClient(player, DataService.GetCopy(player))\\n\\n\\tSpawnService.Track(player)\\n\\tSpawnService.Spawn(player)\\nend\\n\\nfunction PlayerService.Init()\\n\\t-- O cliente s\\u00f3 pode pedir os PR\\u00d3PRIOS dados, com limite de frequ\\u00eancia\\n\\tlocal requestData = Remotes.Get(\\\"PlayerData\\\", \\\"RequestData\\\") :: RemoteFunction\\n\\trequestData.OnServerInvoke = function(player)\\n\\t\\tlocal now = os.clock()\\n\\t\\tif lastRequest[player] and now - lastRequest[player] < 1 then\\n\\t\\t\\treturn nil\\n\\t\\tend\\n\\t\\tlastRequest[player] = now\\n\\t\\treturn DataService.GetCopy(player)\\n\\tend\\n\\n\\tPlayers.PlayerRemoving:Connect(function(player)\\n\\t\\tlastRequest[player] = nil\\n\\tend)\\n\\n\\tPlayers.PlayerAdded:Connect(onPlayerAdded)\\n\\tfor _, player in ipairs(Players:GetPlayers()) do\\n\\t\\ttask.spawn(onPlayerAdded, player)\\n\\tend\\nend\\n\\nreturn PlayerService\\nEOF\\nwc -l *.lua\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-03T23:13:08.960125Z", "stop_timestamp": "2026-11-03T23:13:08.960164Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01DCW2v5pvLhbp7Gk5PMEqSL", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"  269 DataService.lua\\n   62 PlayerService.lua\\n   89 SpawnService.lua\\n   42 TeamService.lua\\n  172 XPService.lua\\n  634 total\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"  269 DataService.lua\\n   62 PlayerService.lua\\n   89 SpawnService.lua\\n   42 TeamService.lua\\n  172 XPService.lua\\n  634 total\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-03T23:13:09.933400Z", "stop_timestamp": "2026-11-03T23:13:24.050048Z", "flags": null, "type": "tool_use", "id": "toolu_01EqAnNotBzYHrVESaV6p3VD", "name": "bash_tool", "input": {"command": "cd /home/claude/InfectionSurvival/src/ServerScriptService/Services\ncat > CombatService.lua <<'EOF'\n-- Autoridade de dano: regras de alvo, headshot, kills, assist\u00eancias, explos\u00f5es e queimadura\nlocal Players = game:GetService(\"Players\")\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal WeaponConfig = require(ReplicatedStorage.Modules.Weapons.WeaponConfig)\nlocal XPService = require(script.Parent.XPService)\n\nlocal C = GameConfig.Combat\nlocal CombatService = {}\n\nlocal rewarded = setmetatable({}, { __mode = \"k\" }) -- [Humanoid] = true (evita recompensa dupla)\nlocal contributions = setmetatable({}, { __mode = \"k\" }) -- [Humanoid] = { [Player] = tempo }\nlocal burning = {} -- [Humanoid] = { Attacker, Model, DPS, EndTime, Fire }\n\nlocal function nextModel(inst: Instance): Model?\n\tlocal parent = inst.Parent\n\tif not parent then\n\t\treturn nil\n\tend\n\tif parent:IsA(\"Model\") then\n\t\treturn parent\n\tend\n\treturn parent:FindFirstAncestorOfClass(\"Model\")\nend\n\n-- Sobe a hierarquia at\u00e9 achar um Model com Humanoid\nfunction CombatService.GetTargetHumanoid(part: Instance): (Humanoid?, Model?)\n\tlocal model = part:FindFirstAncestorOfClass(\"Model\")\n\twhile model do\n\t\tlocal humanoid = model:FindFirstChildOfClass(\"Humanoid\")\n\t\tif humanoid then\n\t\t\treturn humanoid, model\n\t\tend\n\t\tmodel = nextModel(model)\n\tend\n\treturn nil, nil\nend\n\nlocal function isEnemyModel(model: Model): boolean\n\tif CollectionService:HasTag(model, C.EnemyTag) then\n\t\treturn true\n\tend\n\tlocal monsters = Workspace:FindFirstChild(C.MonstersFolder)\n\treturn monsters ~= nil and model:IsDescendantOf(monsters)\nend\n\n-- Sem fogo amigo: jogadores s\u00f3 ferem outra equipe; NPCs s\u00f3 se forem inimigos\nfunction CombatService.CanDamage(attacker: Player, humanoid: Humanoid, model: Model): boolean\n\tif humanoid.Health <= 0 then\n\t\treturn false\n\tend\n\tlocal victim = Players:GetPlayerFromCharacter(model)\n\tif victim then\n\t\tif victim == attacker then\n\t\t\treturn false\n\t\tend\n\t\treturn attacker.Team ~= nil and victim.Team ~= nil and attacker.Team ~= victim.Team\n\tend\n\treturn isEnemyModel(model)\nend\n\nlocal function awardKill(killer: Player, humanoid: Humanoid, model: Model)\n\tlocal victimPlayer = Players:GetPlayerFromCharacter(model)\n\tXPService.AddKills(killer, 1)\n\n\t-- Atributos do modelo podem sobrescrever a recompensa (monstros nas Fases 5+)\n\tlocal xp, credits = model:GetAttribute(\"XPReward\"), model:GetAttribute(\"CreditReward\")\n\tif type(xp) == \"number\" or type(credits) == \"number\" then\n\t\tif type(xp) == \"number\" and xp > 0 then\n\t\t\tXPService.AddXP(killer, xp)\n\t\tend\n\t\tif type(credits) == \"number\" and credits > 0 then\n\t\t\tXPService.AddCredits(killer, credits)\n\t\tend\n\telse\n\t\tXPService.Reward(killer, victimPlayer and \"ZombieKill\" or \"MonsterKill\")\n\tend\n\n\tlocal list = contributions[humanoid]\n\tif list then\n\t\tfor player, time in pairs(list) do\n\t\t\tif player ~= killer and player.Parent and os.clock() - time <= C.AssistWindow then\n\t\t\t\tXPService.Reward(player, \"Assist\")\n\t\t\tend\n\t\tend\n\tend\n\tcontributions[humanoid] = nil\nend\n\n-- Retorna (matou, foi headshot). hitPart define o headshot; weaponId define o multiplicador.\nfunction CombatService.ApplyDamage(\n\tattacker: Player,\n\thumanoid: Humanoid,\n\tmodel: Model,\n\tamount: number,\n\thitPart: Instance?,\n\tweaponId: string?\n): (boolean, boolean)\n\tif humanoid.Health <= 0 or amount <= 0 then\n\t\treturn false, false\n\tend\n\n\tlocal def = weaponId and WeaponConfig.Weapons[weaponId]\n\tlocal headshot = hitPart ~= nil and hitPart.Name == \"Head\"\n\tlocal multiplier = 1\n\tif headshot then\n\t\tmultiplier = (def and def.HeadshotMultiplier) or C.HeadshotMultiplier\n\tend\n\n\tlocal list = contributions[humanoid]\n\tif not list then\n\t\tlist = {}\n\t\tcontributions[humanoid] = list\n\tend\n\tlist[attacker] = os.clock()\n\n\thumanoid:TakeDamage(amount * multiplier)\n\n\tif humanoid.Health <= 0 and not rewarded[humanoid] then\n\t\trewarded[humanoid] = true\n\t\tawardKill(attacker, humanoid, model)\n\t\treturn true, headshot\n\tend\n\treturn false, headshot\nend\n\n-- Dano em \u00e1rea com atenua\u00e7\u00e3o por dist\u00e2ncia e checagem de linha de vis\u00e3o\nfunction CombatService.Explode(attacker: Player, position: Vector3, radius: number, damage: number, weaponId: string?): (boolean, boolean)\n\tlocal hitAny, killedAny = false, false\n\tlocal seen = {}\n\n\tlocal ignore = {}\n\tlocal projectiles = Workspace:FindFirstChild(C.ProjectilesFolder)\n\tif projectiles then\n\t\ttable.insert(ignore, projectiles)\n\tend\n\tif attacker.Character then\n\t\ttable.insert(ignore, attacker.Character)\n\tend\n\tlocal losParams = RaycastParams.new()\n\tlosParams.FilterType = Enum.RaycastFilterType.Exclude\n\tlosParams.FilterDescendantsInstances = ignore\n\n\tfor _, part in ipairs(Workspace:GetPartBoundsInRadius(position, radius)) do\n\t\tlocal humanoid, model = CombatService.GetTargetHumanoid(part)\n\t\tif humanoid and model and not seen[humanoid] and CombatService.CanDamage(attacker, humanoid, model) then\n\t\t\tseen[humanoid] = true\n\t\t\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") or model.PrimaryPart or part\n\t\t\tlocal delta = root.Position - position\n\n\t\t\tlocal los = Workspace:Raycast(position, delta, losParams)\n\t\t\tlocal blocked = los ~= nil and not los.Instance:IsDescendantOf(model)\n\t\t\tif not blocked then\n\t\t\t\tlocal scale = 1 - math.clamp(delta.Magnitude / radius, 0, 1) * 0.75\n\t\t\t\tlocal killed = CombatService.ApplyDamage(attacker, humanoid, model, damage * scale, nil, weaponId)\n\t\t\t\thitAny = true\n\t\t\t\tkilledAny = killedAny or killed\n\t\t\tend\n\t\tend\n\tend\n\treturn hitAny, killedAny\nend\n\n-- Queimadura: dano ao longo do tempo (renova dura\u00e7\u00e3o e mant\u00e9m o maior DPS)\nfunction CombatService.ApplyBurn(attacker: Player, humanoid: Humanoid, model: Model, dps: number, duration: number)\n\tlocal now = os.clock()\n\tlocal entry = burning[humanoid]\n\tif entry then\n\t\tentry.EndTime = math.max(entry.EndTime, now + duration)\n\t\tentry.DPS = math.max(entry.DPS, dps)\n\t\tentry.Attacker = attacker\n\t\treturn\n\tend\n\n\tlocal root = model:FindFirstChild(\"HumanoidRootPart\") or model.PrimaryPart\n\tlocal fire\n\tif root then\n\t\tfire = Instance.new(\"Fire\")\n\t\tfire.Size = 6\n\t\tfire.Heat = 5\n\t\tfire.Parent = root\n\tend\n\tburning[humanoid] = { Attacker = attacker, Model = model, DPS = dps, EndTime = now + duration, Fire = fire }\nend\n\nfunction CombatService.Init()\n\ttask.spawn(function()\n\t\twhile true do\n\t\t\ttask.wait(0.5)\n\t\t\tlocal now = os.clock()\n\t\t\tfor humanoid, entry in pairs(burning) do\n\t\t\t\tlocal stop = not humanoid.Parent\n\t\t\t\t\tor humanoid.Health <= 0\n\t\t\t\t\tor now >= entry.EndTime\n\t\t\t\t\tor not CombatService.CanDamage(entry.Attacker, humanoid, entry.Model)\n\t\t\t\tif stop then\n\t\t\t\t\tif entry.Fire then\n\t\t\t\t\t\tentry.Fire:Destroy()\n\t\t\t\t\tend\n\t\t\t\t\tburning[humanoid] = nil\n\t\t\t\telse\n\t\t\t\t\tCombatService.ApplyDamage(entry.Attacker, humanoid, entry.Model, entry.DPS * 0.5, nil, nil)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend)\nend\n\nreturn CombatService\nEOF\nwc -l CombatService.lua", "description": "Escrever CombatService"}, "message": "Escrever CombatService", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/InfectionSurvival/src/ServerScriptService/Services\\ncat > CombatService.lua <<'EOF'\\n-- Autoridade de dano: regras de alvo, headshot, kills, assist\\u00eancias, explos\\u00f5es e queimadura\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal CollectionService = game:GetService(\\\"CollectionService\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\nlocal Workspace = game:GetService(\\\"Workspace\\\")\\n\\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\\nlocal WeaponConfig = require(ReplicatedStorage.Modules.Weapons.WeaponConfig)\\nlocal XPService = require(script.Parent.XPService)\\n\\nlocal C = GameConfig.Combat\\nlocal CombatService = {}\\n\\nlocal rewarded = setmetatable({}, { __mode = \\\"k\\\" }) -- [Humanoid] = true (evita recompensa dupla)\\nlocal contributions = setmetatable({}, { __mode = \\\"k\\\" }) -- [Humanoid] = { [Player] = tempo }\\nlocal burning = {} -- [Humanoid] = { Attacker, Model, DPS, EndTime, Fire }\\n\\nlocal function nextModel(inst: Instance): Model?\\n\\tlocal parent = inst.Parent\\n\\tif not parent then\\n\\t\\treturn nil\\n\\tend\\n\\tif parent:IsA(\\\"Model\\\") then\\n\\t\\treturn parent\\n\\tend\\n\\treturn parent:FindFirstAncestorOfClass(\\\"Model\\\")\\nend\\n\\n-- Sobe a hierarquia at\\u00e9 achar um Model com Humanoid\\nfunction CombatService.GetTargetHumanoid(part: Instance): (Humanoid?, Model?)\\n\\tlocal model = part:FindFirstAncestorOfClass(\\\"Model\\\")\\n\\twhile model do\\n\\t\\tlocal humanoid = model:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\t\\tif humanoid then\\n\\t\\t\\treturn humanoid, model\\n\\t\\tend\\n\\t\\tmodel = nextModel(model)\\n\\tend\\n\\treturn nil, nil\\nend\\n\\nlocal function isEnemyModel(model: Model): boolean\\n\\tif CollectionService:HasTag(model, C.EnemyTag) then\\n\\t\\treturn true\\n\\tend\\n\\tlocal monsters = Workspace:FindFirstChild(C.MonstersFolder)\\n\\treturn monsters ~= nil and model:IsDescendantOf(monsters)\\nend\\n\\n-- Sem fogo amigo: jogadores s\\u00f3 ferem outra equipe; NPCs s\\u00f3 se forem inimigos\\nfunction CombatService.CanDamage(attacker: Player, humanoid: Humanoid, model: Model): boolean\\n\\tif humanoid.Health <= 0 then\\n\\t\\treturn false\\n\\tend\\n\\tlocal victim = Players:GetPlayerFromCharacter(model)\\n\\tif victim then\\n\\t\\tif victim == attacker then\\n\\t\\t\\treturn false\\n\\t\\tend\\n\\t\\treturn attacker.Team ~= nil and victim.Team ~= nil and attacker.Team ~= victim.Team\\n\\tend\\n\\treturn isEnemyModel(model)\\nend\\n\\nlocal function awardKill(killer: Player, humanoid: Humanoid, model: Model)\\n\\tlocal victimPlayer = Players:GetPlayerFromCharacter(model)\\n\\tXPService.AddKills(killer, 1)\\n\\n\\t-- Atributos do modelo podem sobrescrever a recompensa (monstros nas Fases 5+)\\n\\tlocal xp, credits = model:GetAttribute(\\\"XPReward\\\"), model:GetAttribute(\\\"CreditReward\\\")\\n\\tif type(xp) == \\\"number\\\" or type(credits) == \\\"number\\\" then\\n\\t\\tif type(xp) == \\\"number\\\" and xp > 0 then\\n\\t\\t\\tXPService.AddXP(killer, xp)\\n\\t\\tend\\n\\t\\tif type(credits) == \\\"number\\\" and credits > 0 then\\n\\t\\t\\tXPService.AddCredits(killer, credits)\\n\\t\\tend\\n\\telse\\n\\t\\tXPService.Reward(killer, victimPlayer and \\\"ZombieKill\\\" or \\\"MonsterKill\\\")\\n\\tend\\n\\n\\tlocal list = contributions[humanoid]\\n\\tif list then\\n\\t\\tfor player, time in pairs(list) do\\n\\t\\t\\tif player ~= killer and player.Parent and os.clock() - time <= C.AssistWindow then\\n\\t\\t\\t\\tXPService.Reward(player, \\\"Assist\\\")\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend\\n\\tcontributions[humanoid] = nil\\nend\\n\\n-- Retorna (matou, foi headshot). hitPart define o headshot; weaponId define o multiplicador.\\nfunction CombatService.ApplyDamage(\\n\\tattacker: Player,\\n\\thumanoid: Humanoid,\\n\\tmodel: Model,\\n\\tamount: number,\\n\\thitPart: Instance?,\\n\\tweaponId: string?\\n): (boolean, boolean)\\n\\tif humanoid.Health <= 0 or amount <= 0 then\\n\\t\\treturn false, false\\n\\tend\\n\\n\\tlocal def = weaponId and WeaponConfig.Weapons[weaponId]\\n\\tlocal headshot = hitPart ~= nil and hitPart.Name == \\\"Head\\\"\\n\\tlocal multiplier = 1\\n\\tif headshot then\\n\\t\\tmultiplier = (def and def.HeadshotMultiplier) or C.HeadshotMultiplier\\n\\tend\\n\\n\\tlocal list = contributions[humanoid]\\n\\tif not list then\\n\\t\\tlist = {}\\n\\t\\tcontributions[humanoid] = list\\n\\tend\\n\\tlist[attacker] = os.clock()\\n\\n\\thumanoid:TakeDamage(amount * multiplier)\\n\\n\\tif humanoid.Health <= 0 and not rewarded[humanoid] then\\n\\t\\trewarded[humanoid] = true\\n\\t\\tawardKill(attacker, humanoid, model)\\n\\t\\treturn true, headshot\\n\\tend\\n\\treturn false, headshot\\nend\\n\\n-- Dano em \\u00e1rea com atenua\\u00e7\\u00e3o por dist\\u00e2ncia e checagem de linha de vis\\u00e3o\\nfunction CombatService.Explode(attacker: Player, position: Vector3, radius: number, damage: number, weaponId: string?): (boolean, boolean)\\n\\tlocal hitAny, killedAny = false, false\\n\\tlocal seen = {}\\n\\n\\tlocal ignore = {}\\n\\tlocal projectiles = Workspace:FindFirstChild(C.ProjectilesFolder)\\n\\tif projectiles then\\n\\t\\ttable.insert(ignore, projectiles)\\n\\tend\\n\\tif attacker.Character then\\n\\t\\ttable.insert(ignore, attacker.Character)\\n\\tend\\n\\tlocal losParams = RaycastParams.new()\\n\\tlosParams.FilterType = Enum.RaycastFilterType.Exclude\\n\\tlosParams.FilterDescendantsInstances = ignore\\n\\n\\tfor _, part in ipairs(Workspace:GetPartBoundsInRadius(position, radius)) do\\n\\t\\tlocal humanoid, model = CombatService.GetTargetHumanoid(part)\\n\\t\\tif humanoid and model and not seen[humanoid] and CombatService.CanDamage(attacker, humanoid, model) then\\n\\t\\t\\tseen[humanoid] = true\\n\\t\\t\\tlocal root = model:FindFirstChild(\\\"HumanoidRootPart\\\") or model.PrimaryPart or part\\n\\t\\t\\tlocal delta = root.Position - position\\n\\n\\t\\t\\tlocal los = Workspace:Raycast(position, delta, losParams)\\n\\t\\t\\tlocal blocked = los ~= nil and not los.Instance:IsDescendantOf(model)\\n\\t\\t\\tif not blocked then\\n\\t\\t\\t\\tlocal scale = 1 - math.clamp(delta.Magnitude / radius, 0, 1) * 0.75\\n\\t\\t\\t\\tlocal killed = CombatService.ApplyDamage(attacker, humanoid, model, damage * scale, nil, weaponId)\\n\\t\\t\\t\\thitAny = true\\n\\t\\t\\t\\tkilledAny = killedAny or killed\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend\\n\\treturn hitAny, killedAny\\nend\\n\\n-- Queimadura: dano ao longo do tempo (renova dura\\u00e7\\u00e3o e mant\\u00e9m o maior DPS)\\nfunction CombatService.ApplyBurn(attacker: Player, humanoid: Humanoid, model: Model, dps: number, duration: number)\\n\\tlocal now = os.clock()\\n\\tlocal entry = burning[humanoid]\\n\\tif entry then\\n\\t\\tentry.EndTime = math.max(entry.EndTime, now + duration)\\n\\t\\tentry.DPS = math.max(entry.DPS, dps)\\n\\t\\tentry.Attacker = attacker\\n\\t\\treturn\\n\\tend\\n\\n\\tlocal root = model:FindFirstChild(\\\"HumanoidRootPart\\\") or model.PrimaryPart\\n\\tlocal fire\\n\\tif root then\\n\\t\\tfire = Instance.new(\\\"Fire\\\")\\n\\t\\tfire.Size = 6\\n\\t\\tfire.Heat = 5\\n\\t\\tfire.Parent = root\\n\\tend\\n\\tburning[humanoid] = { Attacker = attacker, Model = model, DPS = dps, EndTime = now + duration, Fire = fire }\\nend\\n\\nfunction CombatService.Init()\\n\\ttask.spawn(function()\\n\\t\\twhile true do\\n\\t\\t\\ttask.wait(0.5)\\n\\t\\t\\tlocal now = os.clock()\\n\\t\\t\\tfor humanoid, entry in pairs(burning) do\\n\\t\\t\\t\\tlocal stop = not humanoid.Parent\\n\\t\\t\\t\\t\\tor humanoid.Health <= 0\\n\\t\\t\\t\\t\\tor now >= entry.EndTime\\n\\t\\t\\t\\t\\tor not CombatService.CanDamage(entry.Attacker, humanoid, entry.Model)\\n\\t\\t\\t\\tif stop then\\n\\t\\t\\t\\t\\tif entry.Fire then\\n\\t\\t\\t\\t\\t\\tentry.Fire:Destroy()\\n\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\t\\tburning[humanoid] = nil\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tCombatService.ApplyDamage(entry.Attacker, humanoid, entry.Model, entry.DPS * 0.5, nil, nil)\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend)\\nend\\n\\nreturn CombatService\\nEOF\\nwc -l CombatService.lua\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-03T23:13:24.294751Z", "stop_timestamp": "2026-11-03T23:13:24.294789Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01EqAnNotBzYHrVESaV6p3VD", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"212 CombatService.lua\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"output_format_category": "none"}, "message": null, "integration_name": "File Creation", "mcp_server_url": null, "integration_icon_url": null, "icon_name": "commandLine", "display_content": {"type": "json_block", "json_block": "{\"returncode\":0,\"stdout\":\"212 CombatService.lua\\n\",\"stderr\":\"\"}"}, "hidden_in_chat": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-03T23:13:24.591718Z", "stop_timestamp": "2026-11-03T23:13:25.655902Z", "flags": null, "type": "thinking", "thinking": "", "summaries": [{"summary": "Revising the weapon service's remote connection."}], "cut_off": false, "truncated": true, "hidden": false, "thinking_hidden": true, "alternative_display_type": null, "signature": null}, {"start_timestamp": "2026-11-03T23:13:25.655975Z", "stop_timestamp": "2026-11-03T23:14:07.015756Z", "flags": null, "type": "tool_use", "id": "toolu_01H8cFCTW28dacXSWaNAhCkR", "name": "bash_tool", "input": {"command": "cd /home/claude/InfectionSurvival/src/ServerScriptService/Services\ncat > WeaponService.lua <<'EOF'\n-- Armas: invent\u00e1rio, Tools, muni\u00e7\u00e3o, recarga, valida\u00e7\u00e3o de disparos, proj\u00e9teis e melee\nlocal Players = game:GetService(\"Players\")\nlocal RunService = game:GetService(\"RunService\")\nlocal ServerStorage = game:GetService(\"ServerStorage\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal Workspace = game:GetService(\"Workspace\")\n\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\nlocal WeaponConfig = require(ReplicatedStorage.Modules.Weapons.WeaponConfig)\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\n\nlocal DataService = require(script.Parent.DataService)\nlocal CombatService = require(script.Parent.CombatService)\n\nlocal C = GameConfig.Combat\nlocal Weapons = WeaponConfig.Weapons\n\nlocal WeaponService = {}\n\nlocal sessions = {} -- [Player] = { Ammo, Active, LastFire, LastReloadRequest, Reloading, ReloadToken, Random }\nlocal projectiles = {}\nlocal projectilesFolder: Instance\nlocal fireEffects: RemoteEvent\nlocal hitMarker: RemoteEvent\nlocal reloadStarted: RemoteEvent\n\n-- ===== Utilit\u00e1rios =====\nlocal function isFiniteVector(v: Vector3): boolean\n\treturn v.X == v.X and v.Y == v.Y and v.Z == v.Z\n\t\tand math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6\nend\n\n-- Ignora o atirador, a equipe dele e os proj\u00e9teis (aliados n\u00e3o bloqueiam tiros)\nlocal function buildFilter(player: Player): { Instance }\n\tlocal filter = { projectilesFolder }\n\tfor _, other in ipairs(Players:GetPlayers()) do\n\t\tif other.Character and (other == player or (other.Team ~= nil and other.Team == player.Team)) then\n\t\t\ttable.insert(filter, other.Character)\n\t\tend\n\tend\n\treturn filter\nend\n\n-- Raycast que atravessa partes n\u00e3o colid\u00edveis que n\u00e3o pertencem a personagens\nlocal function castRay(origin: Vector3, direction: Vector3, filter: { Instance }): RaycastResult?\n\tlocal params = RaycastParams.new()\n\tparams.FilterType = Enum.RaycastFilterType.Exclude\n\tlocal ignore = table.clone(filter)\n\tfor _ = 1, 5 do\n\t\tparams.FilterDescendantsInstances = ignore\n\t\tlocal result = Workspace:Raycast(origin, direction, params)\n\t\tif not result then\n\t\t\treturn nil\n\t\tend\n\t\tlocal part = result.Instance\n\t\tlocal humanoid = CombatService.GetTargetHumanoid(part)\n\t\tif part.CanCollide or humanoid then\n\t\t\treturn result\n\t\tend\n\t\ttable.insert(ignore, part)\n\tend\n\treturn nil\nend\n\nlocal function applySpread(direction: Vector3, spreadDeg: number, rng: Random): Vector3\n\tif spreadDeg <= 0 then\n\t\treturn direction\n\tend\n\tlocal angle = math.rad(spreadDeg) * math.sqrt(rng:NextNumber())\n\tlocal theta = rng:NextNumber() * math.pi * 2\n\tlocal base = CFrame.lookAt(Vector3.zero, direction)\n\treturn (base * CFrame.Angles(0, 0, theta) * CFrame.Angles(angle, 0, 0)).LookVector\nend\n\nlocal function getMuzzle(tool: Tool): Attachment?\n\tlocal handle = tool:FindFirstChild(\"Handle\")\n\tlocal muzzle = handle and handle:FindFirstChild(\"Muzzle\", true)\n\tif muzzle and muzzle:IsA(\"Attachment\") then\n\t\treturn muzzle\n\tend\n\treturn nil\nend\n\n-- Origem do tiro: cano da arma, limitado \u00e0 cabe\u00e7a para evitar origens forjadas\nlocal function getOrigin(character: Model, tool: Tool): Vector3?\n\tlocal head = character:FindFirstChild(\"Head\")\n\tlocal root = character:FindFirstChild(\"HumanoidRootPart\")\n\tlocal base = (head and head.Position) or (root and root.Position)\n\tif not base then\n\t\treturn nil\n\tend\n\tlocal muzzle = getMuzzle(tool)\n\tif muzzle and (muzzle.WorldPosition - base).Magnitude <= 8 then\n\t\treturn muzzle.WorldPosition\n\tend\n\treturn base\nend\n\nlocal function updateAmmoAttributes(player: Player)\n\tlocal s = sessions[player]\n\tlocal active = s and s.Active\n\tif active then\n\t\tlocal def = Weapons[active.Id]\n\t\tlocal ammo = s.Ammo[active.Id]\n\t\tif def and ammo and def.Mode ~= \"Melee\" then\n\t\t\tplayer:SetAttribute(\"AmmoInMagazine\", ammo.Mag)\n\t\t\tplayer:SetAttribute(\"AmmoReserve\", ammo.Reserve)\n\t\t\treturn\n\t\tend\n\tend\n\tplayer:SetAttribute(\"AmmoInMagazine\", nil)\n\tplayer:SetAttribute(\"AmmoReserve\", nil)\nend\n\nlocal function sendEffects(player: Player, payload: { [string]: any }, origin: Vector3)\n\tfor _, other in ipairs(Players:GetPlayers()) do\n\t\tlocal root = other.Character and other.Character:FindFirstChild(\"HumanoidRootPart\")\n\t\tif other == player or (root and (root.Position - origin).Magnitude <= C.EffectsRadius) then\n\t\t\tfireEffects:FireClient(other, payload)\n\t\tend\n\tend\nend\n\n-- ===== Constru\u00e7\u00e3o das Tools =====\nlocal function buildTool(id: string): Tool\n\tlocal def = Weapons[id]\n\tlocal models = ServerStorage:FindFirstChild(\"WeaponModels\")\n\tlocal custom = models and models:FindFirstChild(id)\n\n\tlocal tool: Tool\n\tif custom and custom:IsA(\"Tool\") then\n\t\ttool = custom:Clone()\n\telse\n\t\ttool = Instance.new(\"Tool\")\n\t\ttool.RequiresHandle = true\n\n\t\tlocal handle = Instance.new(\"Part\")\n\t\thandle.Name = \"Handle\"\n\t\thandle.Size = def.Handle.Size\n\t\thandle.Color = def.Handle.Color\n\t\thandle.Material = Enum.Material.SmoothPlastic\n\t\thandle.CanCollide = false\n\t\thandle.Parent = tool\n\n\t\tlocal muzzle = Instance.new(\"Attachment\")\n\t\tmuzzle.Name = \"Muzzle\"\n\t\tmuzzle.Position = Vector3.new(0, 0, -def.Handle.Size.Z / 2)\n\t\tmuzzle.Parent = handle\n\tend\n\n\ttool.Name = def.DisplayName\n\ttool.ToolTip = def.DisplayName\n\ttool.CanBeDropped = false\n\ttool:SetAttribute(\"WeaponId\", id)\n\treturn tool\nend\n\n-- ===== Recarga =====\nlocal function startReload(player: Player)\n\tlocal s = sessions[player]\n\tlocal active = s and s.Active\n\tif not s or not active or s.Reloading then\n\t\treturn\n\tend\n\tlocal def = Weapons[active.Id]\n\tlocal ammo = s.Ammo[active.Id]\n\tif not def or not ammo or def.Mode == \"Melee\" or ammo.Mag >= def.MagazineSize or ammo.Reserve <= 0 then\n\t\treturn\n\tend\n\n\ts.Reloading = true\n\ts.ReloadToken += 1\n\tlocal token = s.ReloadToken\n\tplayer:SetAttribute(\"Reloading\", true)\n\treloadStarted:FireClient(player, active.Id, def.ReloadTime)\n\n\ttask.delay(def.ReloadTime, function()\n\t\tlocal current = sessions[player]\n\t\tif not current or current.ReloadToken ~= token or not current.Reloading then\n\t\t\treturn -- cancelada (troca de arma, morte)\n\t\tend\n\t\tlocal take = math.min(def.MagazineSize - ammo.Mag, ammo.Reserve)\n\t\tammo.Mag += take\n\t\tammo.Reserve -= take\n\t\tcurrent.Reloading = false\n\t\tplayer:SetAttribute(\"Reloading\", false)\n\t\tupdateAmmoAttributes(player)\n\tend)\nend\n\nlocal function cancelReload(player: Player)\n\tlocal s = sessions[player]\n\tif s then\n\t\ts.ReloadToken += 1\n\t\ts.Reloading = false\n\tend\n\tplayer:SetAttribute(\"Reloading\", false)\nend\n\n-- ===== Tipos de disparo =====\nlocal function fireHitscan(player: Player, s, def, id: string, origin: Vector3, direction: Vector3)\n\tlocal filter = buildFilter(player)\n\tlocal hits = {}\n\tlocal anyHit, anyHead, anyKill = false, false, false\n\n\tfor _ = 1, def.Pellets do\n\t\tlocal dir = applySpread(direction, def.Spread, s.Random)\n\t\tlocal result = castRay(origin, dir * def.Range, filter)\n\t\tlocal entry = { P = result and result.Position or (origin + dir * def.Range), F = false }\n\n\t\tif result then\n\t\t\tentry.N = result.Normal\n\t\t\tlocal humanoid, model = CombatService.GetTargetHumanoid(result.Instance)\n\t\t\tif humanoid and model and CombatService.CanDamage(player, humanoid, model) then\n\t\t\t\tlocal killed, headshot = CombatService.ApplyDamage(player, humanoid, model, def.Damage, result.Instance, id)\n\t\t\t\tentry.F = true\n\t\t\t\tanyHit = true\n\t\t\t\tanyHead = anyHead or headshot\n\t\t\t\tanyKill = anyKill or killed\n\t\t\t\tif def.BurnDPS then\n\t\t\t\t\tCombatService.ApplyBurn(player, humanoid, model, def.BurnDPS, def.BurnDuration)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\t\ttable.insert(hits, entry)\n\tend\n\n\tsendEffects(player, { Id = id, Kind = def.Mode, Origin = origin, Direction = direction, Hits = hits }, origin)\n\tif anyHit then\n\t\thitMarker:FireClient(player, anyKill and \"Kill\" or (anyHead and \"Headshot\" or \"Hit\"))\n\tend\nend\n\nlocal function fireMelee(player: Player, def, id: string, character: Model, origin: Vector3)\n\tlocal root = character:FindFirstChild(\"HumanoidRootPart\")\n\tif not root then\n\t\treturn\n\tend\n\tlocal look = root.CFrame.LookVector\n\tlocal center = root.Position\n\tlocal seen, count = {}, 0\n\tlocal anyHit, anyKill = false, false\n\n\tfor _, part in ipairs(Workspace:GetPartBoundsInRadius(center, def.MeleeRange)) do\n\t\tif count >= def.MaxTargets then\n\t\t\tbreak\n\t\tend\n\t\tlocal humanoid, model = CombatService.GetTargetHumanoid(part)\n\t\tif humanoid and model and not seen[humanoid] and CombatService.CanDamage(player, humanoid, model) then\n\t\t\tlocal targetRoot = model:FindFirstChild(\"HumanoidRootPart\") or part\n\t\t\tlocal offset = targetRoot.Position - center\n\t\t\tif offset.Magnitude <= def.MeleeRange and (offset.Magnitude < 1.5 or offset.Unit:Dot(look) >= def.MeleeDot) then\n\t\t\t\tseen[humanoid] = true\n\t\t\t\tcount += 1\n\t\t\t\tlocal killed = CombatService.ApplyDamage(player, humanoid, model, def.Damage, targetRoot, id)\n\t\t\t\tanyHit = true\n\t\t\t\tanyKill = anyKill or killed\n\t\t\tend\n\t\tend\n\tend\n\n\tsendEffects(player, { Id = id, Kind = \"Melee\", Origin = origin, Direction = look, Hits = {} }, origin)\n\tif anyHit then\n\t\thitMarker:FireClient(player, anyKill and \"Kill\" or \"Hit\")\n\tend\nend\n\nlocal function spawnProjectile(player: Player, def, id: string, origin: Vector3, direction: Vector3)\n\tif #projectiles >= C.MaxProjectiles then\n\t\treturn\n\tend\n\tlocal pc = def.Projectile\n\tlocal launchDir = direction\n\tlocal startPos = origin + direction * 1.5\n\tif def.Mode == \"Thrown\" then\n\t\tlaunchDir = (direction + Vector3.new(0, 0.15, 0)).Unit\n\tend\n\n\tlocal part = Instance.new(\"Part\")\n\tpart.Name = id .. \"Projectile\"\n\tpart.Anchored = true\n\tpart.CanCollide = false\n\tpart.CanQuery = false\n\tpart.CanTouch = false\n\tpart.Size = pc.Size\n\tpart.Color = pc.Color\n\tpart.Material = def.Mode == \"Thrown\" and Enum.Material.Metal or Enum.Material.Neon\n\tpart.Shape = pc.Shape == \"Ball\" and Enum.PartType.Ball or Enum.PartType.Block\n\tpart.CFrame = CFrame.lookAt(startPos, startPos + launchDir)\n\tpart.Parent = projectilesFolder\n\n\tif def.Mode == \"Projectile\" then\n\t\tlocal smoke = Instance.new(\"ParticleEmitter\")\n\t\tsmoke.Rate = 60\n\t\tsmoke.Lifetime = NumberRange.new(0.4)\n\t\tsmoke.Speed = NumberRange.new(0)\n\t\tsmoke.Size = NumberSequence.new(0.7, 0.1)\n\t\tsmoke.Transparency = NumberSequence.new(0.3, 1)\n\t\tsmoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))\n\t\tsmoke.Parent = part\n\tend\n\n\tlocal now = os.clock()\n\ttable.insert(projectiles, {\n\t\tPart = part, Owner = player, Id = id, Damage = def.Damage, Radius = pc.Radius,\n\t\tPos = startPos, Vel = launchDir * pc.Speed, GravityScale = pc.GravityScale,\n\t\tExpire = now + pc.Lifetime, Fuse = pc.Fuse, FuseTime = pc.Fuse and (now + pc.Fuse) or 0,\n\t\tRestitution = pc.Restitution or 0, Filter = buildFilter(player),\n\t})\n\n\tsendEffects(player, { Id = id, Kind = def.Mode, Origin = origin, Direction = direction, Hits = {} }, origin)\nend\n\nlocal function explodeProjectile(p, position: Vector3)\n\tlocal explosion = Instance.new(\"Explosion\")\n\texplosion.Position = position\n\texplosion.BlastRadius = math.min(p.Radius, 100)\n\texplosion.BlastPressure = 0 -- visual apenas; o dano \u00e9 calculado pelo CombatService\n\texplosion.DestroyJointRadiusPercent = 0\n\texplosion.ExplosionType = Enum.ExplosionType.NoCraters\n\texplosion.Parent = Workspace\n\n\tlocal hit, killed = CombatService.Explode(p.Owner, position, p.Radius, p.Damage, p.Id)\n\tif hit and p.Owner.Parent then\n\t\thitMarker:FireClient(p.Owner, killed and \"Kill\" or \"Hit\")\n\tend\nend\n\nlocal function stepProjectiles(dt: number)\n\tlocal now = os.clock()\n\tfor i = #projectiles, 1, -1 do\n\t\tlocal p = projectiles[i]\n\t\tlocal remove = false\n\n\t\tif not p.Part.Parent then\n\t\t\tremove = true\n\t\telseif p.Fuse and now >= p.FuseTime then\n\t\t\texplodeProjectile(p, p.Pos)\n\t\t\tremove = true\n\t\telseif now >= p.Expire then\n\t\t\tremove = true\n\t\telse\n\t\t\tlocal newVel = p.Vel + Vector3.new(0, -Workspace.Gravity * p.GravityScale * dt, 0)\n\t\t\tlocal displacement = (p.Vel + newVel) * 0.5 * dt\n\t\t\tlocal result = castRay(p.Pos, displacement, p.Filter)\n\n\t\t\tif result then\n\t\t\t\tif p.Fuse then\n\t\t\t\t\t-- granada: quica e perde velocidade\n\t\t\t\t\tlocal n = result.Normal\n\t\t\t\t\tp.Pos = result.Position + n * 0.3\n\t\t\t\t\tp.Vel = (newVel - 2 * newVel:Dot(n) * n) * p.Restitution\n\t\t\t\t\tif p.Vel.Magnitude < 3 then\n\t\t\t\t\t\tp.Vel = Vector3.zero\n\t\t\t\t\tend\n\t\t\t\telse\n\t\t\t\t\texplodeProjectile(p, result.Position + result.Normal * 0.5)\n\t\t\t\t\tremove = true\n\t\t\t\tend\n\t\t\telse\n\t\t\t\tp.Pos += displacement\n\t\t\t\tp.Vel = newVel\n\t\t\tend\n\n\t\t\tif not remove then\n\t\t\t\tif not p.Fuse and p.Vel.Magnitude > 0.1 then\n\t\t\t\t\tp.Part.CFrame = CFrame.lookAt(p.Pos, p.Pos + p.Vel)\n\t\t\t\telse\n\t\t\t\t\tp.Part.CFrame = CFrame.new(p.Pos)\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\n\t\tif remove then\n\t\t\tp.Part:Destroy()\n\t\t\ttable.remove(projectiles, i)\n\t\tend\n\tend\nend\n\n-- ===== Valida\u00e7\u00e3o e despacho do disparo =====\nlocal function handleFire(player: Player, aimPoint: any)\n\tlocal s = sessions[player]\n\tif not s or not s.Active then\n\t\treturn\n\tend\n\tif typeof(aimPoint) ~= \"Vector3\" or not isFiniteVector(aimPoint) then\n\t\treturn\n\tend\n\n\tlocal character = player.Character\n\tlocal humanoid = character and character:FindFirstChildOfClass(\"Humanoid\")\n\tlocal active = s.Active\n\tif not character or not humanoid or humanoid.Health <= 0 or active.Tool.Parent ~= character then\n\t\treturn\n\tend\n\tif s.Reloading then\n\t\treturn\n\tend\n\n\tlocal def = Weapons[active.Id]\n\tlocal ammo = s.Ammo[active.Id]\n\tif not def or not ammo then\n\t\treturn\n\tend\n\n\t-- Cad\u00eancia validada no servidor\n\tlocal now = os.clock()\n\tif now - s.LastFire < (60 / def.FireRate) * C.FireRateTolerance then\n\t\treturn\n\tend\n\n\tif def.Mode ~= \"Melee\" then\n\t\tif ammo.Mag <= 0 then\n\t\t\tstartReload(player)\n\t\t\treturn\n\t\tend\n\t\tammo.Mag -= 1\n\tend\n\ts.LastFire = now\n\n\tlocal origin = getOrigin(character, active.Tool)\n\tif not origin then\n\t\treturn\n\tend\n\tlocal offset = aimPoint - origin\n\tlocal direction = offset.Magnitude > 0.5 and offset.Unit or character.HumanoidRootPart.CFrame.LookVector\n\n\tif def.Mode == \"Hitscan\" or def.Mode == \"Flame\" then\n\t\tfireHitscan(player, s, def, active.Id, origin, direction)\n\telseif def.Mode == \"Projectile\" or def.Mode == \"Thrown\" then\n\t\tspawnProjectile(player, def, active.Id, origin, direction)\n\telseif def.Mode == \"Melee\" then\n\t\tfireMelee(player, def, active.Id, character, origin)\n\tend\n\n\tupdateAmmoAttributes(player)\n\tif def.Mode ~= \"Melee\" and ammo.Mag == 0 and ammo.Reserve > 0 then\n\t\tstartReload(player)\n\tend\nend\n\n-- ===== Invent\u00e1rio e Tools =====\nlocal function findTool(player: Player, id: string): Tool?\n\tlocal containers = { player:FindFirstChildOfClass(\"Backpack\"), player.Character }\n\tfor _, container in ipairs(containers) do\n\t\tif container then\n\t\t\tfor _, child in ipairs(container:GetChildren()) do\n\t\t\t\tif child:IsA(\"Tool\") and child:GetAttribute(\"WeaponId\") == id then\n\t\t\t\t\treturn child\n\t\t\t\tend\n\t\t\tend\n\t\tend\n\tend\n\treturn nil\nend\n\nlocal function giveTool(player: Player, id: string): Tool?\n\tlocal s = sessions[player]\n\tlocal def = Weapons[id]\n\tlocal backpack = player:FindFirstChildOfClass(\"Backpack\")\n\tif not s or not def or not backpack or findTool(player, id) then\n\t\treturn nil\n\tend\n\n\tif not s.Ammo[id] then\n\t\ts.Ammo[id] = { Mag = def.MagazineSize, Reserve = def.StartReserve }\n\tend\n\n\tlocal tool = buildTool(id)\n\ttool.Equipped:Connect(function()\n\t\ts.Active = { Tool = tool, Id = id }\n\t\tcancelReload(player)\n\t\tupdateAmmoAttributes(player)\n\tend)\n\ttool.Unequipped:Connect(function()\n\t\tif s.Active and s.Active.Tool == tool then\n\t\t\ts.Active = nil\n\t\t\tcancelReload(player)\n\t\t\tupdateAmmoAttributes(player)\n\t\tend\n\tend)\n\ttool.Parent = backpack\n\treturn tool\nend\n\nlocal function onCharacter(player: Player, character: Model)\n\tlocal s = sessions[player]\n\tif not s then\n\t\treturn\n\tend\n\t-- Nova vida: muni\u00e7\u00e3o reiniciada, estado limpo\n\ts.Active = nil\n\ttable.clear(s.Ammo)\n\tcancelReload(player)\n\tupdateAmmoAttributes(player)\n\n\tlocal humanoid = character:WaitForChild(\"Humanoid\", 10)\n\ttask.wait() -- o Roblox recria o Backpack no respawn\n\tif not humanoid or player.Character ~= character then\n\t\treturn\n\tend\n\n\tlocal data = DataService.GetData(player)\n\tif not data then\n\t\treturn\n\tend\n\tfor _, id in ipairs(data.Inventory) do\n\t\tgiveTool(player, id)\n\tend\n\n\thumanoid.Died:Once(function()\n\t\tlocal current = sessions[player]\n\t\tif current then\n\t\t\tcurrent.Active = nil\n\t\t\tcancelReload(player)\n\t\t\tupdateAmmoAttributes(player)\n\t\tend\n\tend)\nend\n\n-- ===== API p\u00fablica =====\nfunction WeaponService.SetupPlayer(player: Player)\n\tlocal data = DataService.GetData(player)\n\tif sessions[player] or not data then\n\t\treturn\n\tend\n\n\tsessions[player] = {\n\t\tAmmo = {}, Active = nil, LastFire = 0, LastReloadRequest = 0,\n\t\tReloading = false, ReloadToken = 0, Random = Random.new(),\n\t}\n\n\t-- Sanitiza o invent\u00e1rio salvo e garante a arma inicial\n\tlocal inventory = {}\n\tfor _, id in ipairs(data.Inventory) do\n\t\tif Weapons[id] and not table.find(inventory, id) and #inventory < C.MaxWeapons then\n\t\t\ttable.insert(inventory, id)\n\t\tend\n\tend\n\tif #inventory == 0 then\n\t\ttable.insert(inventory, C.StarterWeapon)\n\tend\n\tDataService.Set(player, \"Inventory\", inventory)\n\n\tif not table.find(data.UnlockedWeapons, C.StarterWeapon) then\n\t\tlocal unlocked = table.clone(data.UnlockedWeapons)\n\t\ttable.insert(unlocked, C.StarterWeapon)\n\t\tDataService.Set(player, \"UnlockedWeapons\", unlocked)\n\tend\n\n\tplayer.CharacterAdded:Connect(function(character)\n\t\tonCharacter(player, character)\n\tend)\n\tif player.Character then\n\t\ttask.spawn(onCharacter, player, player.Character)\n\tend\nend\n\n-- Desbloqueia uma arma permanentemente (usado pela loja na Fase 10)\nfunction WeaponService.UnlockWeapon(player: Player, id: string): boolean\n\tlocal data = DataService.GetData(player)\n\tif not data or not Weapons[id] then\n\t\treturn false\n\tend\n\tif table.find(data.UnlockedWeapons, id) then\n\t\treturn true\n\tend\n\tlocal unlocked = table.clone(data.UnlockedWeapons)\n\ttable.insert(unlocked, id)\n\treturn DataService.Set(player, \"UnlockedWeapons\", unlocked)\nend\n\n-- Adiciona a arma ao invent\u00e1rio (precisa estar desbloqueada)\nfunction WeaponService.GiveWeapon(player: Player, id: string): (boolean, string?)\n\tlocal data = DataService.GetData(player)\n\tif not data or not sessions[player] then\n\t\treturn false, \"NoData\"\n\tend\n\tif not Weapons[id] then\n\t\treturn false, \"UnknownWeapon\"\n\tend\n\tif not table.find(data.UnlockedWeapons, id) then\n\t\treturn false, \"Locked\"\n\tend\n\tif table.find(data.Inventory, id) then\n\t\treturn false, \"AlreadyOwned\"\n\tend\n\tif #data.Inventory >= C.MaxWeapons then\n\t\treturn false, \"InventoryFull\"\n\tend\n\n\tlocal inventory = table.clone(data.Inventory)\n\ttable.insert(inventory, id)\n\tDataService.Set(player, \"Inventory\", inventory)\n\tgiveTool(player, id)\n\treturn true, nil\nend\n\nfunction WeaponService.RemoveWeapon(player: Player, id: string): boolean\n\tlocal data = DataService.GetData(player)\n\tlocal index = data and table.find(data.Inventory, id)\n\tif not data or not index then\n\t\treturn false\n\tend\n\tlocal inventory = table.clone(data.Inventory)\n\ttable.remove(inventory, index)\n\tDataService.Set(player, \"Inventory\", inventory)\n\tlocal tool = findTool(player, id)\n\tif tool then\n\t\ttool:Destroy()\n\tend\n\treturn true\nend\n\n-- Adiciona muni\u00e7\u00e3o de reserva (loja / caixas de muni\u00e7\u00e3o)\nfunction WeaponService.AddAmmo(player: Player, id: string, amount: number): boolean\n\tlocal s = sessions[player]\n\tlocal def = Weapons[id]\n\tlocal ammo = s and s.Ammo[id]\n\tif not def or not ammo or type(amount) ~= \"number\" or amount ~= amount or amount < 1 then\n\t\treturn false\n\tend\n\tammo.Reserve = math.min(ammo.Reserve + math.floor(amount), def.MaxReserve)\n\tupdateAmmoAttributes(player)\n\treturn true\nend\n\nfunction WeaponService.Init()\n\tprojectilesFolder = Workspace:WaitForChild(C.ProjectilesFolder, 10)\n\tfireEffects = Remotes.Get(\"Combat\", \"FireEffects\") :: RemoteEvent\n\thitMarker = Remotes.Get(\"Combat\", \"HitMarker\") :: RemoteEvent\n\treloadStarted = Remotes.Get(\"Combat\", \"ReloadStarted\") :: RemoteEvent\n\n\t-- O cliente envia somente o ponto de mira; todo o resto \u00e9 decidido aqui\n\tlocal fireRemote = Remotes.Get(\"Combat\", \"Fire\") :: RemoteEvent\n\tlocal reloadRemote = Remotes.Get(\"Combat\", \"Reload\") :: RemoteEvent\n\n\tfireRemote.OnServerEvent:Connect(handleFire)\n\treloadRemote.OnServerEvent:Connect(function(player)\n\t\tlocal s = sessions[player]\n\t\tif not s then\n\t\t\treturn\n\t\tend\n\t\tlocal now = os.clock()\n\t\tif now - s.LastReloadRequest < 0.25 then\n\t\t\treturn\n\t\tend\n\t\ts.LastReloadRequest = now\n\t\tstartReload(player)\n\tend)\n\n\tRunService.Heartbeat:Connect(stepProjectiles)\n\n\tPlayers.PlayerRemoving:Connect(function(player)\n\t\tsessions[player] = nil\n\tend)\nend\n\nreturn WeaponService\nEOF\nwc -l WeaponService.lua", "description": "Escrever WeaponService (com corre\u00e7\u00e3o da conex\u00e3o dos remotes)"}, "message": "Escrever WeaponService (com corre\u00e7\u00e3o da conex\u00e3o dos remotes)", "integration_name": "File Creation", "integration_icon_url": null, "tool_identifier": null, "icon_name": "commandLine", "context": null, "display_content": {"type": "json_block", "json_block": "{\"language\": \"bash\", \"code\": \"cd /home/claude/InfectionSurvival/src/ServerScriptService/Services\\ncat > WeaponService.lua <<'EOF'\\n-- Armas: invent\\u00e1rio, Tools, muni\\u00e7\\u00e3o, recarga, valida\\u00e7\\u00e3o de disparos, proj\\u00e9teis e melee\\nlocal Players = game:GetService(\\\"Players\\\")\\nlocal RunService = game:GetService(\\\"RunService\\\")\\nlocal ServerStorage = game:GetService(\\\"ServerStorage\\\")\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")\\nlocal Workspace = game:GetService(\\\"Workspace\\\")\\n\\nlocal GameConfig = require(ReplicatedStorage.Modules.Config.GameConfig)\\nlocal WeaponConfig = require(ReplicatedStorage.Modules.Weapons.WeaponConfig)\\nlocal Remotes = require(ReplicatedStorage.Modules.Shared.Remotes)\\n\\nlocal DataService = require(script.Parent.DataService)\\nlocal CombatService = require(script.Parent.CombatService)\\n\\nlocal C = GameConfig.Combat\\nlocal Weapons = WeaponConfig.Weapons\\n\\nlocal WeaponService = {}\\n\\nlocal sessions = {} -- [Player] = { Ammo, Active, LastFire, LastReloadRequest, Reloading, ReloadToken, Random }\\nlocal projectiles = {}\\nlocal projectilesFolder: Instance\\nlocal fireEffects: RemoteEvent\\nlocal hitMarker: RemoteEvent\\nlocal reloadStarted: RemoteEvent\\n\\n-- ===== Utilit\\u00e1rios =====\\nlocal function isFiniteVector(v: Vector3): boolean\\n\\treturn v.X == v.X and v.Y == v.Y and v.Z == v.Z\\n\\t\\tand math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6\\nend\\n\\n-- Ignora o atirador, a equipe dele e os proj\\u00e9teis (aliados n\\u00e3o bloqueiam tiros)\\nlocal function buildFilter(player: Player): { Instance }\\n\\tlocal filter = { projectilesFolder }\\n\\tfor _, other in ipairs(Players:GetPlayers()) do\\n\\t\\tif other.Character and (other == player or (other.Team ~= nil and other.Team == player.Team)) then\\n\\t\\t\\ttable.insert(filter, other.Character)\\n\\t\\tend\\n\\tend\\n\\treturn filter\\nend\\n\\n-- Raycast que atravessa partes n\\u00e3o colid\\u00edveis que n\\u00e3o pertencem a personagens\\nlocal function castRay(origin: Vector3, direction: Vector3, filter: { Instance }): RaycastResult?\\n\\tlocal params = RaycastParams.new()\\n\\tparams.FilterType = Enum.RaycastFilterType.Exclude\\n\\tlocal ignore = table.clone(filter)\\n\\tfor _ = 1, 5 do\\n\\t\\tparams.FilterDescendantsInstances = ignore\\n\\t\\tlocal result = Workspace:Raycast(origin, direction, params)\\n\\t\\tif not result then\\n\\t\\t\\treturn nil\\n\\t\\tend\\n\\t\\tlocal part = result.Instance\\n\\t\\tlocal humanoid = CombatService.GetTargetHumanoid(part)\\n\\t\\tif part.CanCollide or humanoid then\\n\\t\\t\\treturn result\\n\\t\\tend\\n\\t\\ttable.insert(ignore, part)\\n\\tend\\n\\treturn nil\\nend\\n\\nlocal function applySpread(direction: Vector3, spreadDeg: number, rng: Random): Vector3\\n\\tif spreadDeg <= 0 then\\n\\t\\treturn direction\\n\\tend\\n\\tlocal angle = math.rad(spreadDeg) * math.sqrt(rng:NextNumber())\\n\\tlocal theta = rng:NextNumber() * math.pi * 2\\n\\tlocal base = CFrame.lookAt(Vector3.zero, direction)\\n\\treturn (base * CFrame.Angles(0, 0, theta) * CFrame.Angles(angle, 0, 0)).LookVector\\nend\\n\\nlocal function getMuzzle(tool: Tool): Attachment?\\n\\tlocal handle = tool:FindFirstChild(\\\"Handle\\\")\\n\\tlocal muzzle = handle and handle:FindFirstChild(\\\"Muzzle\\\", true)\\n\\tif muzzle and muzzle:IsA(\\\"Attachment\\\") then\\n\\t\\treturn muzzle\\n\\tend\\n\\treturn nil\\nend\\n\\n-- Origem do tiro: cano da arma, limitado \\u00e0 cabe\\u00e7a para evitar origens forjadas\\nlocal function getOrigin(character: Model, tool: Tool): Vector3?\\n\\tlocal head = character:FindFirstChild(\\\"Head\\\")\\n\\tlocal root = character:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\tlocal base = (head and head.Position) or (root and root.Position)\\n\\tif not base then\\n\\t\\treturn nil\\n\\tend\\n\\tlocal muzzle = getMuzzle(tool)\\n\\tif muzzle and (muzzle.WorldPosition - base).Magnitude <= 8 then\\n\\t\\treturn muzzle.WorldPosition\\n\\tend\\n\\treturn base\\nend\\n\\nlocal function updateAmmoAttributes(player: Player)\\n\\tlocal s = sessions[player]\\n\\tlocal active = s and s.Active\\n\\tif active then\\n\\t\\tlocal def = Weapons[active.Id]\\n\\t\\tlocal ammo = s.Ammo[active.Id]\\n\\t\\tif def and ammo and def.Mode ~= \\\"Melee\\\" then\\n\\t\\t\\tplayer:SetAttribute(\\\"AmmoInMagazine\\\", ammo.Mag)\\n\\t\\t\\tplayer:SetAttribute(\\\"AmmoReserve\\\", ammo.Reserve)\\n\\t\\t\\treturn\\n\\t\\tend\\n\\tend\\n\\tplayer:SetAttribute(\\\"AmmoInMagazine\\\", nil)\\n\\tplayer:SetAttribute(\\\"AmmoReserve\\\", nil)\\nend\\n\\nlocal function sendEffects(player: Player, payload: { [string]: any }, origin: Vector3)\\n\\tfor _, other in ipairs(Players:GetPlayers()) do\\n\\t\\tlocal root = other.Character and other.Character:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\t\\tif other == player or (root and (root.Position - origin).Magnitude <= C.EffectsRadius) then\\n\\t\\t\\tfireEffects:FireClient(other, payload)\\n\\t\\tend\\n\\tend\\nend\\n\\n-- ===== Constru\\u00e7\\u00e3o das Tools =====\\nlocal function buildTool(id: string): Tool\\n\\tlocal def = Weapons[id]\\n\\tlocal models = ServerStorage:FindFirstChild(\\\"WeaponModels\\\")\\n\\tlocal custom = models and models:FindFirstChild(id)\\n\\n\\tlocal tool: Tool\\n\\tif custom and custom:IsA(\\\"Tool\\\") then\\n\\t\\ttool = custom:Clone()\\n\\telse\\n\\t\\ttool = Instance.new(\\\"Tool\\\")\\n\\t\\ttool.RequiresHandle = true\\n\\n\\t\\tlocal handle = Instance.new(\\\"Part\\\")\\n\\t\\thandle.Name = \\\"Handle\\\"\\n\\t\\thandle.Size = def.Handle.Size\\n\\t\\thandle.Color = def.Handle.Color\\n\\t\\thandle.Material = Enum.Material.SmoothPlastic\\n\\t\\thandle.CanCollide = false\\n\\t\\thandle.Parent = tool\\n\\n\\t\\tlocal muzzle = Instance.new(\\\"Attachment\\\")\\n\\t\\tmuzzle.Name = \\\"Muzzle\\\"\\n\\t\\tmuzzle.Position = Vector3.new(0, 0, -def.Handle.Size.Z / 2)\\n\\t\\tmuzzle.Parent = handle\\n\\tend\\n\\n\\ttool.Name = def.DisplayName\\n\\ttool.ToolTip = def.DisplayName\\n\\ttool.CanBeDropped = false\\n\\ttool:SetAttribute(\\\"WeaponId\\\", id)\\n\\treturn tool\\nend\\n\\n-- ===== Recarga =====\\nlocal function startReload(player: Player)\\n\\tlocal s = sessions[player]\\n\\tlocal active = s and s.Active\\n\\tif not s or not active or s.Reloading then\\n\\t\\treturn\\n\\tend\\n\\tlocal def = Weapons[active.Id]\\n\\tlocal ammo = s.Ammo[active.Id]\\n\\tif not def or not ammo or def.Mode == \\\"Melee\\\" or ammo.Mag >= def.MagazineSize or ammo.Reserve <= 0 then\\n\\t\\treturn\\n\\tend\\n\\n\\ts.Reloading = true\\n\\ts.ReloadToken += 1\\n\\tlocal token = s.ReloadToken\\n\\tplayer:SetAttribute(\\\"Reloading\\\", true)\\n\\treloadStarted:FireClient(player, active.Id, def.ReloadTime)\\n\\n\\ttask.delay(def.ReloadTime, function()\\n\\t\\tlocal current = sessions[player]\\n\\t\\tif not current or current.ReloadToken ~= token or not current.Reloading then\\n\\t\\t\\treturn -- cancelada (troca de arma, morte)\\n\\t\\tend\\n\\t\\tlocal take = math.min(def.MagazineSize - ammo.Mag, ammo.Reserve)\\n\\t\\tammo.Mag += take\\n\\t\\tammo.Reserve -= take\\n\\t\\tcurrent.Reloading = false\\n\\t\\tplayer:SetAttribute(\\\"Reloading\\\", false)\\n\\t\\tupdateAmmoAttributes(player)\\n\\tend)\\nend\\n\\nlocal function cancelReload(player: Player)\\n\\tlocal s = sessions[player]\\n\\tif s then\\n\\t\\ts.ReloadToken += 1\\n\\t\\ts.Reloading = false\\n\\tend\\n\\tplayer:SetAttribute(\\\"Reloading\\\", false)\\nend\\n\\n-- ===== Tipos de disparo =====\\nlocal function fireHitscan(player: Player, s, def, id: string, origin: Vector3, direction: Vector3)\\n\\tlocal filter = buildFilter(player)\\n\\tlocal hits = {}\\n\\tlocal anyHit, anyHead, anyKill = false, false, false\\n\\n\\tfor _ = 1, def.Pellets do\\n\\t\\tlocal dir = applySpread(direction, def.Spread, s.Random)\\n\\t\\tlocal result = castRay(origin, dir * def.Range, filter)\\n\\t\\tlocal entry = { P = result and result.Position or (origin + dir * def.Range), F = false }\\n\\n\\t\\tif result then\\n\\t\\t\\tentry.N = result.Normal\\n\\t\\t\\tlocal humanoid, model = CombatService.GetTargetHumanoid(result.Instance)\\n\\t\\t\\tif humanoid and model and CombatService.CanDamage(player, humanoid, model) then\\n\\t\\t\\t\\tlocal killed, headshot = CombatService.ApplyDamage(player, humanoid, model, def.Damage, result.Instance, id)\\n\\t\\t\\t\\tentry.F = true\\n\\t\\t\\t\\tanyHit = true\\n\\t\\t\\t\\tanyHead = anyHead or headshot\\n\\t\\t\\t\\tanyKill = anyKill or killed\\n\\t\\t\\t\\tif def.BurnDPS then\\n\\t\\t\\t\\t\\tCombatService.ApplyBurn(player, humanoid, model, def.BurnDPS, def.BurnDuration)\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\t\\ttable.insert(hits, entry)\\n\\tend\\n\\n\\tsendEffects(player, { Id = id, Kind = def.Mode, Origin = origin, Direction = direction, Hits = hits }, origin)\\n\\tif anyHit then\\n\\t\\thitMarker:FireClient(player, anyKill and \\\"Kill\\\" or (anyHead and \\\"Headshot\\\" or \\\"Hit\\\"))\\n\\tend\\nend\\n\\nlocal function fireMelee(player: Player, def, id: string, character: Model, origin: Vector3)\\n\\tlocal root = character:FindFirstChild(\\\"HumanoidRootPart\\\")\\n\\tif not root then\\n\\t\\treturn\\n\\tend\\n\\tlocal look = root.CFrame.LookVector\\n\\tlocal center = root.Position\\n\\tlocal seen, count = {}, 0\\n\\tlocal anyHit, anyKill = false, false\\n\\n\\tfor _, part in ipairs(Workspace:GetPartBoundsInRadius(center, def.MeleeRange)) do\\n\\t\\tif count >= def.MaxTargets then\\n\\t\\t\\tbreak\\n\\t\\tend\\n\\t\\tlocal humanoid, model = CombatService.GetTargetHumanoid(part)\\n\\t\\tif humanoid and model and not seen[humanoid] and CombatService.CanDamage(player, humanoid, model) then\\n\\t\\t\\tlocal targetRoot = model:FindFirstChild(\\\"HumanoidRootPart\\\") or part\\n\\t\\t\\tlocal offset = targetRoot.Position - center\\n\\t\\t\\tif offset.Magnitude <= def.MeleeRange and (offset.Magnitude < 1.5 or offset.Unit:Dot(look) >= def.MeleeDot) then\\n\\t\\t\\t\\tseen[humanoid] = true\\n\\t\\t\\t\\tcount += 1\\n\\t\\t\\t\\tlocal killed = CombatService.ApplyDamage(player, humanoid, model, def.Damage, targetRoot, id)\\n\\t\\t\\t\\tanyHit = true\\n\\t\\t\\t\\tanyKill = anyKill or killed\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend\\n\\n\\tsendEffects(player, { Id = id, Kind = \\\"Melee\\\", Origin = origin, Direction = look, Hits = {} }, origin)\\n\\tif anyHit then\\n\\t\\thitMarker:FireClient(player, anyKill and \\\"Kill\\\" or \\\"Hit\\\")\\n\\tend\\nend\\n\\nlocal function spawnProjectile(player: Player, def, id: string, origin: Vector3, direction: Vector3)\\n\\tif #projectiles >= C.MaxProjectiles then\\n\\t\\treturn\\n\\tend\\n\\tlocal pc = def.Projectile\\n\\tlocal launchDir = direction\\n\\tlocal startPos = origin + direction * 1.5\\n\\tif def.Mode == \\\"Thrown\\\" then\\n\\t\\tlaunchDir = (direction + Vector3.new(0, 0.15, 0)).Unit\\n\\tend\\n\\n\\tlocal part = Instance.new(\\\"Part\\\")\\n\\tpart.Name = id .. \\\"Projectile\\\"\\n\\tpart.Anchored = true\\n\\tpart.CanCollide = false\\n\\tpart.CanQuery = false\\n\\tpart.CanTouch = false\\n\\tpart.Size = pc.Size\\n\\tpart.Color = pc.Color\\n\\tpart.Material = def.Mode == \\\"Thrown\\\" and Enum.Material.Metal or Enum.Material.Neon\\n\\tpart.Shape = pc.Shape == \\\"Ball\\\" and Enum.PartType.Ball or Enum.PartType.Block\\n\\tpart.CFrame = CFrame.lookAt(startPos, startPos + launchDir)\\n\\tpart.Parent = projectilesFolder\\n\\n\\tif def.Mode == \\\"Projectile\\\" then\\n\\t\\tlocal smoke = Instance.new(\\\"ParticleEmitter\\\")\\n\\t\\tsmoke.Rate = 60\\n\\t\\tsmoke.Lifetime = NumberRange.new(0.4)\\n\\t\\tsmoke.Speed = NumberRange.new(0)\\n\\t\\tsmoke.Size = NumberSequence.new(0.7, 0.1)\\n\\t\\tsmoke.Transparency = NumberSequence.new(0.3, 1)\\n\\t\\tsmoke.Color = ColorSequence.new(Color3.fromRGB(200, 200, 200))\\n\\t\\tsmoke.Parent = part\\n\\tend\\n\\n\\tlocal now = os.clock()\\n\\ttable.insert(projectiles, {\\n\\t\\tPart = part, Owner = player, Id = id, Damage = def.Damage, Radius = pc.Radius,\\n\\t\\tPos = startPos, Vel = launchDir * pc.Speed, GravityScale = pc.GravityScale,\\n\\t\\tExpire = now + pc.Lifetime, Fuse = pc.Fuse, FuseTime = pc.Fuse and (now + pc.Fuse) or 0,\\n\\t\\tRestitution = pc.Restitution or 0, Filter = buildFilter(player),\\n\\t})\\n\\n\\tsendEffects(player, { Id = id, Kind = def.Mode, Origin = origin, Direction = direction, Hits = {} }, origin)\\nend\\n\\nlocal function explodeProjectile(p, position: Vector3)\\n\\tlocal explosion = Instance.new(\\\"Explosion\\\")\\n\\texplosion.Position = position\\n\\texplosion.BlastRadius = math.min(p.Radius, 100)\\n\\texplosion.BlastPressure = 0 -- visual apenas; o dano \\u00e9 calculado pelo CombatService\\n\\texplosion.DestroyJointRadiusPercent = 0\\n\\texplosion.ExplosionType = Enum.ExplosionType.NoCraters\\n\\texplosion.Parent = Workspace\\n\\n\\tlocal hit, killed = CombatService.Explode(p.Owner, position, p.Radius, p.Damage, p.Id)\\n\\tif hit and p.Owner.Parent then\\n\\t\\thitMarker:FireClient(p.Owner, killed and \\\"Kill\\\" or \\\"Hit\\\")\\n\\tend\\nend\\n\\nlocal function stepProjectiles(dt: number)\\n\\tlocal now = os.clock()\\n\\tfor i = #projectiles, 1, -1 do\\n\\t\\tlocal p = projectiles[i]\\n\\t\\tlocal remove = false\\n\\n\\t\\tif not p.Part.Parent then\\n\\t\\t\\tremove = true\\n\\t\\telseif p.Fuse and now >= p.FuseTime then\\n\\t\\t\\texplodeProjectile(p, p.Pos)\\n\\t\\t\\tremove = true\\n\\t\\telseif now >= p.Expire then\\n\\t\\t\\tremove = true\\n\\t\\telse\\n\\t\\t\\tlocal newVel = p.Vel + Vector3.new(0, -Workspace.Gravity * p.GravityScale * dt, 0)\\n\\t\\t\\tlocal displacement = (p.Vel + newVel) * 0.5 * dt\\n\\t\\t\\tlocal result = castRay(p.Pos, displacement, p.Filter)\\n\\n\\t\\t\\tif result then\\n\\t\\t\\t\\tif p.Fuse then\\n\\t\\t\\t\\t\\t-- granada: quica e perde velocidade\\n\\t\\t\\t\\t\\tlocal n = result.Normal\\n\\t\\t\\t\\t\\tp.Pos = result.Position + n * 0.3\\n\\t\\t\\t\\t\\tp.Vel = (newVel - 2 * newVel:Dot(n) * n) * p.Restitution\\n\\t\\t\\t\\t\\tif p.Vel.Magnitude < 3 then\\n\\t\\t\\t\\t\\t\\tp.Vel = Vector3.zero\\n\\t\\t\\t\\t\\tend\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\texplodeProjectile(p, result.Position + result.Normal * 0.5)\\n\\t\\t\\t\\t\\tremove = true\\n\\t\\t\\t\\tend\\n\\t\\t\\telse\\n\\t\\t\\t\\tp.Pos += displacement\\n\\t\\t\\t\\tp.Vel = newVel\\n\\t\\t\\tend\\n\\n\\t\\t\\tif not remove then\\n\\t\\t\\t\\tif not p.Fuse and p.Vel.Magnitude > 0.1 then\\n\\t\\t\\t\\t\\tp.Part.CFrame = CFrame.lookAt(p.Pos, p.Pos + p.Vel)\\n\\t\\t\\t\\telse\\n\\t\\t\\t\\t\\tp.Part.CFrame = CFrame.new(p.Pos)\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\n\\t\\tif remove then\\n\\t\\t\\tp.Part:Destroy()\\n\\t\\t\\ttable.remove(projectiles, i)\\n\\t\\tend\\n\\tend\\nend\\n\\n-- ===== Valida\\u00e7\\u00e3o e despacho do disparo =====\\nlocal function handleFire(player: Player, aimPoint: any)\\n\\tlocal s = sessions[player]\\n\\tif not s or not s.Active then\\n\\t\\treturn\\n\\tend\\n\\tif typeof(aimPoint) ~= \\\"Vector3\\\" or not isFiniteVector(aimPoint) then\\n\\t\\treturn\\n\\tend\\n\\n\\tlocal character = player.Character\\n\\tlocal humanoid = character and character:FindFirstChildOfClass(\\\"Humanoid\\\")\\n\\tlocal active = s.Active\\n\\tif not character or not humanoid or humanoid.Health <= 0 or active.Tool.Parent ~= character then\\n\\t\\treturn\\n\\tend\\n\\tif s.Reloading then\\n\\t\\treturn\\n\\tend\\n\\n\\tlocal def = Weapons[active.Id]\\n\\tlocal ammo = s.Ammo[active.Id]\\n\\tif not def or not ammo then\\n\\t\\treturn\\n\\tend\\n\\n\\t-- Cad\\u00eancia validada no servidor\\n\\tlocal now = os.clock()\\n\\tif now - s.LastFire < (60 / def.FireRate) * C.FireRateTolerance then\\n\\t\\treturn\\n\\tend\\n\\n\\tif def.Mode ~= \\\"Melee\\\" then\\n\\t\\tif ammo.Mag <= 0 then\\n\\t\\t\\tstartReload(player)\\n\\t\\t\\treturn\\n\\t\\tend\\n\\t\\tammo.Mag -= 1\\n\\tend\\n\\ts.LastFire = now\\n\\n\\tlocal origin = getOrigin(character, active.Tool)\\n\\tif not origin then\\n\\t\\treturn\\n\\tend\\n\\tlocal offset = aimPoint - origin\\n\\tlocal direction = offset.Magnitude > 0.5 and offset.Unit or character.HumanoidRootPart.CFrame.LookVector\\n\\n\\tif def.Mode == \\\"Hitscan\\\" or def.Mode == \\\"Flame\\\" then\\n\\t\\tfireHitscan(player, s, def, active.Id, origin, direction)\\n\\telseif def.Mode == \\\"Projectile\\\" or def.Mode == \\\"Thrown\\\" then\\n\\t\\tspawnProjectile(player, def, active.Id, origin, direction)\\n\\telseif def.Mode == \\\"Melee\\\" then\\n\\t\\tfireMelee(player, def, active.Id, character, origin)\\n\\tend\\n\\n\\tupdateAmmoAttributes(player)\\n\\tif def.Mode ~= \\\"Melee\\\" and ammo.Mag == 0 and ammo.Reserve > 0 then\\n\\t\\tstartReload(player)\\n\\tend\\nend\\n\\n-- ===== Invent\\u00e1rio e Tools =====\\nlocal function findTool(player: Player, id: string): Tool?\\n\\tlocal containers = { player:FindFirstChildOfClass(\\\"Backpack\\\"), player.Character }\\n\\tfor _, container in ipairs(containers) do\\n\\t\\tif container then\\n\\t\\t\\tfor _, child in ipairs(container:GetChildren()) do\\n\\t\\t\\t\\tif child:IsA(\\\"Tool\\\") and child:GetAttribute(\\\"WeaponId\\\") == id then\\n\\t\\t\\t\\t\\treturn child\\n\\t\\t\\t\\tend\\n\\t\\t\\tend\\n\\t\\tend\\n\\tend\\n\\treturn nil\\nend\\n\\nlocal function giveTool(player: Player, id: string): Tool?\\n\\tlocal s = sessions[player]\\n\\tlocal def = Weapons[id]\\n\\tlocal backpack = player:FindFirstChildOfClass(\\\"Backpack\\\")\\n\\tif not s or not def or not backpack or findTool(player, id) then\\n\\t\\treturn nil\\n\\tend\\n\\n\\tif not s.Ammo[id] then\\n\\t\\ts.Ammo[id] = { Mag = def.MagazineSize, Reserve = def.StartReserve }\\n\\tend\\n\\n\\tlocal tool = buildTool(id)\\n\\ttool.Equipped:Connect(function()\\n\\t\\ts.Active = { Tool = tool, Id = id }\\n\\t\\tcancelReload(player)\\n\\t\\tupdateAmmoAttributes(player)\\n\\tend)\\n\\ttool.Unequipped:Connect(function()\\n\\t\\tif s.Active and s.Active.Tool == tool then\\n\\t\\t\\ts.Active = nil\\n\\t\\t\\tcancelReload(player)\\n\\t\\t\\tupdateAmmoAttributes(player)\\n\\t\\tend\\n\\tend)\\n\\ttool.Parent = backpack\\n\\treturn tool\\nend\\n\\nlocal function onCharacter(player: Player, character: Model)\\n\\tlocal s = sessions[player]\\n\\tif not s then\\n\\t\\treturn\\n\\tend\\n\\t-- Nova vida: muni\\u00e7\\u00e3o reiniciada, estado limpo\\n\\ts.Active = nil\\n\\ttable.clear(s.Ammo)\\n\\tcancelReload(player)\\n\\tupdateAmmoAttributes(player)\\n\\n\\tlocal humanoid = character:WaitForChild(\\\"Humanoid\\\", 10)\\n\\ttask.wait() -- o Roblox recria o Backpack no respawn\\n\\tif not humanoid or player.Character ~= character then\\n\\t\\treturn\\n\\tend\\n\\n\\tlocal data = DataService.GetData(player)\\n\\tif not data then\\n\\t\\treturn\\n\\tend\\n\\tfor _, id in ipairs(data.Inventory) do\\n\\t\\tgiveTool(player, id)\\n\\tend\\n\\n\\thumanoid.Died:Once(function()\\n\\t\\tlocal current = sessions[player]\\n\\t\\tif current then\\n\\t\\t\\tcurrent.Active = nil\\n\\t\\t\\tcancelReload(player)\\n\\t\\t\\tupdateAmmoAttributes(player)\\n\\t\\tend\\n\\tend)\\nend\\n\\n-- ===== API p\\u00fablica =====\\nfunction WeaponService.SetupPlayer(player: Player)\\n\\tlocal data = DataService.GetData(player)\\n\\tif sessions[player] or not data then\\n\\t\\treturn\\n\\tend\\n\\n\\tsessions[player] = {\\n\\t\\tAmmo = {}, Active = nil, LastFire = 0, LastReloadRequest = 0,\\n\\t\\tReloading = false, ReloadToken = 0, Random = Random.new(),\\n\\t}\\n\\n\\t-- Sanitiza o invent\\u00e1rio salvo e garante a arma inicial\\n\\tlocal inventory = {}\\n\\tfor _, id in ipairs(data.Inventory) do\\n\\t\\tif Weapons[id] and not table.find(inventory, id) and #inventory < C.MaxWeapons then\\n\\t\\t\\ttable.insert(inventory, id)\\n\\t\\tend\\n\\tend\\n\\tif #inventory == 0 then\\n\\t\\ttable.insert(inventory, C.StarterWeapon)\\n\\tend\\n\\tDataService.Set(player, \\\"Inventory\\\", inventory)\\n\\n\\tif not table.find(data.UnlockedWeapons, C.StarterWeapon) then\\n\\t\\tlocal unlocked = table.clone(data.UnlockedWeapons)\\n\\t\\ttable.insert(unlocked, C.StarterWeapon)\\n\\t\\tDataService.Set(player, \\\"UnlockedWeapons\\\", unlocked)\\n\\tend\\n\\n\\tplayer.CharacterAdded:Connect(function(character)\\n\\t\\tonCharacter(player, character)\\n\\tend)\\n\\tif player.Character then\\n\\t\\ttask.spawn(onCharacter, player, player.Character)\\n\\tend\\nend\\n\\n-- Desbloqueia uma arma permanentemente (usado pela loja na Fase 10)\\nfunction WeaponService.UnlockWeapon(player: Player, id: string): boolean\\n\\tlocal data = DataService.GetData(player)\\n\\tif not data or not Weapons[id] then\\n\\t\\treturn false\\n\\tend\\n\\tif table.find(data.UnlockedWeapons, id) then\\n\\t\\treturn true\\n\\tend\\n\\tlocal unlocked = table.clone(data.UnlockedWeapons)\\n\\ttable.insert(unlocked, id)\\n\\treturn DataService.Set(player, \\\"UnlockedWeapons\\\", unlocked)\\nend\\n\\n-- Adiciona a arma ao invent\\u00e1rio (precisa estar desbloqueada)\\nfunction WeaponService.GiveWeapon(player: Player, id: string): (boolean, string?)\\n\\tlocal data = DataService.GetData(player)\\n\\tif not data or not sessions[player] then\\n\\t\\treturn false, \\\"NoData\\\"\\n\\tend\\n\\tif not Weapons[id] then\\n\\t\\treturn false, \\\"UnknownWeapon\\\"\\n\\tend\\n\\tif not table.find(data.UnlockedWeapons, id) then\\n\\t\\treturn false, \\\"Locked\\\"\\n\\tend\\n\\tif table.find(data.Inventory, id) then\\n\\t\\treturn false, \\\"AlreadyOwned\\\"\\n\\tend\\n\\tif #data.Inventory >= C.MaxWeapons then\\n\\t\\treturn false, \\\"InventoryFull\\\"\\n\\tend\\n\\n\\tlocal inventory = table.clone(data.Inventory)\\n\\ttable.insert(inventory, id)\\n\\tDataService.Set(player, \\\"Inventory\\\", inventory)\\n\\tgiveTool(player, id)\\n\\treturn true, nil\\nend\\n\\nfunction WeaponService.RemoveWeapon(player: Player, id: string): boolean\\n\\tlocal data = DataService.GetData(player)\\n\\tlocal index = data and table.find(data.Inventory, id)\\n\\tif not data or not index then\\n\\t\\treturn false\\n\\tend\\n\\tlocal inventory = table.clone(data.Inventory)\\n\\ttable.remove(inventory, index)\\n\\tDataService.Set(player, \\\"Inventory\\\", inventory)\\n\\tlocal tool = findTool(player, id)\\n\\tif tool then\\n\\t\\ttool:Destroy()\\n\\tend\\n\\treturn true\\nend\\n\\n-- Adiciona muni\\u00e7\\u00e3o de reserva (loja / caixas de muni\\u00e7\\u00e3o)\\nfunction WeaponService.AddAmmo(player: Player, id: string, amount: number): boolean\\n\\tlocal s = sessions[player]\\n\\tlocal def = Weapons[id]\\n\\tlocal ammo = s and s.Ammo[id]\\n\\tif not def or not ammo or type(amount) ~= \\\"number\\\" or amount ~= amount or amount < 1 then\\n\\t\\treturn false\\n\\tend\\n\\tammo.Reserve = math.min(ammo.Reserve + math.floor(amount), def.MaxReserve)\\n\\tupdateAmmoAttributes(player)\\n\\treturn true\\nend\\n\\nfunction WeaponService.Init()\\n\\tprojectilesFolder = Workspace:WaitForChild(C.ProjectilesFolder, 10)\\n\\tfireEffects = Remotes.Get(\\\"Combat\\\", \\\"FireEffects\\\") :: RemoteEvent\\n\\thitMarker = Remotes.Get(\\\"Combat\\\", \\\"HitMarker\\\") :: RemoteEvent\\n\\treloadStarted = Remotes.Get(\\\"Combat\\\", \\\"ReloadStarted\\\") :: RemoteEvent\\n\\n\\t-- O cliente envia somente o ponto de mira; todo o resto \\u00e9 decidido aqui\\n\\tlocal fireRemote = Remotes.Get(\\\"Combat\\\", \\\"Fire\\\") :: RemoteEvent\\n\\tlocal reloadRemote = Remotes.Get(\\\"Combat\\\", \\\"Reload\\\") :: RemoteEvent\\n\\n\\tfireRemote.OnServerEvent:Connect(handleFire)\\n\\treloadRemote.OnServerEvent:Connect(function(player)\\n\\t\\tlocal s = sessions[player]\\n\\t\\tif not s then\\n\\t\\t\\treturn\\n\\t\\tend\\n\\t\\tlocal now = os.clock()\\n\\t\\tif now - s.LastReloadRequest < 0.25 then\\n\\t\\t\\treturn\\n\\t\\tend\\n\\t\\ts.LastReloadRequest = now\\n\\t\\tstartReload(player)\\n\\tend)\\n\\n\\tRunService.Heartbeat:Connect(stepProjectiles)\\n\\n\\tPlayers.PlayerRemoving:Connect(function(player)\\n\\t\\tsessions[player] = nil\\n\\tend)\\nend\\n\\nreturn WeaponService\\nEOF\\nwc -l WeaponService.lua\"}"}, "approval_options": null, "approval_key": null, "approval_key_legacy": null, "is_mcp_app": null, "hidden_in_chat": null, "mcp_server_url": null, "tool_origin": "first_party"}, {"start_timestamp": "2026-11-03T23:14:07.261438Z", "stop_timestamp": "2026-11-03T23:14:07.261478Z", "flags": null, "type": "tool_result", "tool_use_id": "toolu_01H8cFCTW28dacXSWaNAhCkR", "name": "bash_tool", "content": [{"type": "text", "text": "{\"returncode\":0,\"stdout\":\"660 WeaponService.lua\\n\",\"stderr\":\"\"}"}], "is_error": false, "structured_content": null, "meta": {"ou