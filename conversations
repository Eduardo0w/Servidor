\\\"Frame\\\")\\n\\tfill.Size = UDim2.fromScale(1, 1)\\n\\tfill.BorderSizePixel = 0\\n\\tfill.Parent = back\\n\\n\\tlocal function update()\\n\\t\\tlocal r = math.clamp((model:GetAttribute(\\\"Health\\\") or 0) / (model:GetAttribute(\\\"MaxHealth\\\") or 1), 0, 1)\\n\\t\\tfill.Size = UDim2.fromScale(r, 1)\\n\\t\\tfill.BackgroundColor3 = Color3.fromRGB(220, 60, 50):Lerp(Color3.fromRGB(80, 210, 90), r)\\n\\tend\\n\\tmodel:GetAttributeChangedSignal(\\\"Health\\\"):Connect(update)\\n\\tupdate()\\nend\\n\\n-- ===== constru\u00e7\u00e3o das pe\u00e7as por tipo =====\\nlocal function build(player, id, cfg, cf)\\n\\tlocal model = Instance.new(\\\"Model\\\")\\n\\tmodel.Name = cfg.Name\\n\\tlocal st = { cfg = cfg, id = id, last = os.clock() }\\n\\tlocal sz = cfg.Size\\n\\tlocal bottom = -sz.Y / 2\\n\\tlocal function at(y) return cf * CFrame.new(0, y, 0) end\\n\\tlocal kind = cfg.Kind\\n\\tlocal base\\n\\tlocal dark = Color3.fromRGB(40, 40, 45)\\n\\n\\tif kind == \\\"Wall\\\" then\\n\\t\\tif cfg.Style == \\\"Sandbag\\\" then\\n\\t\\t\\tlocal lowH, upH = sz.Y * 0.55, sz.Y * 0.45\\n\\t\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(sz.X, lowH, sz.Z), Color = cfg.Color,\\n\\t\\t\\t\\tMaterial = cfg.Material, CFrame = at(bottom + lowH / 2) }, model)\\n\\t\\t\\tpart({ Name = \\\"Top\\\", Size = Vector3.new(sz.X * 0.8, upH, sz.Z * 0.8),\\n\\t\\t\\t\\tColor = cfg.Color:Lerp(Color3.new(0, 0, 0), 0.12), Material = cfg.Material,\\n\\t\\t\\t\\tCFrame = at(bottom + lowH + upH / 2) }, model)\\n\\t\\telse\\n\\t\\t\\tbase = part({ Name = \\\"Base\\\", Size = sz, Color = cfg.Color, Material = cfg.Material, CFrame = cf }, model)\\n\\t\\tend\\n\\n\\telseif kind == \\\"Turret\\\" then\\n\\t\\tbase = part({ Name = \\\"Base\\\", Size = Vector3.new(3, 1, 3), Color = dark, Material = Enum.Material.Metal,\\n\\t\\t\\tCFrame = at(bottom + 0.5) }, model)\\n\\t\\tlocal bodyCF = at(bottom + 2)\\n\\t\\tst.body = part({ Name = \\\"Body\\\", Size = Vector3.new(2, 2, 2), Color = cfg.Color, Materia