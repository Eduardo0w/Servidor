, Cost = 1500, Max = 2, Health = 450,^M\\n^I^ISize = Vector3.new(3, 4, 3), Damage = 50, Range = 75, Cooldown = 1.1, Color = Color3.fromRGB(200, 80, 60),^M\\n^I^IDesc = \\\"High damage, low fire rate.\\\" },^M\\n^M\\n^IHealStation = { Name = \\\"Healing Station\\\", Kind = \\\"Station\\\", Cost = 700, Max = 2, Health = 500,^M\\n^I^ISize = Vector3.new(3, 4, 3), Radius = 22, HealPct = 0.06, Color = Color3.fromRGB(60, 200, 110),^M\\n^I^IDesc = \\\"Heals players (6%/s)\\\" },^M\\n^I[\\\"Healing Station\\\"] = { Name = \\\"Healing Station\\\", Kind = \\\"Station\\\", Cost = 700, Max = 2, Health = 500,^M\\n^I^ISize = Vector3.new(3, 4, 3), Radius = 22, HealPct = 0.06, Color = Color3.fromRGB(60, 200, 110),^M\\n^I^IDesc = \\\"Heals players (6%/s)\\\" },^M\\n}^M\\n^M\\nConfig.BuildOrder = { \\\"Sandbag\\\", \\\"WoodWall\\\", \\\"MetalWall\\\", \\\"Spikes\\\", \\\"Mine\\\", \\\"Turret_Basic\\\", \\\"Turret_Heavy\\\", \\\"HealStation\\\" }^M\\n^M\\nfunction Config.UpgradeCost(id, level)^M\\n^Ilocal u = Config.Upgrades[id]^M\\n^Iif not u then return 100 end^M\\n^Ireturn math.floor(u.BaseCost * (u.CostMult ^ level))^M\\nend^M\\n^M\\nfunction Config.XPForLevel(level)^M\\n^Ireturn math.floor(100 * level ^ 1.35)^M\\nend^M\\n^M\\nfunction Config.DamageMult(upgradeLevel, playerLevel)^M\\n^Ireturn 1 + 0.15 * upgradeLevel + 0.02 * (playerLevel - 1)^M\\nend^M\\n^M\\nfunction Config.FireCooldown(fireRateLevel)^M\\n^Ireturn Config.Weapon.Cooldown * (0.93 ^ fireRateLevel)^M\\nend^M\\n^M\\nfunction Config.ZombieHealthMult(wave)^M\\n^Ilocal w = wave - 1^M\\n^Ireturn 1 + 0.10 * w + 0.004 * w * w^M\\nend^M\\n^M\\nfunction Config.ZombieDamageMult(wave)^M\\n^Ilocal w = wave - 1^M\\n^Ireturn 1 + 0.03 * w + 0.0008 * w * w^M\\nend^M\\n^M\\nfunction Config.ZombieMoneyMult(wave)^M\\n^Ireturn 1 + 0.06 * (wave - 1)^M\\nend^M\\n^M\\nreturn Config=== ServerScriptService/MainServer.txt ===\\n-- Script (Server): ServerScriptService/MainServer^M\\n-- InicializaM-CM-'M-CM-#o principal do servidor com criaM-CM-'M-CM-#o correta de Remotes e RemoteFunctions^M\\n^M\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")^M\\nlocal ServerScriptService = game:GetService(\\\"ServerScriptService\\\")^M\\n^M\\n-- 1. Garante que a pasta Remotes existe^M\\nlocal remotesFolder = ReplicatedStorage:FindFirstChild(\\\"Remotes\\\")^M\\nif not remotesFolder then^M\\n^IremotesFolder = Instance.new(\\\"Folder\\\")^M\\n^IremotesFolder.Name = \\\"Remotes\\\"^M\\n^IremotesFolder.Parent = ReplicatedStorage^M\\nend^M\\n^M\\n-- 2. Lista correta: Build M-CM-) RemoteFunction porque os scripts usam InvokeServer^M\\nlocal requiredRemotes = {^M\\n^IShoot = \\\"RemoteEvent\\\",^M\\n^IBuild = \\\"RemoteFunction\\\",^M\\n^IUpgrade = \\\"RemoteEvent\\\",^M\\n^IVoteMap = \\\"RemoteEvent\\\",^M\\n^IOpenMapVote = \\\"RemoteEvent\\\",^M\\n^ICloseMapVote = \\\"RemoteEvent\\\",^M\\n^IUpdateGameState = \\\"RemoteEvent\\\",^M\\n^IGetShopData = \\\"RemoteFunction\\\"^M\\n}^M\\n^M\\nfor name, className in pairs(requiredRemotes) do^M\\n^Ilocal existing = remotesFolder:FindFirstChild(name)^M\\n^Iif existing then^M\\n^I^I-- Se jM-CM-! existir na pasta com a classe errada, remove e cria o correto^M\\n^I^Iif existing.ClassName ~= className then^M\\n^I^I^Iexisting:Destroy()^M\\n^I^I^Ilocal remote = Instance.new(className)^M\\n^I^I^Iremote.Name = name^M\\n^I^I^Iremote.Parent = remotesFolder^M\\n^I^Iend^M\\n^Ielse^M\\n^I^Ilocal remote = Instance.new(className)^M\\n^I^Iremote.Name = name^M\\n^I^Iremote.Parent = remotesFolder^M\\n^Iend^M\\nend^M\\n^M\\n-- 3. Carrega e inicializa os mM-CM-3dulos da pasta Game com seguranM-CM-'a^M\\nlocal gameFolder = ServerScriptService:WaitForChild(\\\"Game\\\")^M\\n^M\\nfor _, moduleScript in ipairs(gameFolder:GetChildren()) do^M\\n^Iif moduleScript:IsA(\\\"ModuleScript\\\") then^M\\n^I^Ilocal success, loadedModule = pcall(function()^M\\n^I^I^Ireturn require(moduleScript)^M\\n^I^Iend)^M\\n^M\\n^I^Iif success and type(loadedModule) == \\\"table\\\" then^M\\n^I^I^Iif type(loadedModule.Init) == \\\"function\\\" then^M\\n^I^I^I^Ipcall(function()^M\\n^I^I^I^I^IloadedModule.Init()^M\\n^I^I^I^Iend)^M\\n^I^I^Iend^M\\n^I^Iend^M\\n^Iend^M\\nend^M\\n^M\\nprint(\\\"=== [DEBUG] Servidor inicializado com sucesso! ===\\\")=== ServerScriptService/Game/PlayerData.txt ===\\n-- ModuleScript: ServerScriptService/Game/PlayerData^M\\n-- Gerencia os dados salvos e atributos dos jogadores^M\\n^M\\nlocal DataStoreService = game:GetService(\\\"DataStoreService\\\")^M\\nlocal PlayerDataStore = DataStoreService:GetDataStore(\\\"ZombiesGameData_v2\\\")^M\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")^M\\nlocal Config = require(ReplicatedStorage:WaitForChild(\\\"Config\\\"))^M\\n^M\\nlocal PlayerData = {}^M\\nlocal sessionData = {}^M\\n^M\\nfunction PlayerData.Setup(player)^M\\n^Ilocal userId = player.UserId^M\\n^Ilocal success, data = pcall(function()^M\\n^I^Ireturn PlayerDataStore:GetAsync(\\\"Player_\\\" .. userId)^M\\n^Iend)^M\\n^M\\n^Iif not success then^M\\n^I^Iwarn(\\\"Falha ao carregar dados do jogador: \\\" .. player.Name)^M\\n^I^Idata = nil^M\\n^Iend^M\\n^M\\n^I-- Valores padrM-CM-#o caso seja um novo jogador^M\\n^Idata = data or {^M\\n^I^ICash = 500,^M\\n^I^IUpgrades = {^M\\n^I^I^IDamage = 0,^M\\n^I^I^IFireRate = 0,^M\\n^I^I^IHealth = 0,^M\\n^I^I},^M\\n^I^IOwnedItems = {}^M\\n^I}^M\\n^M\\n^IsessionData[userId] = data^M\\n^M\\n^I-- Define atributos gerais^M\\n^Iplayer:SetAttribute(\\\"Cash\\\", data.Cash)^M\\n^Iplayer:SetAttribute(\\\"Up_Damage\\\", data.Upgrades.Damage or 0)^M\\n^Iplayer:SetAttribute(\\\"Up_FireRate\\\", data.Upgrades.FireRate or 0)^M\\n^Iplayer:SetAttribute(\\\"Up_Health\\\", data.Upgrades.Health or 0)^M\\n^M\\n^I-- Define atributos de itens construM-CM--veis sem espaM-CM-'os nos nomes^M\\n^Iif Config.Buildables then^M\\n^I^Ifor id, _ in pairs(Config.Buildables) do^M\\n^I^I^Ilocal safeId = id:gsub(\\\"%s+\\\", \\\"\\\") -- Remove espaM-CM-'os (ex: \\\"Wood Wall\\\" vira \\\"WoodWall\\\")^M\\n^I^I^Ilocal ownedValue = (data.OwnedItems and data.OwnedItems[id]) and 1 or 0^M\\n^I^I^Iplayer:SetAttribute(\\\"Own_\\\" .. safeId, ownedValue)^M\\n^I^Iend^M\\n^Iend^M\\nend^M\\n^M\\nfunction PlayerData.Save(player)^M\\n^Ilocal userId = player.UserId^M\\n^Ilocal data = sessionData[userId]^M\\n^Iif not data then return end^M\\n^M\\n^I-- Atualiza a tabela com os valores atuais dos atributos antes de salvar^M\\n^Idata.Cash = player:GetAttribute(\\\"Cash\\\") or data.Cash^M\\n^Idata.Upgrades.Damage = player:GetAttribute(\\\"Up_Damage\\\") or data.Upgrades.Damage^M\\n^Idata.Upgrades.FireRate = player:GetAttribute(\\\"Up_FireRate\\\") or data.Upgrades.FireRate^M\\n^Idata.Upgrades.Health = player:GetAttribute(\\\"Up_Health\\\") or data.Upgrades.Health^M\\n^M\\n^Iif Config.Buildables then^M\\n^I^Idata.OwnedItems = data.OwnedItems or {}^M\\n^I^Ifor id, _ in pairs(Config.Buildables) do^M\\n^I^I^Ilocal safeId = id:gsub(\\\"%s+\\\", \\\"\\\")^M\\n^I^I^Ilocal attr = player:GetAttribute(\\\"Own_\\\" .. safeId)^M\\n^I^I^Iif attr and attr > 0 then^M\\n^I^I^I^Idata.OwnedItems[id] = true^M\\n^I^I^Iend^M\\n^I^Iend^M\\n^Iend^M\\n^M\\n^Ipcall(function()^M\\n^I^IPlayerDataStore:SetAsync(\\\"Player_\\\" .. userId, data)^M\\n^Iend)^M\\n^M\\n^IsessionData[userId] = nil^M\\nend^M\\n^M\\nreturn PlayerData=== ServerScriptService/Game/ShopService.txt ===\\n-- ModuleScript: ServerScriptService/Game/ShopService^M\\n-- Compra de upgrades, armas e consumM-CM--veis (validado no servidor).^M\\n^M\\nlocal ReplicatedStorage = game:GetService(\\\"ReplicatedStorage\\\")^M\\n^M\\nlocal Config = require(ReplicatedStorage:WaitForChild(\\\"Config\\\"))^M\\nlocal Remotes = ReplicatedStorage:WaitForChild(\\\"Remotes\\\")^M\\nlocal PlayerData = require(script.Parent.PlayerData)^M\\n^M\\nlocal ShopService = {}^M\\n^M\\n-- FunM-CM-'M-CM-#o interna para processar Upgrades^M\\nlocal function handleUpgrade(player, id)^M\\n^Iif typeof(id) ~= \\\"string\\\" then return false, \\\"Pedido invM-CM-!lido\\\" end^M\\n^Iif not player:FindFirstChild(\\\"leaderstats\\\") then return false, \\\"Aguarde...\\\" end^M\\n^M\\n^Ilocal up = Config.Upgrades[id]^M\\n^Iif not up then return false, \\\"Upgrade invM-CM-!lido\\\" end^M\\n^M\\n^Ilocal lvl = PlayerData.GetUpgrade(player, id)^M\\n^Iif lvl >= up.Max then return false, \\\"NM-CM--vel mM-CM-!ximo atingido\\\" end^M\\n^M\\n^Ilocal cost = Config.UpgradeCost(id, lvl)^M\\n^Iif not PlayerData.SpendMoney(player, cost) then return false, \\\"Dinheiro insuficiente\\\" end^M\\n^M\\n^IPlayerData.SetUpgrade(player, id, lvl + 1)^M\\n^IPlayerData.ApplyStats(player, false)^M\\n^Ireturn true, up.Name .. \\\" nM-CM--vel \\\" .. (lvl + 1)^M\\nend^M\\n^M\\n-- FunM-CM-'M-CM-#o interna para processar Itens e Armas (BuyItem)^M\\nlocal function handleBuyItem(player, kind, id)^M\\n^Iif typeof(kind) ~= \\\"string\\\" or typeof(id) ~= \\\"string\\\" then return false, \\\"Pedido invM-CM-!lido\\\" end^M\\n^Iif not player:FindFirstChild(\\\"leaderstats\\\") then return false, \\\"Aguarde...\\\" end^M\\n^M\\n^Iif kind == \\\"Weapon\\\" then^M\\n^I^I-- LM-CM-3gica para armas (se aplicM-CM-!vel no seu WeaponService)^M\\n^I^Ireturn true, \\\"Arma adquirida!\\\"^M\\n^Ielseif kind == \\\"Item\\\" then^M\\n^I^Ilocal cfg = Config.Items and Config.Items[id]^M\\n^I^Iif not cfg then return false, \\\"Item invM-CM-!lido\\\" end^M\\n^M\\n^I^Ilocal char = player.Character^M\\n^I^Ilocal hum = char and char:FindFirstChildOfClass(\\\"Humanoid\\\")^M\\n^I^Iif not hum or hum.Health <= 0 then return false, \\\"VocM-CM-* estM-CM-! morto.\\\" end^M\\n^M\\n^I^Iif cfg.Type == \\\"Heal\\\" then^M\\n^I^I^Iif hum.Health >= hum.MaxHealth then return false, \\\"Sua vida jM-CM-! estM-CM-! cheia.\\\" end^M\\n^I^I^Iif not PlayerData.SpendMoney(player, cfg.Cost) then return false, \\\"Dinheiro insuficiente.\\\" end^M\\n^I^I^Ihum.Health = hum.MaxHealth^M\\n^I^I^Ireturn true, \\\"Curado com sucesso!\\\"^M\\n^I^Iend^M\\n^Iend^M\\n^Ireturn false, \\\"Pedido invM-CM-!lido\\\"^M\\nend^M\\n^M\\nfunction ShopService.Init()^M\\